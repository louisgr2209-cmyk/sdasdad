					<ProtectedString name="Source"><![CDATA[-- Config (ModuleScript) – ReplicatedStorage/Shared/Config
-- ALLE Spielwerte an einem Ort. Hier anpassen, nicht im Code.

local Config = {}

-- Spieler
Config.StartCash = 1000

-- Bonding-Curve: P(s) = P0 * (1 + s/S)^2, nach Migration lineare (flachere) Fortsetzung
Config.Curve = {
	TotalSupply = 1_000_000, -- Referenzmenge: Marktkapital = Preis * TotalSupply
	P0 = 0.001, -- Startpreis bei s = 0
	S = 100_000, -- Kurven-Größe (größer = Preis steigt langsamer)
	MigrationMarketCap = 69_000, -- ab hier "Migrated"
	AlmostDoneRatio = 0.5, -- ab 50 % der Grenze "Almost done"
	MigratedSlopeFactor = 0.5, -- Steigung nach Migration (0.5 = halb so steil wie an der Grenze)
}

-- Dev-Anteil: Ersteller bekommt beim Erstellen 5 % (zählt als schon verkauft)
Config.DevShare = 0.05

-- Gebühren pro Trade (vom Trade-Betrag)
Config.Fees = {
	Creator = 0.005, -- an den Ersteller
	Burn = 0.005, -- verschwindet (Geld-Senke)
}

-- Trades
Config.Trade = {
	MaxPerSecond = 5, -- Rate-Limit pro Spieler
	MaxPerMinute = 30, -- zusätzlich pro Minute (schont das Roblox-Budget des Weltmarkts)
	MaxQueued = 3, -- so viele Trades eines Spielers dürfen gleichzeitig in der Warteschlange sein
	MinCash = 1, -- kleinster Trade in Cash
	Fractions = { 0.10, 0.25, 0.50, 1.00 }, -- Kauf-/Verkauf-Buttons
	QuickBuyFraction = 0.10, -- Schnellkauf in der Pulse-Liste: 10 % des Cash
}

-- Ticker unten im Terminal
Config.Ticker = {
	BigProfit = 1000, -- Gewinn ab dem ein Verkauf gemeldet wird ("X made 1,234 Cash on $ABC")
	ShowSeconds = 5, -- so lange bleibt eine Meldung stehen
	IdleText = "Fictional meme coins – just a game. Cash is not real money.",
}

-- Markt-Takt
Config.Market = {
	BroadcastInterval = 0.25, -- Sekunden zwischen Kurs-Updates an alle Clients (klein = wenig Verzögerung)
	ChartInterval = 5, -- Sekunden pro Chart-Punkt
	ChartPoints = 60, -- Punkte pro Chart
	RecentTrades = 20, -- gespeicherte Live-Trades pro Coin
	MaxFavorites = 30, -- Favoriten ⭐ pro Spieler (voll: ältester fällt raus)
	TradeLogKeep = 500, -- Trade-Verlauf pro Spieler (DataStore)
	DeadAfter = 30 * 60, -- Sekunden ohne Trade, dann "Dead" (verschwindet aus den Listen)
}

-- XP und Level (Tempo "schnell": Level 5 ca. 15 Min., Level 10 ca. 1,5 Std., Level 25 ca. 10 Std.)
Config.Xp = {
	PerTrade = 1, -- XP pro Trade ...
	MinTradeCash = 100, -- ... aber nur ab dieser Trade-Größe (sonst XP-Farmen mit Mini-Trades)
	TradeCooldown = 10, -- ... und höchstens alle 10 Sek.
	ProfitPerXp = 100, -- +1 XP pro 100 Cash Gewinn
	LevelFactor = 3, -- XP für Level L = LevelFactor * (L - 1)^2
}

-- Ränge (Level ab dem sie gelten) und was freigeschaltet wird
Config.Levels = {
	{ Level = 1, Rank = "Rookie", Unlock = "Buy, sell, portfolio" },
	{ Level = 3, Rank = "Trader", Unlock = "Stop-loss" },
	{ Level = 5, Rank = "Degen", Unlock = "Rug insurance" },
	{ Level = 10, Rank = "Whale", Unlock = "Create your own coin" },
	{ Level = 15, Rank = "Shark", Unlock = "Coin boost" },
	{ Level = 25, Rank = "Dev", Unlock = "Rug pull license" },
	{ Level = 40, Rank = "Legend", Unlock = "Cosmetics, prestige frame" },
}

-- Legend (ab Level 40): 👑 vor dem Namen + roter Prestige-Rahmen um die Wallet-Box (nur Optik)
Config.Prestige = {
	LegendLevel = 40,
}

-- Schutz vor Bankrott (Phase 5)
Config.Protection = {
	-- Mindestgeld: Vermögen (Cash + Coins) unter 100 -> alle 10 Min. 250 Cash, solange man online ist
	StipendBelow = 100,
	StipendAmount = 250,
	StipendInterval = 600,

	-- Daily Reward: Tag 1..7 (danach wieder Tag 1). Einen Tag verpasst -> zurück auf Tag 1. Tage in UTC.
	Daily = { 500, 750, 1000, 1500, 2000, 3000, 5000 },

	-- Stop-Loss (ab Level 3): verkauft alles, wenn der Wert so weit unter dem Einstieg liegt
	StopLossLevels = { 0.10, 0.20, 0.30, 0.50 },
	StopLossMinLevel = 3,
	StopLossOfflineDelay = 15, -- Host verkauft für Offline-Spieler, wenn der Stop seit 15 Sek. erreicht ist
	StopLossHostInterval = 10,

	-- Rug-Versicherung (ab Level 5): Schalter pro Coin, kostet 5 % jedes Kaufs, zahlt 60 % des Verlusts
	InsurancePremium = 0.05,
	InsurancePayout = 0.60,
	InsuranceMinLevel = 5,

	-- Anfänger-Erstattung: unter Level 5 gibt es bei einem Rugpull 50 % des Verlusts zurück.
	-- Mit Versicherung zählt der höhere Wert (nicht beides).
	BeginnerBelowLevel = 5,
	BeginnerPayout = 0.50,

	MinHoldSeconds = 60, -- Kauf muss mind. 60 Sek. vor dem Rugpull sein (gegen Tricks)
	RugPotShare = 0.30, -- 30 % des Rug-Erlöses gehen in den Erstattungstopf
	DailyTopUp = 500, -- ist ein Topf leer, legt das Spiel max. 500 Cash pro Spieler und Tag drauf
}

-- Coin erstellen + Boost (Phase 6)
Config.Launch = {
	CreateCost = 50_000, -- Cash (Robux-Variante kommt in Phase 8)
	CreateMinLevel = 10,
	MaxActiveCoins = 1, -- pro Spieler gleichzeitig gelistet
	DevBuyOptions = { 0, 0.10, 0.25, 0.50 }, -- optional direkt mitkaufen (Anteil des restlichen Cash), max. 50 %

	BoostCost = 25_000,
	BoostMinLevel = 15,
	BoostSeconds = 600, -- 10 Min. oben in der BOOSTED-Leiste
	BoostSlots = 3, -- weltweit gleichzeitig
	BoostSyncInterval = 5, -- so oft holt jeder Server die Boost-Liste

	-- Regeln für Namen (zusätzlich Roblox-Textfilter)
	NameMin = 3,
	NameMax = 20,
	TickerMin = 3,
	TickerMax = 5,
	DescMax = 60,
	-- Echte Krypto-Namen/Marken sind verboten (Plan: nur fiktive Coins). Ticker: exakt; Name: als Wort.
	Blocked = {
		"BITCOIN", "BTC", "ETHEREUM", "ETH", "SOLANA", "SOL", "DOGECOIN", "DOGE", "SHIBA", "SHIB",
		"PEPE", "BONK", "FLOKI", "WIF", "XRP", "RIPPLE", "BNB", "BINANCE", "COINBASE", "TETHER",
		"USDT", "USDC", "CARDANO", "ADA", "LITECOIN", "LTC", "MONERO", "XMR", "TRON", "TRX",
		"POLYGON", "MATIC", "AVAX", "CRYPTO", "KRYPTO", "AXIOM", "PUMPFUN", "NFT", "ROBUX",
	},
}

-- Rugpull (Phase 7): Lizenz im Create-Fenster, ein Klick verkauft alles. Keine Warnung, kein Abzeichen.
-- Ohne Rugpull verkauft der Ersteller seinen eigenen Coin nur stufenweise.
Config.Rug = {
	MinLevel = 25,
	LicenseCost = 250_000, -- Cash (Robux-Variante kommt in Phase 8)
	LicenseUses = 3, -- eine Lizenz gilt für 3 Rugpulls
	Cooldown = 24 * 3600, -- 1 Rugpull pro 24 Std. pro Spieler
	MinCoinAge = 600, -- Coin muss mind. 10 Min. alt sein
	-- Erlös: 70 % an den Rugpuller, 30 % in den Erstattungstopf (Config.Protection.RugPotShare)
	DevSellMax = 0.25, -- normaler Verkauf des Erstellers im eigenen Coin: max. 25 % pro Verkauf …
	DevSellCooldown = 60, -- … und max. 1 Verkauf pro Minute (alles raus dauert mind. ca. 4 Min.)
}

-- Robux (Phase 8): Developer Products geben Gutscheine (nie verloren, nie doppelt), Gamepässe schalten Extras frei.
-- Id = 0: noch nicht im Creator Dashboard angelegt -> im echten Spiel nicht kaufbar, in Studio Test-Kauf.
-- Robux überspringt Level-Pflichten (Entscheidung Phase 8). Cash ist nie gegen Robux zurücktauschbar.
Config.Shop = {
	Products = {
		CreateCoin = { Id = 0, Robux = 99, Grant = "CT", Title = "Create a coin", Info = "No level, no cash needed" },
		Boost = { Id = 0, Robux = 49, Grant = "FB", Title = "Boost 10 min", Info = "Your coin on top (no level needed)" },
		Highlight = { Id = 0, Robux = 25, Grant = "HT", Title = "Highlight 30 min", Info = "Glowing frame for your coin" },
		License = { Id = 0, Robux = 299, Grant = "RL", Title = "Rug pull license", Info = "3 rug pulls, no level needed" },
	},
	Passes = {
		Pro = { Id = 0, Robux = 249, Title = "Pro Terminal", Info = "Top 10 names, candle chart, dev sells live" },
		HalfInsurance = { Id = 0, Robux = 149, Title = "Insurance ½ price", Info = "Rug insurance costs 2.5% instead of 5%" },
		DoubleDaily = { Id = 0, Robux = 99, Title = "Double daily reward", Info = "Every daily reward x2" },
		Vip = { Id = 0, Robux = 99, Title = "VIP", Info = "⭐ name, turquoise color and frame" },
	},
	Order = { "CreateCoin", "Boost", "Highlight", "License", "Pro", "HalfInsurance", "DoubleDaily", "Vip" },
	HighlightSeconds = 1800, -- 30 Min.
	ReceiptsKept = 30, -- so viele Kauf-Nummern merkt sich die Geldbörse (Schutz gegen doppelte Gutschrift)
	ProInfoCooldown = 2, -- Top-10-Namen höchstens alle 2 Sek. abfragen
	VipCacheSeconds = 1800, -- Host merkt sich VIP-Status für die weltweite Rangliste 30 Min.
}

-- Sounds (dezent, im Portfolio abschaltbar). Eingebaute Roblox-Dateien; bei Bedarf durch "rbxassetid://…" ersetzen.
Config.Sounds = {
	Volume = 0.35,
	Click = { Id = "rbxasset://sounds/button.wav", Speed = 1.2 },
	Success = { Id = "rbxasset://sounds/electronicpingshort.wav", Speed = 1.2 },
	Error = { Id = "rbxasset://sounds/electronicpingshort.wav", Speed = 0.7 },
	LevelUp = { Id = "rbxasset://sounds/electronicpingshort.wav", Speed = 1.6 },
	Rug = { Id = "rbxasset://sounds/electronicpingshort.wav", Speed = 0.45 },
}

-- Creator-Programm (eigenes Dokument „Moon or Rug – Creator-Programm“)
Config.Creator = {
	-- Roblox-UserIds der Admins (nur sie sehen das Admin-Panel). In Roblox Studio ist jeder Admin (nur zum Testen).
	AdminIds = {
		-- 123456789, -- Beispiel: eure UserId hier eintragen
	},
	-- Stufen: jede gibt es pro Spieler nur einmal; höhere ersetzt die Anzeige; übersprungene Stufen zahlen nichts nach
	Tiers = {
		{ Name = "Starter", Cash = 10_000 }, -- Titel "Creator"
		{ Name = "Bronze", Cash = 25_000, FreeBoosts = 1 }, -- + Abzeichen 🎬
		{ Name = "Silver", Cash = 50_000 }, -- + farbiger Name, Rahmen, Highlight auf eigenen Coins
		{ Name = "Gold", Cash = 0, FreeCoinMonthly = true }, -- + Creator-Code, Gold-Rahmen, 1 Gratis-Coin pro Monat
	},
	CodeReward = 2_000, -- Spieler, der einen Code eingibt (einmal im ganzen Spiel)
	CreatorPerRedeem = 500, -- Creator pro Einlösung (ins Postfach)
	CreatorDailyCap = 50, -- max. bezahlte Einlösungen pro Creator und Tag
	MinAccountAgeDays = 7, -- gegen Zweit-Accounts
	MinPlaytimeMinutes = 30,
	CodeMin = 4,
	CodeMax = 12,
	ListRefresh = 60, -- Server holen die Creator-Liste jede Minute (Freischaltungen kommen überall an)
	LogKeep = 200, -- so viele Admin-Aktionen bleiben im Log
}

-- Ranglisten (nur echte Spieler)
Config.Leaderboard = {
	Size = 50, -- Top 50 weltweit
	ServerInterval = 5, -- Server-Liste aktualisieren (Sek.)
	SubmitInterval = 120, -- eigene Werte in die weltweite Liste schreiben (Sek.)
	WorldReadInterval = 90, -- Host liest die weltweite Liste (Sek.)
	WorldShareInterval = 60, -- alle Server holen die weltweite Liste (Sek.)
}

-- Weltmarkt: alle Server teilen dieselben Coins (MemoryStore), Spielstände im DataStore.
-- Budget-Grenzen von Roblox: Speicher 64 KB + 1,2 KB pro Spieler, Anfragen 1000 + 120 pro Spieler und Minute.
Config.World = {
	CoinsMap = "MoR_Coins_v1", -- MemoryStore: ein Schlüssel pro Coin (die Wahrheit)
	MarketMap = "MoR_Market_v1", -- MemoryStore: Sammel-Schlüssel, Welt, Meldungen, NPCs, Charts
	WalletsMap = "MoR_Wallets_v1", -- MemoryStore: Geldbörsen der Spieler, die gerade spielen
	InboxMap = "MoR_Inbox_v1", -- MemoryStore: Postfach pro Spieler (z. B. Auszahlung geschlossener Coins)
	ProfileStore = "MoR_Players_v1", -- DataStore: dauerhafte Spielstände

	CoinExpiration = 45 * 24 * 3600, -- Coin ohne Änderung wird nach 45 Tagen gelöscht (Roblox-Maximum)
	Expiration = 2 * 24 * 3600, -- übrige Weltmarkt-Schlüssel
	WalletExpiration = 30 * 24 * 3600, -- Geldbörse, solange gespielt wird
	WalletReleasedExpiration = 600, -- nach dem Verlassen (und gespeichert): noch 10 Min. im Weltmarkt

	Shards = 4, -- Sammel-Schlüssel mit den Kurzinfos aller Coins
	-- Lesen/Schreiben der Sammel-Schlüssel passt sich dem Budget an: so schnell wie möglich (0,5 Sek.),
	-- bei winzigen Servern langsamer (bis 2 Sek.), damit das Roblox-Limit nie gerissen wird.
	MinSyncInterval = 0.5,
	MaxSyncInterval = 2,
	SyncBudgetShare = 0.4, -- Anteil des Anfrage-Budgets eines Servers für Lesen der Kurse
	NewsInterval = 2, -- Ticker-Meldungen zwischen Servern
	FeeFlushInterval = 10, -- gesammelte Creator-Gebühren ins Postfach
	InboxInterval = 60, -- Spieler-Postfach prüfen
	ChartSaveInterval = 30, -- Host speichert Charts für neue Server
	MaintenanceInterval = 30, -- Host prüft tote Coins
	NpcSaveInterval = 10, -- Host speichert NPC-Zustand

	TickInterval = 10, -- Server meldet sich in der Welt
	HostLease = 30, -- Host-Rolle gilt so lange ohne Erneuerung
	ServerStale = 45, -- Server ohne Meldung gilt als weg
	WalletStale = 45, -- Geldbörse eines Servers ohne Lebenszeichen darf übernommen werden
	HeartbeatInterval = 15,
	AutosaveInterval = 60,

	-- Ein Speicher-Wert darf max. 32 KB groß sein:
	FullReceipts = 30, -- volle Buchungsbelege pro Coin (ältere schrumpfen auf ihre Nummer, Schutz bleibt)
	MaxHoldersPerCoin = 200, -- je Holder ca. 90 Byte (Menge, Einsatz, Versicherung, Kaufzeit, Level) -> ca. 18 KB

	CoinsBase = 20, -- gelistete Coins weltweit bei wenigen Spielern
	CoinsPerPlayer = 0.2, -- +1 Coin pro 5 Spieler online (Speicher wächst nur 1,2 KB pro Spieler)
	CoinsMax = 120, -- Obergrenze

	-- Delistete Coins: Besitzer können weiter verkaufen. Nach so vielen Stunden ohne Trade verkauft
	-- das Spiel den Rest automatisch zum Kurvenwert, das Cash kommt ins Postfach (beim nächsten Join).
	DeadKeepHours = 72,
}

-- Feste Icon-Auswahl für Coins (NPCs jetzt, Spieler ab Phase 6)
Config.CoinIcons = {
	"🐱", "🐶", "🐹", "🐧", "🦆", "🐢", "🐙", "🦊", "🐼", "🐨",
	"🦄", "🍞", "🍌", "🥔", "🍩", "🍔", "🌮", "🍕", "🧀", "🌵",
}

-- NPC-Trader: halten den Markt am Leben
Config.Npc = {
	Types = { Sniper = 5, Momentum = 5, Panic = 5, Random = 5 }, -- Anzahl pro Typ (zusammen 20)
	StartCash = 2500, -- Geld pro NPC
	RefillPerMinute = 25, -- NPC unter StartCash bekommt langsam Geld nach (klein halten: sonst melken Spieler die NPCs)
	MaxCash = 6000, -- mehr Geld verschwindet -> NPCs pumpen nicht endlos
	TickInterval = 1, -- Sekunden zwischen NPC-Runden
	ActChance = 0.1, -- Chance pro NPC und Runde, etwas zu tun (20 NPCs -> ca. 2 Trades/Sek.)
	MaxBuyAge = 15 * 60, -- NPCs kaufen nur Coins, die jünger sind (Sekunden)

	-- Sniper: jeder entscheidet pro neuem Coin einmal zufällig, OB und WANN er kauft.
	-- So kann kein Spieler sicher vor den Snipern kaufen und an sie verkaufen.
	Sniper = {
		Chance = 0.4, -- 40 % der Sniper kaufen einen neuen Coin überhaupt
		Delay = { 5, 120 }, -- und zwar nach 5 bis 120 Sek.
		MaxAge = 180, -- Coins älter als 3 Min. sind für Sniper uninteressant
		Share = { 0.05, 0.15 }, -- 5–15 % ihres Geldes
	},

	-- NPC-Coins
	StartCoins = 3, -- so viele gelistete Coins gibt es mindestens (Host erstellt sofort welche)
	CreateEvery = { 60, 180 }, -- alle 1 bis 3 Min. ein neuer NPC-Coin

	-- NPC-Rug (ca. 10 % der NPC-Coins)
	RugChance = 0.10,
	Rug = {
		DevBuy = { 0.3, 0.5 }, -- Ersteller kauft am Anfang 30–50 % seines Geldes dazu
		MinAge = 120, -- frühestens nach 2 Min.
		MaxAge = 600, -- spätestens nach 10 Min.
		MinGain = { 1.5, 3 }, -- rugged, sobald der Kurs x1,5 bis x3 gestiegen ist
	},

	Names = {
		"MoonWalker", "PaperHands", "DiamondPaws", "PumpKing", "DipBuyer", "BagHolder", "ChartWizard",
		"FomoFred", "NoSleepNina", "GreenCandle", "RedCandle", "TinyWhale", "ApeLord", "LuckyLarry",
		"HodlHank", "RocketRita", "SniperSam", "CopeTrader", "WenMoon", "ExitLiquid",
	},
	Prefixes = {
		"Moon", "Turbo", "Baby", "Giga", "Space", "Lil", "Super", "Hyper", "Sleepy", "Angry",
		"Happy", "Golden", "Tiny", "Mega", "Cosmic", "Sir", "Based", "Wild", "Lazy", "Rich",
	},
	Nouns = { -- { Name, Icon } – Icons aus Config.CoinIcons
		{ "Cat", "🐱" }, { "Dog", "🐶" }, { "Hamster", "🐹" }, { "Penguin", "🐧" }, { "Duck", "🦆" },
		{ "Turtle", "🐢" }, { "Octo", "🐙" }, { "Fox", "🦊" }, { "Panda", "🐼" }, { "Koala", "🐨" },
		{ "Unicorn", "🦄" }, { "Toast", "🍞" }, { "Banana", "🍌" }, { "Potato", "🥔" }, { "Donut", "🍩" },
		{ "Burger", "🍔" }, { "Taco", "🌮" }, { "Pizza", "🍕" }, { "Cheese", "🧀" }, { "Cactus", "🌵" },
	},
	Descriptions = {
		"To the moon!", "Community coin. No plan, just vibes.", "The next big thing (probably not).",
		"Made at 3am.", "Diamond paws only.", "Buy high, sell higher.", "100% meme, 0% utility.",
	},
}

-- Indikatoren auf der Coin-Seite (Ampel: grün = gut, gelb = vorsichtig, rot = riskant)
-- Werte sind Anteile an allen Coins (1.000.000). Startwerte aus der Simulation, im Test anpassen.
Config.Indicators = {
	Top10 = { Good = 0.15, Bad = 0.30 }, -- bis 15 % grün, bis 30 % gelb, darüber rot
	Dev = { Good = 0.05, Bad = 0.10 }, -- Startanteil 5 % = grün, mehr = Dev hat dazugekauft
	Early = { Good = 0.10, Bad = 0.20 }, -- Anteil der Früh-Käufer (erste 30 Sek.)
	Holders = { Good = 8, Bad = 3 }, -- ab 8 grün, ab 3 gelb, darunter rot (mehr = besser)
	EarlyWindow = 30, -- Sekunden nach dem Erstellen, in denen ein Kauf als "früh" zählt
}

-- Sicherheit
Config.Security = {
	LogProfitAbove = 10_000, -- Spieler-Gewinn pro Verkauf ab hier wird im Server-Output geloggt
	SnapshotsPer30s = 3, -- so oft darf ein Client die kompletten Marktdaten holen
}

-- UI (Handy zuerst)
Config.UI = {
	DesignWidth = 1000, -- Layout ist für 1000 x 520 gebaut und wird skaliert
	DesignHeight = 520, -- 520 statt 560: auf Handys Buttons ca. 44 pt, Text ca. 12 pt
	MinScale = 0.5,
	MaxScale = 1.5,
}

return Config
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX3">
				<Properties>
					<string name="Name">CreatorStyle</string>
					<ProtectedString name="Source"><![CDATA[-- CreatorStyle (ModuleScript) – ReplicatedStorage/Shared/CreatorStyle
-- Wie Creator angezeigt werden (Terminal, Leaderboard, Ticker). Stufe: 0 = keiner, 1 Starter, 2 Bronze, 3 Silber, 4 Gold.
--   Starter: Titel "Creator"   Bronze: + Abzeichen 🎬   Silber: + lila Name, Rahmen, Coin-Highlight   Gold: Gold statt lila

local CreatorStyle = {}

CreatorStyle.Badge = "🎬"
CreatorStyle.Silver = Color3.fromRGB(192, 132, 252)
CreatorStyle.Gold = Color3.fromRGB(250, 204, 21)
CreatorStyle.Vip = Color3.fromRGB(45, 212, 191) -- VIP-Gamepass (Phase 8): ⭐ + türkis
CreatorStyle.Legend = Color3.fromRGB(239, 68, 68) -- Legend (Level 40): 👑 + roter Rahmen

-- Name mit Abzeichen (🎬 ab Bronze, 👑 Legend, ⭐ VIP)
function CreatorStyle.Name(name: string, tier: number?, vip: boolean?, legend: boolean?): string
	if vip then
		name = "⭐ " .. name
	end
	if legend then
		name = "👑 " .. name
	end
	if (tier or 0) >= 2 then
		return CreatorStyle.Badge .. " " .. name
	end
	return name
end

-- Titel (ab Starter)
function CreatorStyle.Title(tier: number?): string?
	return if (tier or 0) >= 1 then "Creator" else nil
end

-- Namensfarbe / Rahmenfarbe / Coin-Highlight (ab Silber, Creator-Farbe vor VIP), sonst nil
function CreatorStyle.Color(tier: number?, vip: boolean?): Color3?
	if (tier or 0) >= 4 then
		return CreatorStyle.Gold
	elseif (tier or 0) >= 3 then
		return CreatorStyle.Silver
	elseif vip then
		return CreatorStyle.Vip
	end
	return nil
end

return CreatorStyle
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX4">
				<Properties>
					<string name="Name">Format</string>
					<ProtectedString name="Source"><![CDATA[-- Format (ModuleScript) – ReplicatedStorage/Shared/Format
-- Zahlen lesbar machen: 12.5K, 1,234.50, 0.00225, +12.3%

local Format = {}

local SUFFIXES = {
	{ 1e12, "T" },
	{ 1e9, "B" },
	{ 1e6, "M" },
	{ 1e3, "K" },
}

local function trimZeros(text: string): string
	return (text:gsub("%.?0+$", ""))
end

local function withCommas(text: string): string
	local sign, int, rest = text:match("^([%-]?)(%d+)(.*)$")
	if not int then
		return text
	end
	int = int:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	int = int:gsub("^,", "")
	return sign .. int .. rest
end

-- 950 -> "950", 12500 -> "12.5K", 3400000 -> "3.4M"
function Format.Short(n: number): string
	local a = math.abs(n)
	for _, entry in SUFFIXES do
		if a >= entry[1] then
			return trimZeros(string.format("%.2f", n / entry[1])) .. entry[2]
		end
	end
	return trimZeros(string.format("%.2f", n))
end

-- Cash: unter 100K mit Komma und 2 Nachkommastellen, darüber kurz
function Format.Cash(n: number): string
	if math.abs(n) >= 100_000 then
		return Format.Short(n)
	end
	return withCommas(string.format("%.2f", n))
end

-- Preise: immer ca. 3 wichtige Stellen, auch bei 0.000123
function Format.Price(p: number): string
	if p <= 0 then
		return "0"
	end
	local decimals = math.clamp(2 - math.floor(math.log10(p)), 2, 10)
	return string.format("%." .. decimals .. "f", p)
end

-- 0.123 -> "+12.3%"
function Format.Percent(x: number): string
	local sign = if x > 0 then "+" else ""
	return sign .. string.format("%.1f", x * 100) .. "%"
end

-- 45 -> "45s", 200 -> "3m", 3900 -> "1h 5m"
function Format.Duration(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	if seconds < 60 then
		return seconds .. "s"
	elseif seconds < 3600 then
		return math.floor(seconds / 60) .. "m"
	end
	return math.floor(seconds / 3600) .. "h " .. math.floor(seconds % 3600 / 60) .. "m"
end

return Format
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX5">
				<Properties>
					<string name="Name">Indicators</string>
					<ProtectedString name="Source"><![CDATA[-- Indicators (ModuleScript) – ReplicatedStorage/Shared/Indicators
-- Einfache Risiko-Ampeln für einen Coin (wie bei Trading-Terminals, aber für jeden verständlich).
-- Jede Ampel: Wert, Bewertung (Good/Ok/Bad), kurze Erklärung und ab wann grün/gelb/rot.
-- Grenzen stehen in Config.Indicators.

local Config = require(script.Parent.Config)

local T = Config.Indicators
local EPSILON = 1e-6 -- Rundungsluft (z. B. genau 5 % Dev-Anteil)

local Indicators = {}

-- Reihenfolge = Reihenfolge der Kacheln auf der Coin-Seite
Indicators.List = {
	{
		Id = "Top10",
		Label = "Top 10",
		Title = "Top 10 holders",
		Kind = "Percent",
		LowerIsBetter = true,
		Explain = "How much of all coins the 10 biggest holders own. "
			.. "If a few people own a lot, they can crash the price by selling.",
	},
	{
		Id = "Dev",
		Label = "Dev",
		Title = "Dev holds",
		Kind = "Percent",
		LowerIsBetter = true,
		Explain = "How much the creator still owns. Every creator starts with 5%. "
			.. "More means the dev bought extra coins – and could dump them.",
	},
	{
		Id = "Early",
		Label = "Early",
		Title = "Early buyers",
		Kind = "Percent",
		LowerIsBetter = true,
		Explain = "Coins held by traders who bought in the first "
			.. T.EarlyWindow
			.. " seconds. They often sell fast for a quick profit.",
	},
	{
		Id = "Holders",
		Label = "Holders",
		Title = "Holders",
		Kind = "Count",
		LowerIsBetter = false,
		Explain = "How many different traders own this coin. "
			.. "More holders = harder for one person to crash the price.",
	},
}
-- Keine Rug-Lizenz-Ampel (Entscheidung Phase 7): niemand sieht, wer ruggen darf.

-- Wert aus den Coin-Daten (Server-Kurzinfo)
function Indicators.Value(coin, id: string): any
	if id == "Top10" then
		return coin.Top10 or 0
	elseif id == "Dev" then
		return coin.DevShare or 0
	elseif id == "Early" then
		return coin.EarlyShare or 0
	end
	return coin.Holders or 0
end

-- "Good", "Ok" oder "Bad"
function Indicators.Rate(id: string, value: any): string
	local limits = T[id]
	if id == "Holders" then -- mehr ist besser
		if value >= limits.Good then
			return "Good"
		end
		return if value >= limits.Bad then "Ok" else "Bad"
	end
	if value <= limits.Good + EPSILON then
		return "Good"
	end
	return if value <= limits.Bad + EPSILON then "Ok" else "Bad"
end

local function percent(x: number): string
	return string.format(if x < 0.1 then "%.1f%%" else "%.0f%%", x * 100)
end

-- Anzeige-Text des Werts: "12%", "7"
function Indicators.Display(id: string, value: any): string
	if id == "Holders" then
		return tostring(value)
	end
	return percent(value)
end

-- Drei Zeilen "ab wann" für die Erklärung
function Indicators.Rules(id: string): { string }
	local limits = T[id]
	if id == "Holders" then
		return {
			string.format("🟢 %d or more = good", limits.Good),
			string.format("🟡 %d to %d = careful", limits.Bad, limits.Good - 1),
			string.format("🔴 under %d = risky", limits.Bad),
		}
	end
	return {
		string.format("🟢 up to %s = good", percent(limits.Good)),
		string.format("🟡 %s to %s = careful", percent(limits.Good), percent(limits.Bad)),
		string.format("🔴 over %s = risky", percent(limits.Bad)),
	}
end

return Indicators
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX6">
				<Properties>
					<string name="Name">Levels</string>
					<ProtectedString name="Source"><![CDATA[-- Levels (ModuleScript) – ReplicatedStorage/Shared/Levels
-- XP -> Level -> Rang. Gemeinsam für Server (Freischaltungen) und Client (Anzeige).

local Config = require(script.Parent.Config)

local X = Config.Xp

local Levels = {}

-- Gesamt-XP aus den Statistiken: Trade-XP + 1 XP pro 100 Cash Gewinn
function Levels.Xp(stats): number
	stats = stats or {}
	return (stats.TXp or 0) + math.floor((stats.PP or 0) / X.ProfitPerXp)
end

-- XP, ab denen ein Level erreicht ist
function Levels.XpForLevel(level: number): number
	return X.LevelFactor * (level - 1) ^ 2
end

function Levels.LevelForXp(xp: number): number
	return math.floor(math.sqrt(math.max(0, xp) / X.LevelFactor)) + 1
end

-- Rang für ein Level (höchster Eintrag, der erreicht ist)
function Levels.Rank(level: number)
	local best = Config.Levels[1]
	for _, entry in Config.Levels do
		if level >= entry.Level then
			best = entry
		end
	end
	return best
end

-- Freischaltung genau auf diesem Level (oder nil)
function Levels.UnlockAt(level: number)
	for _, entry in Config.Levels do
		if entry.Level == level then
			return entry
		end
	end
	return nil
end

-- -> level, Fortschritt zum nächsten Level (0..1), XP bis zum nächsten Level
function Levels.Progress(xp: number): (number, number, number)
	local level = Levels.LevelForXp(xp)
	local from = Levels.XpForLevel(level)
	local to = Levels.XpForLevel(level + 1)
	return level, (xp - from) / (to - from), to - xp
end

return Levels
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
	</Item>
	<Item class="Folder" referent="RBX27">
		<Properties><string name="Name">ServerScriptService</string></Properties>
		<Item class="Script" referent="RBX9">
			<Properties>
				<string name="Name">Main</string>
				<ProtectedString name="Source"><![CDATA[-- Main (Script) – ServerScriptService/Main
-- Startet alle Server-Services in der richtigen Reihenfolge.

local Players = game:GetService("Players")
local ServerScriptService = game:GetService("ServerScriptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local WorldService = require(ServerScriptService.Services.WorldService)
local PlayerDataService = require(ServerScriptService.Services.PlayerDataService)
local MarketService = require(ServerScriptService.Services.MarketService)
local NpcTraderService = require(ServerScriptService.Services.NpcTraderService)
local LeaderboardService = require(ServerScriptService.Services.LeaderboardService)
local ProtectionService = require(ServerScriptService.Services.ProtectionService)
local LaunchService = require(ServerScriptService.Services.LaunchService)
local CreatorService = require(ServerScriptService.Services.CreatorService)
local MonetizationService = require(ServerScriptService.Services.MonetizationService)
local TradeLogService = require(ServerScriptService.Services.TradeLogService)

-- Reines Terminal: kein Avatar
Players.CharacterAutoLoads = false

-- Verbindungen zwischen den Services (ohne gegenseitige requires)
PlayerDataService.RecoverPending = MarketService.RecoverPending
PlayerDataService.WaitIdle = MarketService.WaitIdle
-- Ticker-Namen: 🎬 Creator, ⭐ VIP
MarketService.DecorateName = function(key: string, name: string): string
	local player = PlayerDataService.GetPlayerByKey(key)
	local vip = player ~= nil and MonetizationService.HasPass(player, "Vip")
	local legend = player ~= nil and PlayerDataService.GetStats(player).Level >= Config.Prestige.LegendLevel
	return CreatorService.DisplayName(key, name, vip, legend)
end
MarketService.HasPass = MonetizationService.HasPass
MarketService.OnTrade = TradeLogService.Add
PlayerDataService.OnTrade = TradeLogService.Add
ProtectionService.HasPass = MonetizationService.HasPass
LeaderboardService.HasPass = MonetizationService.HasPass
LeaderboardService.IsVipUserId = MonetizationService.IsVipUserId
MarketService.FreeCoinMonth = CreatorService.FreeCoinMonth

WorldService.Start() -- meldet den Server in der Welt, wählt den NPC-Host
MarketService.Init({ PlayerData = PlayerDataService })
MarketService.Start() -- lädt den Weltmarkt
NpcTraderService.Init()
NpcTraderService.Start() -- NPCs laufen nur auf dem Host
LeaderboardService.Init()
ProtectionService.Init()
LaunchService.Init()
CreatorService.Init() -- vor PlayerData: Zusatz-Infos im Spieler-Zustand
MonetizationService.Init() -- vor PlayerData: Gamepässe im Spieler-Zustand, ProcessReceipt
TradeLogService.Init() -- Trade-Verlauf (eigener Speicher)
PlayerDataService.Init() -- erst jetzt Spieler laden: Markt ist bereit
LeaderboardService.Start()
ProtectionService.Start()
CreatorService.Start()

print("[MoonOrRug] Server ready")
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="Folder" referent="RBX20">
			<Properties><string name="Name">Services</string></Properties>
			<Item class="ModuleScript" referent="RBX10">
				<Properties>
					<string name="Name">CreatorService</string>
					<ProtectedString name="Source"><![CDATA[-- CreatorService (ModuleScript) – ServerScriptService/Services/CreatorService
-- Creator-Programm:
--  * Admins (Config.Creator.AdminIds, in Studio jeder) vergeben/entziehen Stufen per Roblox-Name.
--    Jede Aktion wird geloggt (Zeit, Admin, Ziel, Stufe). Server prüft JEDE Anfrage.
--  * Creator-Liste im DataStore; alle Server holen sie jede Minute -> Freischaltung kommt überall an,
--    auch für Spieler, die offline waren (Auszahlung beim nächsten Join).
--  * Belohnung je Stufe genau einmal (Ledger.WalletCreatorGrant), übersprungene Stufen zahlen nichts nach.
--  * Gold: eigener Creator-Code (einmal wählbar, gefiltert, eindeutig). Einlösen: jeder Spieler einmal,
--    Konto mind. 7 Tage, mind. 30 Min. gespielt, nie eigener Code. Spieler +2.000, Creator +500 (max. 50/Tag).
--  * Entziehen: Titel/Abzeichen/Farben/Highlight/Code weg, ausgezahltes Cash bleibt.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Config = require(ReplicatedStorage.Shared.Config)
local CreatorStyle = require(ReplicatedStorage.Shared.CreatorStyle)
local Remotes = require(ServerScriptService.Util.Remotes)
local RateLimiter = require(ServerScriptService.Util.RateLimiter)
local Store = require(ServerScriptService.Util.Store)
local Ledger = require(ServerScriptService.Util.Ledger)
local TextFilter = require(ServerScriptService.Util.TextFilter)
local WorldService = require(ServerScriptService.Services.WorldService)
local PlayerDataService = require(ServerScriptService.Services.PlayerDataService)

local CR = Config.Creator
local W = Config.World

local CreatorService = {}

local listStore = Store.Data("MoR_Creators_v1") -- "list": { [userId] = Eintrag }, "log": Admin-Aktionen
local codeStore = Store.Data("MoR_CreatorCodes_v1") -- [CODE] = { U = userId }
local inboxMap = Store.Map(W.InboxMap, W.CoinExpiration)
local limiter = RateLimiter.new(1, 2)

local creators = {} -- [userId-String] = { T = Stufe, N, V, C = Code, R = Einlösungen, RD, RC, At, By }
local creatorsEvent: RemoteEvent
local adminResult: RemoteEvent

local function now(): number
	return workspace:GetServerTimeNow()
end

-- Monats-Nummer (UTC) für den Gratis-Coin der Gold-Creator
local function monthKey(t: number): number
	local date = os.date("!*t", math.floor(t))
	return date.year * 12 + date.month
end

function CreatorService.IsAdmin(player: Player): boolean
	return RunService:IsStudio() or table.find(CR.AdminIds, player.UserId) ~= nil
end

function CreatorService.TierOf(key: string?): number
	local entry = key and creators[key]
	return if entry then entry.T or 0 else 0
end

-- Name mit Creator-Abzeichen (für Ticker-Meldungen)
function CreatorService.DisplayName(key: string?, name: string, vip: boolean?, legend: boolean?): string
	return CreatorStyle.Name(name, CreatorService.TierOf(key), vip, legend)
end

-- Gold-Creator: Monat für den Gratis-Coin (oder nil, wenn kein Gold oder schon benutzt)
function CreatorService.FreeCoinMonth(player: Player, wallet): number?
	if CreatorService.TierOf(tostring(player.UserId)) < 4 then
		return nil
	end
	local month = monthKey(now())
	return if wallet.FCM ~= month then month else nil
end

-- Zusatz-Infos für den Client (Teil des PlayerState)
function CreatorService.ExtraState(player: Player)
	local key = tostring(player.UserId)
	local entry = creators[key]
	local wallet = PlayerDataService.GetWallet(player)
	local st = (wallet and wallet.St) or {}
	local tier = CreatorService.TierOf(key)
	return {
		Tier = tier,
		Code = if tier >= 4 and entry then entry.C else nil,
		Uses = if entry then entry.R or 0 else 0,
		Redeemed = st.RC,
		PlaytimeLeft = math.max(0, CR.MinPlaytimeMinutes * 60 - (st.PT or 0)),
		AccountOk = player.AccountAge >= CR.MinAccountAgeDays,
		IsAdmin = CreatorService.IsAdmin(player),
		FreeCoin = wallet ~= nil and CreatorService.FreeCoinMonth(player, wallet) ~= nil,
	}
end

------------------------------------------------------------------------
-- Liste laden, Stufen auszahlen, an Clients schicken
------------------------------------------------------------------------

local function publicTiers()
	local tiers = {}
	for key, entry in creators do
		if (entry.T or 0) > 0 then
			tiers[key] = entry.T
		end
	end
	return tiers
end

-- Stufe auszahlen, falls noch nicht geschehen (genau einmal, siehe Ledger)
local function applyGrant(player: Player)
	local wallet = PlayerDataService.GetWallet(player)
	local tier = CreatorService.TierOf(tostring(player.UserId))
	if not wallet or tier <= 0 or ((wallet.Cr and wallet.Cr.Max) or 0) >= tier then
		return
	end
	local cfg = CR.Tiers[tier]
	local ok, result = PlayerDataService.WalletUpdate(player, Ledger.WalletCreatorGrant, {
		Job = WorldService.JobId,
		Tier = tier,
		Cash = cfg.Cash,
		FreeBoosts = cfg.FreeBoosts,
	})
	if ok and result and result.Ok then
		PlayerDataService.Notify(
			player,
			true,
			string.format("🎬 Creator %s unlocked!%s", cfg.Name, if cfg.Cash > 0 then " +" .. cfg.Cash .. " Cash" else "")
		)
		PlayerDataService.PushState(player)
	end
end

local function refresh()
	local ok, list = listStore:Get("list")
	if not ok then
		return
	end
	creators = if type(list) == "table" then list else {}
	creatorsEvent:FireAllClients(publicTiers())
	for _, player in PlayerDataService.LoadedPlayers() do
		task.spawn(applyGrant, player)
	end
end

local function appendLog(entry)
	listStore:Update("log", function(log)
		log = if type(log) == "table" then log else {}
		table.insert(log, entry)
		while #log > CR.LogKeep do
			table.remove(log, 1)
		end
		return log
	end)
end

local function lastLog(count: number)
	local ok, log = listStore:Get("log")
	local result = {}
	if ok and type(log) == "table" then
		for i = #log, math.max(1, #log - count + 1), -1 do
			table.insert(result, log[i])
		end
	end
	return result
end

------------------------------------------------------------------------
-- Admin
------------------------------------------------------------------------

-- action: "grant" / "revoke", name: Roblox-Name, tier: 1..4, video: Link (optional, nur Admins sehen ihn)
local function onAdminAction(player: Player, action: any, name: any, tier: any, video: any)
	if not CreatorService.IsAdmin(player) then
		warn("[Creator] non-admin tried an admin action: " .. player.Name .. " (" .. player.UserId .. ")")
		return
	end
	if not limiter:Allow(player) then
		return
	end
	local function reply(ok: boolean, message: string)
		adminResult:FireClient(player, { Ok = ok, Message = message, Log = lastLog(10) })
	end
	if (action ~= "grant" and action ~= "revoke") or typeof(name) ~= "string" then
		return reply(false, "Invalid request")
	end
	name = string.gsub(name, "%s", "")
	if not string.match(name, "^[%w_]+$") or #name < 3 or #name > 20 then
		return reply(false, "Enter a valid Roblox name")
	end
	if action == "grant" and (typeof(tier) ~= "number" or not CR.Tiers[tier]) then
		return reply(false, "Pick a tier")
	end
	if video ~= nil and (typeof(video) ~= "string" or #video > 200) then
		return reply(false, "Video link too long")
	end
	local okId, userId = pcall(function()
		return Players:GetUserIdFromNameAsync(name)
	end)
	if not okId or not userId then
		return reply(false, "Roblox user not found: " .. name)
	end
	local key = tostring(userId)
	local okSave = listStore:Update("list", function(list)
		list = if type(list) == "table" then list else {}
		local entry = list[key] or {}
		entry.N = name
		entry.At = now()
		entry.By = player.Name
		if action == "grant" then
			entry.T = tier
			if video and video ~= "" then
				entry.V = video
			end
		else
			entry.T = 0 -- entzogen: Anzeige + Code weg, ausgezahltes Cash bleibt
		end
		list[key] = entry
		return list
	end)
	if not okSave then
		return reply(false, "Saving failed – please try again")
	end
	local tierName = if action == "grant" then CR.Tiers[tier].Name else "-"
	appendLog({ At = now(), A = player.Name, T = name, U = userId, Act = action, Tier = tierName, V = video })
	print(string.format("[Creator] %s: %s -> %s (%s) by %s", action, name, tierName, key, player.Name))
	refresh()
	reply(true, if action == "grant" then name .. " is now " .. tierName else name .. " revoked")
end

local function onAdminLog(player: Player)
	if not CreatorService.IsAdmin(player) or not limiter:Allow(player) then
		return nil
	end
	return lastLog(10)
end

------------------------------------------------------------------------
-- Creator-Code
------------------------------------------------------------------------

local function onSetCode(player: Player, code: any)
	if not limiter:Allow(player) or not PlayerDataService.GetWallet(player) then
		return
	end
	local key = tostring(player.UserId)
	local entry = creators[key]
	if CreatorService.TierOf(key) < 4 then
		return PlayerDataService.Notify(player, false, "Creator codes are for Gold creators")
	end
	if entry and entry.C then
		return PlayerDataService.Notify(player, false, "You already chose your code: " .. entry.C)
	end
	local clean, err = TextFilter.CheckCode(player, code)
	if not clean then
		return PlayerDataService.Notify(player, false, err or "Invalid code")
	end
	local taken = false
	local ok = codeStore:Update(clean, function(old)
		if type(old) == "table" and old.U ~= player.UserId then
			taken = true
			return nil -- gehört schon jemand anderem: nichts ändern
		end
		taken = false
		return { U = player.UserId }
	end)
	if not ok then
		return PlayerDataService.Notify(player, false, "Please try again")
	end
	if taken then
		return PlayerDataService.Notify(player, false, "Code " .. clean .. " is taken – pick another")
	end
	listStore:Update("list", function(list)
		list = if type(list) == "table" then list else {}
		if list[key] then
			list[key].C = clean
		end
		return list
	end)
	refresh()
	PlayerDataService.Notify(player, true, "🎬 Your creator code is " .. clean)
	PlayerDataService.PushState(player)
end

local function onRedeem(player: Player, code: any)
	if not limiter:Allow(player) then
		return
	end
	local wallet = PlayerDataService.GetWallet(player)
	if not wallet then
		return
	end
	local st = wallet.St or {}
	local clean = TextFilter.NormalizeCode(code)
	if not clean then
		return PlayerDataService.Notify(player, false, "Code not found")
	end
	if st.RC then
		return PlayerDataService.Notify(player, false, "You already used a creator code")
	end
	if player.AccountAge < CR.MinAccountAgeDays then
		return PlayerDataService.Notify(
			player,
			false,
			string.format("Your Roblox account must be at least %d days old", CR.MinAccountAgeDays)
		)
	end
	local left = CR.MinPlaytimeMinutes * 60 - (st.PT or 0)
	if left > 0 then
		return PlayerDataService.Notify(player, false, string.format("Play %d more minutes first", math.ceil(left / 60)))
	end
	local ok, owner = codeStore:Get(clean)
	if not ok then
		return PlayerDataService.Notify(player, false, "Please try again")
	end
	if type(owner) ~= "table" or not owner.U then
		return PlayerDataService.Notify(player, false, "Code not found")
	end
	local creatorKey = tostring(owner.U)
	if creatorKey == tostring(player.UserId) then
		return PlayerDataService.Notify(player, false, "You can't use your own code")
	end
	if CreatorService.TierOf(creatorKey) < 4 then
		return PlayerDataService.Notify(player, false, "This code is not active")
	end

	-- 1) Spieler: einmal im ganzen Spiel (Ledger), 2) Creator zählen + bezahlen (max. 50 pro Tag)
	local okRedeem, result = PlayerDataService.WalletUpdate(player, Ledger.WalletRedeem, {
		Job = WorldService.JobId,
		Code = clean,
		Cash = CR.CodeReward,
	})
	if not okRedeem or not result or not result.Ok then
		return PlayerDataService.Notify(player, false, (result and result.Error) or "Please try again")
	end
	PlayerDataService.Notify(player, true, string.format("🎬 Code %s redeemed: +%d Cash", clean, CR.CodeReward))
	PlayerDataService.PushState(player)

	local day = Ledger.PeriodKeys(now())
	local pay = false
	listStore:Update("list", function(list)
		list = if type(list) == "table" then list else {}
		local entry = list[creatorKey]
		pay = false
		if not entry then
			return list
		end
		if entry.RD ~= day then
			entry.RD, entry.RC = day, 0
		end
		entry.R = (entry.R or 0) + 1
		if (entry.RC or 0) < CR.CreatorDailyCap then
			entry.RC = (entry.RC or 0) + 1
			pay = true
		end
		return list
	end)
	if pay then
		-- ohne Wiederholung: im Zweifel bekommt der Creator diese 500 nicht, aber nie doppelt
		inboxMap:UpdateOnce("u_" .. creatorKey, Ledger.InboxAdd, {
			Adds = { Cash = CR.CreatorPerRedeem, Code = CR.CreatorPerRedeem },
		})
	end
end

------------------------------------------------------------------------

function CreatorService.Init()
	creatorsEvent = Remotes.Event("Creators")
	adminResult = Remotes.Event("AdminResult")
	Remotes.Event("AdminAction").OnServerEvent:Connect(onAdminAction)
	Remotes.Function("AdminLog").OnServerInvoke = onAdminLog
	Remotes.Event("SetCreatorCode").OnServerEvent:Connect(onSetCode)
	Remotes.Event("RedeemCode").OnServerEvent:Connect(onRedeem)
	PlayerDataService.ExtraState = CreatorService.ExtraState
	Players.PlayerRemoving:Connect(function(player)
		limiter:Remove(player)
	end)
end

function CreatorService.Start()
	refresh()
	-- Neue Spieler: Creator-Liste schicken und Stufe auszahlen, sobald die Daten geladen sind
	local function onJoin(player: Player)
		creatorsEvent:FireClient(player, publicTiers())
		for _ = 1, 60 do
			if not player.Parent then
				return
			end
			if PlayerDataService.GetWallet(player) then
				applyGrant(player)
				PlayerDataService.PushState(player)
				return
			end
			task.wait(1)
		end
	end
	Players.PlayerAdded:Connect(onJoin)
	for _, player in Players:GetPlayers() do -- schon da (Studio: Spieler kann vor dem Skript joinen)
		task.spawn(onJoin, player)
	end
	task.spawn(function()
		while true do
			task.wait(CR.ListRefresh)
			local ok, err = pcall(refresh)
			if not ok then
				warn("[Creator] refresh: " .. tostring(err))
			end
		end
	end)
end

return CreatorService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX11">
				<Properties>
					<string name="Name">LaunchService</string>
					<ProtectedString name="Source"><![CDATA[-- LaunchService (ModuleScript) – ServerScriptService/Services/LaunchService
-- Coin erstellen (ab Level 10, 50.000 Cash, optional Dev-Buy bis 50 %) und Boost (ab Level 15, 25.000 Cash,
-- nur eigener Coin, 10 Min., max. 3 weltweit). Prüft die Anfrage, filtert Texte und übergibt an den
-- MarketService (dort laufen die Geldbuchungen mit Duplikat-Schutz in der Trade-Warteschlange des Spielers).
-- Phase 7: Rug-Lizenz kaufen (im Create-Fenster) und Rugpull (Knopf auf der eigenen Coin-Seite).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ServerScriptService.Util.Remotes)
local RateLimiter = require(ServerScriptService.Util.RateLimiter)
local TextFilter = require(ServerScriptService.Util.TextFilter)
local PlayerDataService = require(ServerScriptService.Services.PlayerDataService)
local MarketService = require(ServerScriptService.Services.MarketService)

local L = Config.Launch

local LaunchService = {}

local limiter = RateLimiter.new(1, 2) -- 1 Anfrage pro 2 Sek.
local busy = {} -- [player] = true: Textprüfung läuft gerade

local function onCreateCoin(player: Player, name: any, ticker: any, desc: any, icon: any, devIndex: any)
	if not limiter:Allow(player) or busy[player] or not PlayerDataService.GetWallet(player) then
		return
	end
	if typeof(devIndex) ~= "number" or not L.DevBuyOptions[devIndex] then
		return
	end
	local wallet = PlayerDataService.GetWallet(player)
	local voucher = ((wallet.V and wallet.V.CT) or 0) > 0 -- Robux-Gutschein: ohne Level
	if not voucher and PlayerDataService.GetStats(player).Level < L.CreateMinLevel then
		PlayerDataService.Notify(player, false, "Creating coins unlocks at level " .. L.CreateMinLevel)
		return
	end
	busy[player] = true
	local info, err = TextFilter.CheckCoin(player, name, ticker, desc, icon)
	busy[player] = nil
	if not info then
		PlayerDataService.Notify(player, false, err or "Invalid input")
		return
	end
	if not MarketService.Launch(player, info, L.DevBuyOptions[devIndex]) then
		PlayerDataService.Notify(player, false, "Please wait – your trades are still processing")
	end
end

local function onBoostCoin(player: Player, coinId: any)
	if not limiter:Allow(player) or not PlayerDataService.GetWallet(player) then
		return
	end
	if typeof(coinId) ~= "string" or #coinId > 20 then
		return
	end
	if not MarketService.Boost(player, coinId) then
		PlayerDataService.Notify(player, false, "Please wait – your trades are still processing")
	end
end

-- Rugpull (Phase 7): ein Klick, Server prüft alles
local function onRugPull(player: Player, coinId: any)
	if not limiter:Allow(player) or not PlayerDataService.GetWallet(player) then
		return
	end
	if typeof(coinId) ~= "string" or #coinId > 20 then
		return
	end
	if not MarketService.Rug(player, coinId) then
		PlayerDataService.Notify(player, false, "Please wait – your trades are still processing")
	end
end

local function onBuyLicense(player: Player)
	if not limiter:Allow(player) or not PlayerDataService.GetWallet(player) then
		return
	end
	if not MarketService.BuyLicense(player) then
		PlayerDataService.Notify(player, false, "Please wait – your trades are still processing")
	end
end

function LaunchService.Init()
	Remotes.Event("CreateCoin").OnServerEvent:Connect(onCreateCoin)
	Remotes.Event("BoostCoin").OnServerEvent:Connect(onBoostCoin)
	Remotes.Event("RugPull").OnServerEvent:Connect(onRugPull)
	Remotes.Event("BuyLicense").OnServerEvent:Connect(onBuyLicense)
	Players.PlayerRemoving:Connect(function(player)
		limiter:Remove(player)
		busy[player] = nil
	end)
end

return LaunchService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX12">
				<Properties>
					<string name="Name">LeaderboardService</string>
					<ProtectedString name="Source"><![CDATA[-- LeaderboardService (ModuleScript) – ServerScriptService/Services/LeaderboardService
-- Ranglisten (nur echte Spieler, keine NPCs):
--   Gesamt: Vermögen, PNL (realisierter Gewinn), bester Trade
--   Woche / Tag: PNL, bester Trade (starten jeden Montag / jeden Tag neu, UTC)
-- Server-Liste: Spieler auf diesem Server, alle 5 Sek.
-- Weltweit: jeder Server schreibt die Werte seiner Spieler (OrderedDataStore, alle 2 Min.),
-- nur der Host liest die Top 50 und verteilt sie über den Weltmarkt-Speicher an alle Server.

local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local UserService = game:GetService("UserService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Config = require(ReplicatedStorage.Shared.Config)
local Curve = require(ReplicatedStorage.Shared.BondingCurve)
local Remotes = require(ServerScriptService.Util.Remotes)
local Store = require(ServerScriptService.Util.Store)
local Ledger = require(ServerScriptService.Util.Ledger)
local WorldService = require(ServerScriptService.Services.WorldService)
local PlayerDataService = require(ServerScriptService.Services.PlayerDataService)
local MarketService = require(ServerScriptService.Services.MarketService)

local L = Config.Leaderboard
local W = Config.World
local C = Config.Curve
local FEE_TOTAL = Config.Fees.Creator + Config.Fees.Burn

-- Rangliste -> Wert aus den Statistiken
local BOARDS = { "Wealth", "Pnl", "Best", "WeekPnl", "WeekBest", "DayPnl", "DayBest" }

local LeaderboardService = {}
LeaderboardService.HasPass = nil :: ((Player, string) -> boolean)? -- vom MonetizationService (VIP)
LeaderboardService.IsVipUserId = nil :: ((number) -> boolean)?

local marketMap = Store.Map(W.MarketMap, W.Expiration)
local event: RemoteEvent
local worldBoards = nil -- letzte weltweite Listen
local sentWorld = {} -- [player] = true: hat die aktuelle weltweite Liste schon
local lastSubmitted = {} -- [player] = { [Speichername] = Wert }
local orderedStores = {}
local nameCache = {} -- [userId] = Anzeigename
local LEGEND = Config.Prestige.LegendLevel
-- [userId] = true ab Level 40 (pcall: unveröffentlichte Place in Studio hat keinen DataStore)
local okLegend, legendStore = pcall(DataStoreService.GetDataStore, DataStoreService, "MoR_Legends_v1")
if not okLegend then
	legendStore = nil
end
local legendCache = {} -- [userId] = { Is, At }
local legendLookups = 0 -- pro Lesedurchgang begrenzt (DataStore-Budget)

-- Legend-Status beliebiger Spieler (weltweite Rangliste), Zwischenspeicher 30 Min., Legend bleibt Legend
local function isLegend(userId: number): boolean
	local player = Players:GetPlayerByUserId(userId)
	if player and PlayerDataService.GetWallet(player) then
		return PlayerDataService.GetStats(player).Level >= LEGEND
	end
	local cached = legendCache[userId]
	if cached and (cached.Is or os.clock() - cached.At < 1800) then
		return cached.Is
	end
	if not legendStore or legendLookups >= 40 then
		return if cached then cached.Is else false
	end
	legendLookups += 1
	local ok, value = pcall(function()
		return legendStore:GetAsync(tostring(userId))
	end)
	if not ok then
		return if cached then cached.Is else false
	end
	legendCache[userId] = { Is = value == true, At = os.clock() }
	return value == true
end

local function now(): number
	return workspace:GetServerTimeNow()
end

-- Vermögen = Cash + Verkaufswert aller Coins (nach Gebühr)
local function wealth(player: Player): number
	local wallet = PlayerDataService.GetWallet(player)
	if not wallet then
		return 0
	end
	local total = wallet.Cash
	local coins = MarketService.GetCoins()
	for coinId, holding in PlayerDataService.GetHoldings(player) do
		local coin = coins[coinId]
		if coin then
			total += Curve.CashForTokens(C, coin.Supply, holding.Amount) * (1 - FEE_TOTAL)
		end
	end
	return total
end

LeaderboardService.Wealth = wealth

local function values(player: Player)
	local stats = PlayerDataService.GetStats(player)
	return {
		Wealth = wealth(player),
		Pnl = stats.Pnl,
		Best = stats.Best,
		WeekPnl = stats.WeekPnl,
		WeekBest = stats.WeekBest,
		DayPnl = stats.DayPnl,
		DayBest = stats.DayBest,
	}
end

-- Name der weltweiten Rangliste (Woche/Tag bekommen eine eigene Liste pro Zeitraum)
local function storeName(board: string): string
	local day, week = Ledger.PeriodKeys(now())
	if string.sub(board, 1, 4) == "Week" then
		return "MoR_LB_" .. board .. "_" .. week
	elseif string.sub(board, 1, 3) == "Day" then
		return "MoR_LB_" .. board .. "_" .. day
	end
	return "MoR_LB_" .. board
end

local function ordered(name: string)
	local store = orderedStores[name]
	if not store then
		store = DataStoreService:GetOrderedDataStore(name)
		orderedStores[name] = store
	end
	return store
end

------------------------------------------------------------------------
-- Server-Liste
------------------------------------------------------------------------

local function serverBoards()
	local boards = {}
	for _, board in BOARDS do
		boards[board] = {}
	end
	for _, player in PlayerDataService.LoadedPlayers() do
		local v = values(player)
		for _, board in BOARDS do
			table.insert(boards[board], {
				N = player.DisplayName,
				U = player.UserId,
				P = if LeaderboardService.HasPass and LeaderboardService.HasPass(player, "Vip") then true else nil,
				G = if PlayerDataService.GetStats(player).Level >= LEGEND then true else nil, -- Legend (👑)
				V = math.floor(v[board]),
			})
		end
	end
	for _, list in boards do
		table.sort(list, function(a, b)
			return a.V > b.V
		end)
		while #list > L.Size do
			table.remove(list)
		end
	end
	return boards
end

------------------------------------------------------------------------
-- Weltweit
------------------------------------------------------------------------

-- Eigene Werte schreiben (nur geänderte, nur positive)
local function submit(player: Player)
	if Store.LocalMode or not PlayerDataService.GetWallet(player) then
		return
	end
	local v = values(player)
	local sent = lastSubmitted[player] or {}
	lastSubmitted[player] = sent
	-- Legend-Status für die weltweite Liste (nur einmal, wenn erreicht)
	if legendStore and PlayerDataService.GetStats(player).Level >= LEGEND and not sent.Legend then
		local ok = pcall(function()
			legendStore:SetAsync(tostring(player.UserId), true)
		end)
		sent.Legend = ok
	end
	for _, board in BOARDS do
		local value = math.max(0, math.floor(v[board]))
		local name = storeName(board)
		if value > 0 and sent[name] ~= value then
			local ok = pcall(function()
				ordered(name):SetAsync(tostring(player.UserId), value)
			end)
			if ok then
				sent[name] = value
			end
		end
	end
end

-- Host: Top 50 aller Ranglisten lesen, Namen holen, im Weltmarkt-Speicher teilen
local function readWorld()
	legendLookups = 0
	local boards, missing = {}, {}
	for _, board in BOARDS do
		local ok, page = pcall(function()
			return ordered(storeName(board)):GetSortedAsync(false, L.Size):GetCurrentPage()
		end)
		local list = {}
		if ok then
			for _, entry in page do
				local userId = tonumber(entry.key)
				if userId then
					table.insert(list, { U = userId, V = entry.value })
					if not nameCache[userId] then
						missing[userId] = true
					end
				end
			end
		end
		boards[board] = list
	end
	local ids = {}
	for userId in missing do
		table.insert(ids, userId)
	end
	if #ids > 0 then
		local ok, infos = pcall(function()
			return UserService:GetUserInfosByUserIdsAsync(ids)
		end)
		if ok then
			for _, info in infos do
				nameCache[info.Id] = info.DisplayName
			end
		end
	end
	for _, list in boards do
		for _, entry in list do
			entry.N = nameCache[entry.U] or ("Player " .. entry.U) -- U bleibt: Creator-Abzeichen im Client
			if LeaderboardService.IsVipUserId and LeaderboardService.IsVipUserId(entry.U) then
				entry.P = true -- VIP (⭐)
			end
			if isLegend(entry.U) then
				entry.G = true -- Legend (👑)
			end
		end
	end
	marketMap:Set("Leaderboards", { Boards = boards, At = now() })
end

local function fetchWorld()
	local ok, data = marketMap:Get("Leaderboards")
	if ok and type(data) == "table" and data.Boards then
		worldBoards = data.Boards
		sentWorld = {} -- alle bekommen die neue Liste
	end
end

------------------------------------------------------------------------

local function loop(name: string, interval: number, fn: () -> ())
	task.spawn(function()
		while true do
			task.wait(interval)
			local ok, err = pcall(fn)
			if not ok then
				warn("[Leaderboard] " .. name .. ": " .. tostring(err))
			end
		end
	end)
end

function LeaderboardService.Init()
	event = Remotes.Event("Leaderboard")
	Players.PlayerRemoving:Connect(function(player)
		pcall(submit, player) -- letzter Stand (läuft, solange die Daten noch geladen sind)
		lastSubmitted[player] = nil
		sentWorld[player] = nil
	end)
end

function LeaderboardService.Start()
	-- Server-Liste an alle; weltweite Liste an alle, die sie noch nicht haben
	loop("server", L.ServerInterval, function()
		event:FireAllClients({ Server = serverBoards() })
		if worldBoards then
			for _, player in PlayerDataService.LoadedPlayers() do
				if not sentWorld[player] then
					sentWorld[player] = true
					event:FireClient(player, { World = worldBoards })
				end
			end
		end
	end)
	loop("submit", L.SubmitInterval, function()
		for _, player in PlayerDataService.LoadedPlayers() do
			submit(player)
			task.wait(0.2) -- verteilt, nicht alle auf einmal
		end
	end)
	if not Store.LocalMode then
		loop("world read", L.WorldReadInterval, function()
			if WorldService.IsHost() then
				readWorld()
			end
		end)
		loop("world share", L.WorldShareInterval, fetchWorld)
		task.spawn(fetchWorld)
	end
end

return LeaderboardService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX13">
				<Properties>
					<string name="Name">MarketService</string>
					<ProtectedString name="Source"><![CDATA[-- MarketService (ModuleScript) – ServerScriptService/Services/MarketService
-- Weltmarkt: alle Server teilen dieselben Coins.
--  * Wahrheit: ein MemoryStore-Schlüssel pro Coin (Trades atomar über Ledger.CoinTrade)
--  * Verbreitung: jeder Server schreibt Kurzinfos in 4 Sammel-Schlüssel und liest sie alle 0,5–1 Sek.
--  * Lokal: Kopie aller Coins für Anzeige, Charts und Kurs-Updates an die Clients (alle 0,25 Sek.)
-- Spieler-Trades laufen in 3 Schritten mit Nummer (siehe Ledger) -> nie doppelt, auch bei Absturz.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")

local Config = require(ReplicatedStorage.Shared.Config)
local Curve = require(ReplicatedStorage.Shared.BondingCurve)
local Format = require(ReplicatedStorage.Shared.Format)
local Remotes = require(ServerScriptService.Util.Remotes)
local RateLimiter = require(ServerScriptService.Util.RateLimiter)
local Store = require(ServerScriptService.Util.Store)
local Ledger = require(ServerScriptService.Util.Ledger)
local WorldService = require(ServerScriptService.Services.WorldService)

local C = Config.Curve
local W = Config.World

local MarketService = {}

local PlayerData -- wird in Init gesetzt
local coinsMap = Store.Map(W.CoinsMap, W.CoinExpiration)
local marketMap = Store.Map(W.MarketMap, W.Expiration)
local inboxMap = Store.Map(W.InboxMap, W.CoinExpiration)
local LC = Config.Launch
local RG = Config.Rug

local coins = {} -- lokale Kopie: [coinId] = coin
local dirty = {} -- [coinId] = true: an Clients schicken
local pendingTrades = {} -- neue Trades seit dem letzten Update (alle Server)
local pendingNews = {} -- neue Meldungen seit dem letzten Update
local removedIds = {} -- gelöschte Coins seit dem letzten Update
local flushQueue = {} -- [shard] = { Updates = {}, Removes = {} }: noch in die Sammel-Schlüssel schreiben
local newsOut = {} -- eigene Meldungen, noch nicht an andere Server geschickt
local npcFees = {} -- [npcKey] = Betrag, gesammelt
local potAdds = { Ins = 0 } -- Versicherungsprämien, gesammelt (alle 10 Sek. in den Topf)
local playerFees = {} -- [Spieler-Schlüssel] = Betrag: Ersteller-Gebühren (alle 10 Sek. ins Postfach)
local boosts = {} -- [coinId] = bis (Server-Zeit): aktuelle Boosts (alle Server)
local boostsChanged = false
local lastNewsSeq = nil -- zuletzt gesehene Meldung (nil = noch nie gelesen)
local queues = {} -- [player] = { Busy, Items }: Trades eines Spielers nacheinander

local tradeLimiter = RateLimiter.new(Config.Trade.MaxPerSecond)
local minuteLimiter = RateLimiter.new(Config.Trade.MaxPerMinute, 60)
local warnLimiter = RateLimiter.new(1) -- "Too fast" höchstens 1x pro Sek.
local snapshotLimiter = RateLimiter.new(Config.Security.SnapshotsPer30s, 30)

local updateEvent: RemoteEvent
local resultEvent: RemoteEvent

local function now(): number
	return workspace:GetServerTimeNow()
end

local function isValidNumber(n: any): boolean
	return typeof(n) == "number" and n == n and n > -math.huge and n < math.huge
end

-- Neue, weltweit eindeutige Coin-Id (12 Zeichen)
local function newCoinId(): string
	return string.sub((string.gsub(HttpService:GenerateGUID(false), "-", "")), 1, 12)
end

-- Sammel-Schlüssel für einen Coin (1..Shards)
local function shardOf(coinId: string): number
	local sum = 0
	for i = 1, #coinId do
		sum += string.byte(coinId, i)
	end
	return sum % W.Shards + 1
end

------------------------------------------------------------------------
-- Kurzinfo (aus dem Coin-Wert) und lokale Kopie
------------------------------------------------------------------------

-- Öffentliche Kurzinfo eines Coins (wird in die Sammel-Schlüssel geschrieben). Keine Holder-Liste.
local function publicInfo(value)
	local amounts, early, count = {}, 0, 0
	for key, holding in value.H do
		count += 1
		table.insert(amounts, holding.A)
		if value.E[key] then
			early += holding.A
		end
	end
	table.sort(amounts, function(a, b)
		return a > b
	end)
	local top = 0
	for i = 1, math.min(10, #amounts) do
		top += amounts[i]
	end
	local dev = value.CK and value.H[value.CK]
	local lastTrades = {} -- nur die letzten 3 Trades (spart Platz), ohne Lücken in der Liste
	for i = math.max(1, #value.T - 2), #value.T do
		table.insert(lastTrades, value.T[i])
	end
	return {
		V = value.V,
		Id = value.Id,
		Name = value.Name,
		Ticker = value.Ticker,
		Icon = value.Icon,
		CN = value.CN,
		CK = value.CK,
		At = value.At,
		LT = value.LT,
		Sup = value.Sup,
		Mig = value.Mig,
		Dead = value.Dead,
		Rug = value.Rug,
		Vol = value.Vol,
		HL = value.HL, -- Highlight bis (Robux, rein optisch)
		HC = count,
		Dev = (if dev then dev.A else 0) / C.TotalSupply,
		Top = top / C.TotalSupply,
		Ear = early / C.TotalSupply,
		T = lastTrades,
		SLC = (function() -- Anzahl Stop-Loss-Aufträge (nur Anzahl, keine Preise: sonst könnte man sie jagen)
			local count = 0
			for _ in value.SL or {} do
				count += 1
			end
			return count
		end)(),
	}
end

local function updateCandle(coin)
	local p = Curve.Price(C, coin.Supply)
	local candle = coin.Candle
	candle.C = p
	candle.H = math.max(candle.H, p)
	candle.L = math.min(candle.L, p)
end

-- Kurzinfo in die lokale Kopie übernehmen (nur wenn neuer)
local function applyInfo(info)
	local coin = coins[info.Id]
	if coin and coin.V >= info.V then
		return coin
	end
	if not coin then
		local p = Curve.Price(C, info.Sup)
		coin = {
			Chart = {},
			PointCount = 0,
			NewPoints = {},
			Trades = {},
			LastTradeId = 0,
			Candle = { O = p, H = p, L = p, C = p },
		}
		coins[info.Id] = coin
	end
	coin.V = info.V
	coin.Info = info
	coin.Id = info.Id
	coin.Name = info.Name
	coin.Ticker = info.Ticker
	coin.Icon = info.Icon
	coin.CreatorName = info.CN
	coin.CreatorKey = info.CK
	coin.CreatedAt = info.At
	coin.LastTradeAt = info.LT
	coin.Supply = info.Sup
	coin.Migrated = info.Mig == true
	coin.Dead = info.Dead == true
	coin.Rugged = info.Rug == true
	coin.Volume = info.Vol
	coin.Highlight = info.HL
	coin.Holders = info.HC
	coin.DevShare = info.Dev
	coin.Top10 = info.Top
	coin.EarlyShare = info.Ear
	coin.StopLossCount = info.SLC or 0
	updateCandle(coin)

	for _, t in info.T or {} do
		if t.I > coin.LastTradeId then
			coin.LastTradeId = t.I
			local trade = {
				CoinId = coin.Id,
				Ticker = coin.Ticker,
				Side = t.S,
				Trader = t.N,
				TraderId = t.U, -- Spieler-Schlüssel (Creator-Abzeichen im Client)
				IsNpc = t.B,
				Vip = t.P, -- VIP-Gamepass (⭐)
				Legend = t.G, -- Legend (👑)
				Tokens = t.K,
				Cash = t.M,
				Time = t.At,
			}
			table.insert(coin.Trades, trade)
			if #coin.Trades > Config.Market.RecentTrades then
				table.remove(coin.Trades, 1)
			end
			table.insert(pendingTrades, trade)
		end
	end
	dirty[coin.Id] = true
	return coin
end

local function queueFlush(info)
	local shard = shardOf(info.Id)
	local q = flushQueue[shard] or { Updates = {}, Removes = {} }
	q.Updates[info.Id] = info
	q.Removes[info.Id] = nil
	flushQueue[shard] = q
end

-- Nach eigenem Schreiben: lokale Kopie + Sammel-Schlüssel aktualisieren
local function onCoinValue(value)
	local info = publicInfo(value)
	local coin = applyInfo(info)
	queueFlush(info)
	return coin
end

local function removeLocal(coinId: string)
	if coins[coinId] then
		coins[coinId] = nil
		dirty[coinId] = nil
		table.insert(removedIds, coinId)
	end
end

------------------------------------------------------------------------
-- Kurzinfo für die Clients (gleiches Format wie vorher)
------------------------------------------------------------------------

local function summary(coin)
	local price = Curve.Price(C, coin.Supply)
	local marketCap = price * C.TotalSupply
	return {
		Id = coin.Id,
		Name = coin.Name,
		Ticker = coin.Ticker,
		Icon = coin.Icon,
		CreatorName = coin.CreatorName,
		CreatorId = coin.CreatorKey, -- damit der Client "mein Coin" erkennt
		CreatedAt = coin.CreatedAt,
		Supply = coin.Supply,
		Price = price,
		MarketCap = marketCap,
		Stage = if coin.Dead then "Dead" else Curve.Stage(C, marketCap, coin.Migrated),
		Rugged = coin.Rugged,
		Holders = coin.Holders,
		DevShare = coin.DevShare,
		Top10 = coin.Top10,
		EarlyShare = coin.EarlyShare,
		Volume = coin.Volume,
		Highlight = coin.Highlight,
		Candle = coin.Candle,
		NewPoints = coin.NewPoints,
	}
end

local function fullInfo(coin)
	local info = summary(coin)
	info.Chart = coin.Chart
	info.Trades = coin.Trades
	return info
end

------------------------------------------------------------------------
-- Meldungen und Gebühren
------------------------------------------------------------------------

-- Meldung an alle Server (Ticker unten)
function MarketService.Announce(kind: string, text: string)
	table.insert(newsOut, { Kind = kind, Text = text })
end

-- Nach einem frisch gebuchten Trade: Gebühr sammeln, Meldungen, Sicherheits-Log
local function afterTrade(wallet, coin, result, rug: boolean)
	if result.Fee and result.Fee > 0 and result.CreatorKey then
		if string.sub(result.CreatorKey, 1, 4) == "npc:" then
			npcFees[result.CreatorKey] = (npcFees[result.CreatorKey] or 0) + result.Fee
		elseif result.CreatorKey ~= wallet.Key then
			playerFees[result.CreatorKey] = (playerFees[result.CreatorKey] or 0) + result.Fee
		end
	end
	local name = wallet.Name
	if not wallet.IsNpc and MarketService.DecorateName then
		name = MarketService.DecorateName(wallet.Key, name) -- 🎬 vor Creator-Namen
	end
	if rug then
		MarketService.Announce("Rug", string.format("RUG PULL! %s dumped $%s", name, coin.Ticker))
		if MarketService.RugHandler then
			task.spawn(MarketService.RugHandler, coin, result) -- Versicherung/Anfänger-Erstattung (ProtectionService)
		end
	elseif (result.Profit or 0) >= Config.Ticker.BigProfit then
		MarketService.Announce(
			"Profit",
			string.format(
				"%s%s made %s Cash on $%s",
				if wallet.IsNpc then "🤖 " else "",
				name,
				Format.Cash(result.Profit),
				coin.Ticker
			)
		)
	end
	if not wallet.IsNpc and (result.Profit or 0) >= Config.Security.LogProfitAbove then
		print(
			string.format(
				"[Security] big profit: %s (%s) +%.2f on %s ($%s)",
				wallet.Name,
				wallet.Key,
				result.Profit,
				coin.Id,
				coin.Ticker
			)
		)
	end
end

------------------------------------------------------------------------
-- Spieler-Trades (3 Schritte, siehe Ledger)
------------------------------------------------------------------------

-- Schritte 2 + 3 für einen angemeldeten Trade p = { S, Side, Coin, Cash, Frac, Prem, Ins, L }
-- -> ok, nachricht
local function settle(player: Player, p)
	local key = PlayerData.Key(player)
	local isLaunch = p.Side == "Launch"
	local okCoin, result, newValue
	if isLaunch then
		okCoin, result, newValue = coinsMap:Update(p.Coin, Ledger.CoinLaunch, {
			Id = p.Coin,
			Info = p.Info,
			Key = key,
			Name = player.DisplayName,
			Seq = p.S,
			DevCash = p.Cash,
			Level = p.L,
			Now = now(),
		})
	else
		okCoin, result, newValue = coinsMap:Update(p.Coin, Ledger.CoinTrade, {
			Key = key,
			Name = player.DisplayName,
			Seq = p.S,
			Side = p.Side,
			Cash = p.Cash,
			Frac = p.Frac,
			Insure = p.Ins,
			Level = p.L,
			Vip = if MarketService.HasPass then MarketService.HasPass(player, "Vip") else nil,
			Rug = p.Rug, -- Rugpull (auch bei Wiederholung nach Absturz)
			Now = now(),
		})
	end
	if not okCoin or not result then
		return false, "Trade pending – it finishes automatically"
	end
	local coin = nil
	if newValue then
		coin = onCoinValue(newValue)
		if isLaunch then
			coin.LocalCreatedAt = os.clock()
		end
	end
	local okFinish =
		PlayerData.WalletUpdate(player, Ledger.WalletFinish, { Seq = p.S, Result = result, Now = now() })
	if not okFinish then
		return false, "Trade pending – it finishes automatically"
	end
	PlayerData.SetHolding(player, p.Coin, result.Amount or 0, result.Cost or 0)
	-- Gebühren/Meldungen nur bei frischer Buchung (bei Wiederholung nie doppelt)
	-- Trade-Verlauf (nur Anzeige): nur frisch gebuchte Trades, nie Wiederholungen
	if result.Ok and newValue and coin and MarketService.OnTrade and ((result.Cash or 0) > 0) then
		MarketService.OnTrade(player, {
			C = coin.Id,
			T = coin.Ticker,
			I = coin.Icon,
			S = if isLaunch then "Dev" elseif p.Rug then "Rug" else p.Side,
			M = result.Cash,
			P = if p.Side == "Sell" then result.Profit else nil,
		})
	end
	if isLaunch then
		if not result.Ok then
			return false, result.Error or "Launch failed – your cash was refunded"
		end
		local devText = if (result.Cash or 0) > 0 then " (dev buy " .. Format.Cash(result.Cash) .. ")" else ""
		return true, string.format("🚀 $%s launched!%s", p.Info.Ticker, devText)
	end
	if result.Ok and newValue and coin then
		afterTrade({ Key = key, Name = player.DisplayName, IsNpc = false }, coin, result, p.Rug == true)
		if p.Prem then
			potAdds.Ins += p.Prem -- Versicherungsprämie in den Topf
		end
	end
	if not result.Ok then
		return false, result.Error or "Trade failed"
	end
	if result.Unknown then
		return true, "Trade completed"
	end
	local ticker = if coins[p.Coin] then coins[p.Coin].Ticker else "?"
	if p.Rug then
		return true, string.format("☠ You rugged $%s: +%s Cash (30%% went to the refund pot)", ticker, Format.Cash(result.Cash))
	end
	local verb = if p.Side == "Buy" then "Bought" else "Sold"
	return true,
		string.format(
			"%s %s %s for %s Cash%s",
			verb,
			Format.Short(result.Tokens),
			ticker,
			Format.Cash(result.Cash),
			if result.Limited then " (creators sell max. 25% per minute)" else ""
		)
end

-- Offenen Trade eines Spielers fertig buchen (nach Absturz, verlorener Antwort usw.)
function MarketService.RecoverPending(player: Player): boolean
	local wallet = PlayerData.GetWallet(player)
	if not wallet or not wallet.P then
		return true
	end
	settle(player, wallet.P)
	local after = PlayerData.GetWallet(player)
	return after ~= nil and after.P == nil
end

local function executeTrade(player: Player, coinId: string, side: string, fraction: number, rug: boolean?)
	local wallet = PlayerData.GetWallet(player)
	if not wallet then
		return false, "Still loading your data…"
	end
	if wallet.P then
		if not MarketService.RecoverPending(player) then
			return false, "Previous trade still processing – try again"
		end
		wallet = PlayerData.GetWallet(player)
		if not wallet then
			return false, "Still loading your data…"
		end
	end
	if side == "Sell" and not PlayerData.GetHolding(player, coinId) then
		return false, "You don't own this coin"
	end
	local cash, premium, insure = nil, nil, nil
	local level = PlayerData.GetStats(player).Level
	if side == "Buy" then
		-- Versicherung (Schalter pro Coin, ab Level 5): 5 % zusätzlich, Einsatz so, dass beides ins Cash passt
		insure = wallet.Ins ~= nil and wallet.Ins[coinId] == true and level >= Config.Protection.InsuranceMinLevel
		local rate = if insure then Config.Protection.InsurancePremium else 0
		if insure and MarketService.HasPass and MarketService.HasPass(player, "HalfInsurance") then
			rate /= 2 -- Gamepass: Versicherung zum halben Preis (Auszahlung bleibt 60 %)
		end
		cash = Ledger.FloorCents(wallet.Cash * fraction / (1 + rate))
		premium = if insure then Ledger.FloorCents(cash * rate) else nil
		if cash < Config.Trade.MinCash then
			return false, if wallet.Cash < Config.Trade.MinCash then "Not enough cash" else "Amount too small"
		end
	end
	local okBegin, begin = PlayerData.WalletUpdate(player, Ledger.WalletBegin, {
		Job = WorldService.JobId,
		Side = side,
		Coin = coinId,
		Cash = cash,
		Frac = fraction,
		Premium = premium,
		Insure = insure or nil,
		Level = level,
		Rug = rug or nil,
		Now = now(),
	})
	if not okBegin or not begin then
		return false, "Market busy – please try again"
	end
	if not begin.Ok then
		if begin.Pending then
			MarketService.RecoverPending(player)
		end
		return false, begin.Error or "Trade failed"
	end
	return settle(player, {
		S = begin.Seq,
		Side = side,
		Coin = coinId,
		Cash = cash,
		Frac = fraction,
		Prem = premium,
		Ins = insure or nil,
		L = level,
		Rug = rug or nil,
	})
end

local function reply(player: Player, ok: boolean, message: string)
	resultEvent:FireClient(player, { Ok = ok, Message = message })
end

-- Trades eines Spielers nacheinander abarbeiten (max. MaxQueued wartend)
local function enqueue(player: Player, job: () -> ()): boolean
	local q = queues[player]
	if not q then
		q = { Busy = false, Items = {} }
		queues[player] = q
	end
	if #q.Items >= Config.Trade.MaxQueued then
		return false
	end
	table.insert(q.Items, job)
	if not q.Busy then
		q.Busy = true
		task.spawn(function()
			while #q.Items > 0 do
				local nextJob = table.remove(q.Items, 1)
				local ok, err = pcall(nextJob)
				if not ok then
					warn("[Market] trade error: " .. tostring(err))
				end
			end
			q.Busy = false
		end)
	end
	return true
end

-- Wartet, bis alle Trades eines Spielers fertig sind (beim Verlassen, vor dem Speichern)
function MarketService.WaitIdle(player: Player, timeout: number)
	local started = os.clock()
	while queues[player] and queues[player].Busy and os.clock() - started < timeout do
		task.wait(0.1)
	end
	queues[player] = nil
end

-- Spieler-Coin erstellen (3 Schritte wie ein Trade: Gebühr + Dev-Buy reservieren, anlegen, abschließen)
local function executeLaunch(player: Player, info, devFraction: number)
	local wallet = PlayerData.GetWallet(player)
	if not wallet then
		return false, "Still loading your data…"
	end
	if wallet.P and not MarketService.RecoverPending(player) then
		return false, "Previous trade still processing – try again"
	end
	wallet = PlayerData.GetWallet(player)
	local level = PlayerData.GetStats(player).Level
	-- Gold-Creator: ein Coin pro Monat gratis (nur die Erstell-Gebühr, Dev-Buy kostet normal).
	-- Sonst Robux-Gutschein: kostenlos und ohne Level-Pflicht.
	local freeMonth = level >= LC.CreateMinLevel
		and MarketService.FreeCoinMonth
		and MarketService.FreeCoinMonth(player, wallet)
	local voucher = not freeMonth and ((wallet.V and wallet.V.CT) or 0) > 0
	if level < LC.CreateMinLevel and not voucher then
		return false, "Creating coins unlocks at level " .. LC.CreateMinLevel
	end
	local mine = wallet.MyCoin and coins[wallet.MyCoin]
	if mine and not mine.Dead then
		return false, "You already have an active coin ($" .. mine.Ticker .. ")"
	end
	if MarketService.TickerTaken(info.Ticker) then
		return false, "Ticker $" .. info.Ticker .. " is taken – pick another"
	end
	local fee = if freeMonth or voucher then 0 else LC.CreateCost
	if wallet.Cash < fee then
		return false, "You need " .. Format.Cash(fee) .. " Cash"
	end
	local devCash = Ledger.FloorCents((wallet.Cash - fee) * devFraction)
	if devCash < Config.Trade.MinCash then
		devCash = 0
	end
	local coinId = newCoinId()
	local okBegin, begin = PlayerData.WalletUpdate(player, Ledger.WalletLaunchBegin, {
		Job = WorldService.JobId,
		Coin = coinId,
		Fee = fee,
		Cash = devCash,
		Info = info,
		Level = level,
		FreeMonth = freeMonth or nil,
		Voucher = voucher or nil,
		Now = now(),
	})
	if not okBegin or not begin then
		return false, "Market busy – please try again"
	end
	if not begin.Ok then
		if begin.Pending then
			MarketService.RecoverPending(player)
		end
		return false, begin.Error or "Launch failed"
	end
	return settle(player, {
		S = begin.Seq,
		Side = "Launch",
		Coin = coinId,
		Fee = fee,
		Cash = devCash,
		Info = info,
		L = level,
	})
end

function MarketService.Launch(player: Player, info, devFraction: number): boolean
	return enqueue(player, function()
		local ok, message = executeLaunch(player, info, devFraction)
		if player.Parent then
			reply(player, ok, message)
			PlayerData.PushState(player)
		end
		local wallet = PlayerData.GetWallet(player)
		if ok and wallet and ((wallet.V and wallet.V.HT) or 0) > 0 then
			MarketService.Highlight(player) -- gespeichertes Highlight startet mit dem neuen Coin
		end
	end)
end

-- Boost: nur eigener Coin. Erst bezahlen (mit Buchungsnummer), dann Platz nehmen, sonst Geld zurück.
local function executeBoost(player: Player, coinId: string)
	local wallet = PlayerData.GetWallet(player)
	local coin = coins[coinId]
	if not wallet or not coin then
		return false, "Coin not found"
	end
	if coin.CreatorKey ~= PlayerData.Key(player) then
		return false, "You can only boost your own coin"
	end
	if coin.Dead then
		return false, "This coin is dead"
	end
	local free = (wallet.FB or 0) > 0 -- Bronze-Creator: Gratis-Boost (ohne Level-Pflicht, ohne Kosten)
	if not free and PlayerData.GetStats(player).Level < LC.BoostMinLevel then
		return false, "Boost unlocks at level " .. LC.BoostMinLevel
	end
	-- schnelle Vorprüfung mit der lokalen Liste (spart Hin-und-her-Buchungen)
	local t = now()
	local active, nextFree = 0, math.huge
	for id, untilTime in boosts do
		if untilTime > t then
			active += 1
			nextFree = math.min(nextFree, untilTime - t)
			if id == coinId then
				return false, string.format("Already boosted (%dm left)", math.ceil((untilTime - t) / 60))
			end
		end
	end
	if active >= LC.BoostSlots then
		return false, string.format("Boost slots full – next free in %dm", math.ceil(nextFree / 60))
	end
	if not free and wallet.Cash < LC.BoostCost then
		return false, "You need " .. Format.Cash(LC.BoostCost) .. " Cash"
	end
	local payId = HttpService:GenerateGUID(false)
	local okPay, paid
	if free then
		okPay, paid = PlayerData.WalletUpdate(player, Ledger.WalletFreeBoost, {
			Job = WorldService.JobId,
			Id = payId,
			Delta = -1,
		})
	else
		okPay, paid = PlayerData.WalletUpdate(player, Ledger.WalletAddCash, {
			Job = WorldService.JobId,
			Id = payId,
			Delta = -LC.BoostCost,
		})
	end
	if not okPay or not paid or not paid.Ok then
		return false, if free then "Boost failed – try again" else "Not enough cash"
	end
	local okClaim, claim, newBoosts = marketMap:Update("Boosts", Ledger.BoostClaim, {
		Coin = coinId,
		Id = payId,
		Now = now(),
		Seconds = LC.BoostSeconds,
		Slots = LC.BoostSlots,
	})
	if okClaim and claim and claim.Ok then
		if newBoosts then
			boosts = {}
			for id, entry in newBoosts do
				boosts[id] = entry.U
			end
			boostsChanged = true
		end
		return true,
			string.format(
				"🚀 $%s boosted for %d min!%s",
				coin.Ticker,
				math.floor(LC.BoostSeconds / 60),
				if free then " (free creator boost)" else ""
			)
	end
	-- kein Platz (oder Fehler): Geld bzw. Gratis-Boost zurück, mit eigener Buchungsnummer (nie doppelt)
	if free then
		PlayerData.WalletUpdate(player, Ledger.WalletFreeBoost, {
			Job = WorldService.JobId,
			Id = HttpService:GenerateGUID(false),
			Delta = 1,
		})
	else
		PlayerData.WalletUpdate(player, Ledger.WalletAddCash, {
			Job = WorldService.JobId,
			Id = HttpService:GenerateGUID(false),
			Delta = LC.BoostCost,
		})
	end
	if claim and claim.Full then
		return false, string.format("Boost slots full – next free in %dm (refunded)", math.ceil(claim.NextFree / 60))
	end
	return false, ((claim and claim.Error) or "Boost failed") .. " (refunded)"
end

function MarketService.Boost(player: Player, coinId: string): boolean
	return enqueue(player, function()
		local ok, message = executeBoost(player, coinId)
		if player.Parent then
			reply(player, ok, message)
			PlayerData.PushState(player)
		end
	end)
end

-- Rugpull: Ersteller verkauft alles im eigenen Coin auf einmal (Lizenz, Level 25, Coin ≥ 10 Min., 1 pro 24 Std.).
-- Schnelle Vorprüfung hier, die echten Prüfungen laufen atomar im Ledger (Geldbörse + Coin).
local function executeRug(player: Player, coinId: string)
	local wallet = PlayerData.GetWallet(player)
	local coin = coins[coinId]
	if not wallet or not coin then
		return false, "Coin not found"
	end
	if coin.CreatorKey ~= PlayerData.Key(player) then
		return false, "You can only rug your own coin"
	end
	if coin.Rugged or coin.Dead then
		return false, "This coin can't be rugged anymore"
	end
	if (wallet.RL or 0) <= 0 then -- Lizenz = Freischaltung (per Cash ab Lv 25, per Robux ohne Level)
		return false, "You need a rug pull license"
	end
	if now() - coin.CreatedAt < RG.MinCoinAge then
		return false, string.format("Rug pull: coin must be %d min old", math.floor(RG.MinCoinAge / 60))
	end
	return executeTrade(player, coinId, "Sell", 1, true)
end

function MarketService.Rug(player: Player, coinId: string): boolean
	return enqueue(player, function()
		local ok, message = executeRug(player, coinId)
		if player.Parent then
			reply(player, ok, message)
			PlayerData.PushState(player)
		end
	end)
end

-- Rug-Lizenz kaufen (Level 25, 250.000 Cash, 3 Rugpulls; neue erst, wenn die alte aufgebraucht ist)
local function executeLicense(player: Player)
	local wallet = PlayerData.GetWallet(player)
	if not wallet then
		return false, "Still loading your data…"
	end
	if PlayerData.GetStats(player).Level < RG.MinLevel then
		return false, "Rug pull license unlocks at level " .. RG.MinLevel
	end
	local okBuy, bought = PlayerData.WalletUpdate(player, Ledger.WalletBuyLicense, {
		Job = WorldService.JobId,
		Id = HttpService:GenerateGUID(false),
		Cost = RG.LicenseCost,
		Uses = RG.LicenseUses,
	})
	if not okBuy or not bought then
		return false, "Please try again"
	end
	if not bought.Ok then
		return false, bought.Error or "Purchase failed"
	end
	return true, string.format("☠ Rug pull license bought: %d rug pulls", RG.LicenseUses)
end

function MarketService.BuyLicense(player: Player): boolean
	return enqueue(player, function()
		local ok, message = executeLicense(player)
		if player.Parent then
			reply(player, ok, message)
			PlayerData.PushState(player)
		end
	end)
end

-- Highlight (Robux-Gutschein) am eigenen aktiven Coin: erst Gutschein abbuchen, dann Coin, sonst zurück
local function executeHighlight(player: Player)
	local wallet = PlayerData.GetWallet(player)
	if not wallet then
		return false, "Still loading your data…"
	end
	if ((wallet.V and wallet.V.HT) or 0) <= 0 then
		return false, "No highlight left"
	end
	local coin = wallet.MyCoin and coins[wallet.MyCoin]
	if not coin or coin.Dead then
		return true, "✨ Highlight saved – it starts with your next coin"
	end
	local useId = HttpService:GenerateGUID(false)
	local okUse, used = PlayerData.WalletUpdate(player, Ledger.WalletVoucher, {
		Job = WorldService.JobId,
		Id = useId,
		Kind = "HT",
		Delta = -1,
	})
	if not okUse or not used or not used.Ok then
		return false, "Please try again"
	end
	local ok, result, newValue = coinsMap:Update(coin.Id, Ledger.CoinHighlight, {
		Key = PlayerData.Key(player),
		Id = useId,
		Now = now(),
		Seconds = Config.Shop.HighlightSeconds,
	})
	if ok and result and result.Ok then
		if newValue then
			onCoinValue(newValue)
		end
		return true, string.format("✨ $%s highlighted for %d min!", coin.Ticker, math.floor(Config.Shop.HighlightSeconds / 60))
	end
	PlayerData.WalletUpdate(player, Ledger.WalletVoucher, {
		Job = WorldService.JobId,
		Id = HttpService:GenerateGUID(false),
		Kind = "HT",
		Delta = 1,
	})
	return false, "Highlight failed – you keep it, try again"
end

function MarketService.Highlight(player: Player): boolean
	return enqueue(player, function()
		local ok, message = executeHighlight(player)
		if player.Parent then
			reply(player, ok, message)
			PlayerData.PushState(player)
		end
	end)
end

-- Pro-Terminal: Top 10 Holder eines Coins -> { { Key, Share } } (Namen holt der MonetizationService)
function MarketService.TopHolders(coinId: string)
	local value = MarketService.ReadCoin(coinId)
	if type(value) ~= "table" or type(value.H) ~= "table" then
		return nil
	end
	local list = {}
	for key, h in value.H do
		table.insert(list, { Key = key, Share = h.A / C.TotalSupply, Dev = key == value.CK })
	end
	table.sort(list, function(a, b)
		return a.Share > b.Share
	end)
	while #list > 10 do
		table.remove(list)
	end
	return list
end

-- Verkauf im Auftrag des Spielers einreihen (Stop-Loss, solange er online ist)
function MarketService.QueueSell(player: Player, coinId: string, prefix: string): boolean
	return enqueue(player, function()
		local ok, message = executeTrade(player, coinId, "Sell", 1)
		if player.Parent then
			reply(player, ok, prefix .. message)
			PlayerData.PushState(player)
		end
	end)
end

-- Stop-Loss im Coin setzen (level = 0.1 .. 0.5 oder nil = aus) -> ok, fehler
function MarketService.SetStopLoss(player: Player, coinId: string, level: number?)
	local ok, result, newValue = coinsMap:Update(coinId, Ledger.CoinSetStopLoss, {
		Key = PlayerData.Key(player),
		Level = level,
	})
	if not ok or not result then
		return false, "Market busy – please try again"
	end
	if newValue then
		onCoinValue(newValue)
	end
	return result.Ok, result.Error
end

-- Coin-Wert direkt lesen (Host: Stop-Loss von Offline-Spielern prüfen)
function MarketService.ReadCoin(coinId: string)
	local ok, value = coinsMap:Get(coinId)
	return if ok then value else nil
end

-- Host: Stop-Loss für einen Offline-Spieler ausführen -> ergebnis oder nil.
-- Ohne Wiederholung: im Zweifel bekommt der Spieler nichts, aber nie doppelt.
function MarketService.StopLossExec(coinId: string, key: string)
	local ok, result, newValue = coinsMap:UpdateOnce(coinId, Ledger.CoinStopLossExec, { Key = key, Now = now() })
	if ok and newValue and result then
		onCoinValue(newValue)
		return result
	end
	return nil
end

function MarketService.Reply(player: Player, ok: boolean, message: string)
	reply(player, ok, message)
end

-- Client schickt: coinId (string), side ("Buy"/"Sell"), fraction (0 < f <= 1)
local function onTradeRequest(player: Player, coinId: any, side: any, fraction: any)
	if not tradeLimiter:Allow(player) or not minuteLimiter:Allow(player) then
		if warnLimiter:Allow(player) then
			reply(player, false, "Too fast! Slow down a little.")
		end
		return
	end
	if typeof(coinId) ~= "string" or #coinId > 20 or (side ~= "Buy" and side ~= "Sell") then
		reply(player, false, "Invalid request")
		return
	end
	if not isValidNumber(fraction) or fraction <= 0 or fraction > 1 then
		reply(player, false, "Invalid amount")
		return
	end
	if not coins[coinId] then
		reply(player, false, "Coin not found")
		return
	end
	local queued = enqueue(player, function()
		local ok, message = executeTrade(player, coinId, side, fraction)
		if player.Parent then
			reply(player, ok, message)
			PlayerData.PushState(player)
		end
	end)
	if not queued then
		reply(player, false, "Please wait – your trades are still processing")
	end
end

local function onSnapshotRequest(player: Player)
	if not snapshotLimiter:Allow(player) then
		return nil
	end
	local list = {}
	for _, coin in coins do
		table.insert(list, fullInfo(coin))
	end
	return { Coins = list, Me = PlayerData.BuildState(player), Boosts = boosts }
end

------------------------------------------------------------------------
-- Für den NPC-Host
------------------------------------------------------------------------

-- Wird vom ProtectionService gesetzt: function(coin, ergebnis) nach einem Rugpull
MarketService.RugHandler = nil :: ((any, any) -> ())?
-- Vom CreatorService gesetzt: Name mit Creator-Abzeichen / Monat für den Gratis-Coin (Gold)
MarketService.DecorateName = nil :: ((string, string) -> string)?
MarketService.FreeCoinMonth = nil :: ((Player, any) -> number?)?
-- Vom MonetizationService gesetzt: hat der Spieler diesen Gamepass?
MarketService.HasPass = nil :: ((Player, string) -> boolean)?
-- Vom TradeLogService gesetzt: Eintrag im Trade-Verlauf
MarketService.OnTrade = nil :: ((Player, any) -> ())?

function MarketService.GetCoins()
	return coins
end

function MarketService.LiveCoinCount(): number
	local count = 0
	for _, coin in coins do
		if not coin.Dead then
			count += 1
		end
	end
	return count
end

-- Verkaufswert einer Menge (nach Gebühr)
function MarketService.PositionValue(coin, amount: number): number
	return Curve.CashForTokens(C, coin.Supply, amount) * (1 - Config.Fees.Creator - Config.Fees.Burn)
end

function MarketService.Price(coin): number
	return Curve.Price(C, coin.Supply)
end

-- Kursänderung der letzten "seconds" Sekunden (0.1 = +10 %)
function MarketService.PriceChange(coin, seconds: number): number
	local n = math.max(1, math.ceil(seconds / Config.Market.ChartInterval))
	local ref = coin.Chart[#coin.Chart - n + 1] or coin.Chart[1] or coin.Candle
	if ref.O <= 0 then
		return 0
	end
	return Curve.Price(C, coin.Supply) / ref.O - 1
end

-- Ist dieser Ticker gerade bei einem gelisteten Coin vergeben?
function MarketService.TickerTaken(ticker: string): boolean
	for _, coin in coins do
		if coin.Ticker == ticker and not coin.Dead then
			return true
		end
	end
	return false
end

-- Neuer Coin (NPC). info = { Name, Ticker, Icon, Desc, CreatorKey, CreatorName } -> lokaler Coin oder nil
function MarketService.CreateCoin(info)
	info.Id = newCoinId()
	local value = Ledger.NewCoin(info, now())
	if not coinsMap:Set(info.Id, value) then
		return nil
	end
	local coin = onCoinValue(value)
	coin.LocalCreatedAt = os.clock()
	return coin
end

-- NPC-Trade (nur Host, ohne Nummer -> ohne automatische Wiederholung).
-- a = { Side, Cash (Kauf), Frac (Verkauf), Rug? }
-- -> ok, ergebnis. Bei ok = false steht in ergebnis.Amount (falls bekannt) der echte Bestand.
function MarketService.NpcTrade(wallet, coinId: string, a)
	local args = {
		Key = wallet.Key,
		Name = wallet.Name,
		IsNpc = true,
		Side = a.Side,
		Cash = a.Cash,
		Frac = a.Frac,
		Rug = a.Rug,
		Now = now(),
	}
	local ok, result, newValue = coinsMap:UpdateOnce(coinId, Ledger.CoinTrade, args)
	if ok then
		if newValue and result and result.Ok then
			local coin = onCoinValue(newValue)
			afterTrade(wallet, coin, result, a.Rug == true)
			return true, result
		end
		return false, result
	end
	-- Unklar, ob gebucht wurde: echten Bestand nachlesen
	local okGet, value = coinsMap:Get(coinId)
	if not okGet then
		return false, nil
	end
	if value then
		onCoinValue(value)
	end
	local holding = value and value.H[wallet.Key]
	local amount = if holding then holding.A else 0
	if result and result.Ok and math.abs(amount - result.Amount) < 1e-6 then
		local coin = coins[coinId]
		if coin then
			afterTrade(wallet, coin, result, a.Rug == true)
		end
		return true, result -- wurde gebucht
	end
	return false, { Ok = false, Error = "unknown", Amount = amount, Cost = if holding then holding.C else 0 }
end

-- Gesammelte Gebühren der NPC-Ersteller abholen (Host). -> { [npcKey] = Betrag }
function MarketService.DrainNpcFees()
	local ok, result = marketMap:Update("InboxNpc", Ledger.InboxDrain, {})
	return if ok and result then result else {}
end

local function removeCoinEverywhere(id: string)
	local shard = shardOf(id)
	local q = flushQueue[shard] or { Updates = {}, Removes = {} }
	q.Updates[id] = nil
	q.Removes[id] = true
	flushQueue[shard] = q
	removeLocal(id)
end

-- Host: tote Coins markieren, tote Coins ohne Spieler löschen,
-- nach DeadKeepHours ohne Trade Reste automatisch verkaufen (Cash ins Postfach der Spieler)
function MarketService.HostMaintenance()
	local t = now()
	local ids = {} -- Kopie der Liste: während der Speicherzugriffe kann sich "coins" ändern
	for id in coins do
		table.insert(ids, id)
	end
	for _, id in ids do
		local coin = coins[id]
		if not coin then
			continue
		end
		if not coin.Dead and t - coin.LastTradeAt >= Config.Market.DeadAfter then
			local ok, _, newValue =
				coinsMap:Update(id, Ledger.CoinMarkDead, { Now = t, DeadAfter = Config.Market.DeadAfter })
			if ok and newValue then
				onCoinValue(newValue)
			end
		elseif coin.Dead then
			local ok, value = coinsMap:Get(id)
			if ok and (value == nil or not Ledger.HasPlayerHolders(value)) then
				if value == nil or coinsMap:Remove(id) then
					removeCoinEverywhere(id)
				end
			elseif ok and t - value.LT >= W.DeadKeepHours * 3600 then
				local okClose, payouts = coinsMap:Update(id, Ledger.CoinCloseOut, {
					Now = t,
					KeepSeconds = W.DeadKeepHours * 3600,
				})
				if okClose and payouts then
					-- ohne Wiederholung: im Fehlerfall verfällt die Auszahlung, sie kommt aber nie doppelt
					for key, payout in payouts do
						inboxMap:UpdateOnce("u_" .. key, Ledger.InboxAdd, { Adds = { Cash = payout } })
					end
					coinsMap:Remove(id)
					removeCoinEverywhere(id)
				end
			end
		end
	end
end

-- Host: Charts speichern, damit neue Server sofort Verlauf zeigen (Preis/P0*100 als ganze Zahlen)
function MarketService.SaveCharts()
	local byShard = {}
	for id, coin in coins do
		if not coin.Dead then
			local parts = {}
			for _, point in coin.Chart do
				table.insert(parts, tostring(math.floor(point.C / C.P0 * 100 + 0.5)))
			end
			local shard = shardOf(id)
			byShard[shard] = byShard[shard] or {}
			byShard[shard][id] = table.concat(parts, ",")
		end
	end
	for shard = 1, W.Shards do
		marketMap:Set("C" .. shard, byShard[shard] or {})
	end
end

local function loadCharts()
	for shard = 1, W.Shards do
		local ok, data = marketMap:Get("C" .. shard)
		if ok and data then
			for id, text in data do
				local coin = coins[id]
				if coin and #coin.Chart == 0 then
					for part in string.gmatch(text, "%d+") do
						local p = tonumber(part) * C.P0 / 100
						coin.PointCount += 1
						table.insert(coin.Chart, { T = coin.PointCount, O = p, H = p, L = p, C = p })
					end
				end
			end
		end
	end
end

------------------------------------------------------------------------
-- Takt: lesen, schreiben, Charts, Updates an Clients
------------------------------------------------------------------------

-- Kurzinfos aller Server lesen
local function poll()
	local seen, allOk = {}, true
	for shard = 1, W.Shards do
		local ok, data = marketMap:Get("S" .. shard)
		if ok then
			for id, info in data or {} do
				seen[id] = true
				applyInfo(info)
			end
		else
			allOk = false
		end
	end
	if not allOk then
		return -- unvollständig: nichts löschen
	end
	for id, coin in coins do
		local q = flushQueue[shardOf(id)]
		local waiting = q ~= nil and q.Updates[id] ~= nil
		local fresh = coin.LocalCreatedAt ~= nil and os.clock() - coin.LocalCreatedAt < 10
		if not seen[id] and not waiting and not fresh then
			removeLocal(id)
		end
	end
end

-- Eigene Änderungen in die Sammel-Schlüssel schreiben
local function flush()
	-- Kopie nehmen: während des Schreibens (Wartezeit) kommen neue Änderungen in eine frische Warteschlange
	local batch = flushQueue
	flushQueue = {}
	for shard, q in batch do
		local ok = marketMap:Update("S" .. shard, Ledger.ShardMerge, q)
		if not ok then
			-- später nochmal (neuere Einträge nicht überschreiben)
			local again = flushQueue[shard] or { Updates = {}, Removes = {} }
			for id, info in q.Updates do
				if not again.Updates[id] and not again.Removes[id] then
					again.Updates[id] = info
				end
			end
			for id in q.Removes do
				if not again.Updates[id] then
					again.Removes[id] = true
				end
			end
			flushQueue[shard] = again
		end
	end
end

local function syncNews()
	if #newsOut > 0 then
		local items = newsOut
		newsOut = {}
		marketMap:UpdateOnce("News", Ledger.NewsAdd, { Items = items }) -- ohne Wiederholung: nie doppelt
	end
	local ok, news = marketMap:Get("News")
	if not ok then
		return
	end
	news = news or { Seq = 0, Items = {} }
	if lastNewsSeq == nil then
		lastNewsSeq = news.Seq -- alte Meldungen beim Start nicht zeigen
		return
	end
	for _, item in news.Items do
		if item.S > lastNewsSeq then
			table.insert(pendingNews, { Kind = item.K, Text = item.X })
		end
	end
	lastNewsSeq = math.max(lastNewsSeq, news.Seq)
end

local function flushPots()
	if potAdds.Ins <= 0 then
		return
	end
	local adds = { Ins = potAdds.Ins }
	potAdds.Ins = 0
	marketMap:UpdateOnce("Pots", Ledger.PotsAdd, adds) -- ohne Wiederholung: nie doppelt
end

local function flushFees()
	if next(npcFees) == nil and next(playerFees) == nil then
		return
	end
	local adds = npcFees
	npcFees = {}
	-- ohne Wiederholung: im Fehlerfall verfällt die Gebühr, sie wird aber nie doppelt gutgeschrieben
	if next(adds) then
		marketMap:UpdateOnce("InboxNpc", Ledger.InboxAdd, { Adds = adds })
	end
	local forPlayers = playerFees
	playerFees = {}
	for key, amount in forPlayers do
		inboxMap:UpdateOnce("u_" .. key, Ledger.InboxAdd, { Adds = { Cash = amount, Fee = amount } })
	end
end

local function syncBoosts()
	local ok, data = marketMap:Get("Boosts")
	if not ok then
		return
	end
	local fresh = {}
	for id, entry in data or {} do
		if type(entry) == "table" and type(entry.U) == "number" then
			fresh[id] = entry.U
		end
	end
	for id, untilTime in fresh do
		if boosts[id] ~= untilTime then
			boostsChanged = true
		end
	end
	for id in boosts do
		if not fresh[id] then
			boostsChanged = true
		end
	end
	boosts = fresh
end

local function closeChartPoints()
	for _, coin in coins do
		if coin.Dead then
			continue
		end
		local point = coin.Candle
		coin.PointCount += 1
		point.T = coin.PointCount
		table.insert(coin.Chart, point)
		if #coin.Chart > Config.Market.ChartPoints then
			table.remove(coin.Chart, 1)
		end
		table.insert(coin.NewPoints, point)
		coin.Candle = { O = point.C, H = point.C, L = point.C, C = point.C }
		dirty[coin.Id] = true
	end
end

local function broadcast()
	if next(dirty) == nil and #pendingTrades == 0 and #pendingNews == 0 and #removedIds == 0 and not boostsChanged then
		return
	end
	local list = {}
	for id in dirty do
		local coin = coins[id]
		if coin then
			table.insert(list, summary(coin))
			coin.NewPoints = {}
		end
	end
	updateEvent:FireAllClients({
		Coins = list,
		Trades = pendingTrades,
		News = pendingNews,
		Removed = removedIds,
		Boosts = if boostsChanged then boosts else nil,
	})
	boostsChanged = false
	dirty = {}
	pendingTrades = {}
	pendingNews = {}
	removedIds = {}
end

-- Endlosschleife mit Fehlerschutz (ein Fehler hält nie den Markt an)
local function loop(name: string, interval: () -> number, fn: () -> ())
	task.spawn(function()
		while true do
			task.wait(interval())
			local ok, err = pcall(fn)
			if not ok then
				warn("[Market] " .. name .. ": " .. tostring(err))
			end
		end
	end)
end

local function every(seconds: number): () -> number
	return function()
		return seconds
	end
end

function MarketService.Init(deps)
	PlayerData = deps.PlayerData
	updateEvent = Remotes.Event("MarketUpdate")
	resultEvent = Remotes.Event("TradeResult")
	Remotes.Event("TradeRequest").OnServerEvent:Connect(onTradeRequest)
	Remotes.Function("GetMarketSnapshot").OnServerInvoke = onSnapshotRequest
	Players.PlayerRemoving:Connect(function(player)
		tradeLimiter:Remove(player)
		minuteLimiter:Remove(player)
		warnLimiter:Remove(player)
		snapshotLimiter:Remove(player)
	end)
end

function MarketService.Start()
	-- Erst den Weltmarkt laden, dann Charts, dann laufen lassen
	pcall(poll)
	pcall(loadCharts)
	pcall(syncNews)

	local lastChart = os.clock()
	loop("broadcast", every(Config.Market.BroadcastInterval), function()
		if os.clock() - lastChart >= Config.Market.ChartInterval then
			lastChart = os.clock()
			closeChartPoints()
		end
		broadcast()
	end)
	loop("poll", function()
		return WorldService.SyncInterval(W.Shards)
	end, poll)
	loop("flush", function()
		return WorldService.SyncInterval(W.Shards * 2) -- Schreiben kostet 2 Einheiten, nur wenn sich etwas geändert hat
	end, flush)
	loop("news", every(W.NewsInterval), syncNews)
	loop("boosts", every(LC.BoostSyncInterval), syncBoosts)
	loop("fees", every(W.FeeFlushInterval), function()
		flushFees()
		flushPots()
	end)
	game:BindToClose(function()
		pcall(flush)
		pcall(flushFees)
		pcall(flushPots)
	end)
end

return MarketService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX14">
				<Properties>
					<string name="Name">MonetizationService</string>
					<ProtectedString name="Source"><![CDATA[-- MonetizationService (ModuleScript) – ServerScriptService/Services/MonetizationService
-- Robux (Phase 8):
--  * Developer Products (ProcessReceipt) geben Gutscheine: Coin erstellen, Boost, Highlight, Rug-Lizenz.
--    Gutschrift nur mit geladener Geldbörse auf DIESEM Server, Kauf-Nummer wird gemerkt -> nie doppelt,
--    erst danach "PurchaseGranted" (sonst wiederholt Roblox später, nichts geht verloren).
--  * Gamepässe: Pro-Terminal, Versicherung ½ Preis, Doppelter Daily, VIP. Besitz wird beim Join geprüft.
--  * Id = 0 (noch nicht angelegt): in Studio Test-Kauf über "ShopTestBuy", im echten Spiel nicht kaufbar.
--  * Pro: Top-10-Holder mit Namen (Server liest den Coin, max. 1 Anfrage pro 2 Sek.).
-- Keine Zufalls-Käufe, fester Inhalt, Cash nie zurück in Robux.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local MarketplaceService = game:GetService("MarketplaceService")
local UserService = game:GetService("UserService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ServerScriptService.Util.Remotes)
local RateLimiter = require(ServerScriptService.Util.RateLimiter)
local Ledger = require(ServerScriptService.Util.Ledger)
local WorldService = require(ServerScriptService.Services.WorldService)
local PlayerDataService = require(ServerScriptService.Services.PlayerDataService)
local MarketService = require(ServerScriptService.Services.MarketService)

local SHOP = Config.Shop

local MonetizationService = {}

local productById = {} -- [ProductId] = Name
local passById = {} -- [PassId] = Name
local owned = {} -- [player] = { [PassName] = true }
local nameCache = {} -- [userId] = Anzeigename
local vipCache = {} -- [userId] = { Vip, At } (für die weltweite Rangliste)
local proLimiter = RateLimiter.new(1, SHOP.ProInfoCooldown)
local testLimiter = RateLimiter.new(1, 2)

function MonetizationService.HasPass(player: Player, name: string): boolean
	local passes = owned[player]
	return passes ~= nil and passes[name] == true
end

function MonetizationService.PassState(player: Player)
	local result = {}
	for name in SHOP.Passes do
		result[name] = MonetizationService.HasPass(player, name)
	end
	return result
end

------------------------------------------------------------------------
-- Gamepässe
------------------------------------------------------------------------

local function checkPasses(player: Player)
	local passes = owned[player] or {}
	for name, pass in SHOP.Passes do
		if pass.Id ~= 0 and not passes[name] then
			local ok, has = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, pass.Id)
			end)
			if ok and has then
				passes[name] = true
			end
		end
	end
	owned[player] = passes
end

-- VIP-Status beliebiger Spieler (weltweite Rangliste), mit Zwischenspeicher
function MonetizationService.IsVipUserId(userId: number): boolean
	local player = Players:GetPlayerByUserId(userId)
	if player then
		return MonetizationService.HasPass(player, "Vip")
	end
	local passId = SHOP.Passes.Vip.Id
	if passId == 0 then
		return false
	end
	local cached = vipCache[userId]
	local t = os.clock()
	if cached and t - cached.At < SHOP.VipCacheSeconds then
		return cached.Vip
	end
	local ok, has = pcall(function()
		return MarketplaceService:UserOwnsGamePassAsync(userId, passId)
	end)
	if not ok then
		return if cached then cached.Vip else false
	end
	vipCache[userId] = { Vip = has == true, At = t }
	return has == true
end

------------------------------------------------------------------------
-- Developer Products
------------------------------------------------------------------------

-- Gutschrift (echter Kauf oder Studio-Test). -> true, wenn gebucht (oder schon gebucht)
local function grant(player: Player, name: string, receipt: string): boolean
	local product = SHOP.Products[name]
	if not product or not PlayerDataService.GetWallet(player) then
		return false
	end
	local ok, result = PlayerDataService.WalletUpdate(player, Ledger.WalletGrantProduct, {
		Job = WorldService.JobId,
		Receipt = receipt,
		Grant = product.Grant,
		Uses = Config.Rug.LicenseUses,
	})
	if not ok or not result or not result.Ok then
		return false
	end
	if not result.Already then
		print(string.format("[Shop] %s (%d) bought %s (%s)", player.Name, player.UserId, name, receipt))
		PlayerDataService.Notify(player, true, "✅ Thanks! " .. product.Title .. " added")
		PlayerDataService.PushState(player)
		if name == "Highlight" then
			MarketService.Highlight(player) -- startet sofort am aktiven Coin (sonst mit dem nächsten)
		end
	end
	return true
end

local function processReceipt(info)
	local player = Players:GetPlayerByUserId(info.PlayerId)
	local name = productById[info.ProductId]
	if not player or not name then
		if not name then
			warn("[Shop] unknown product " .. tostring(info.ProductId))
		end
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	-- warten, bis die Daten geladen sind (Kauf direkt nach dem Join)
	for _ = 1, 20 do
		if PlayerDataService.GetWallet(player) or not player.Parent then
			break
		end
		task.wait(0.5)
	end
	local ok, granted = pcall(grant, player, name, tostring(info.PurchaseId))
	if ok and granted then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	return Enum.ProductPurchaseDecision.NotProcessedYet -- Roblox versucht es später nochmal
end

------------------------------------------------------------------------
-- Studio-Test (nur in Studio, nur für noch nicht angelegte Ids)
------------------------------------------------------------------------

local testCounter = 0
local function onTestBuy(player: Player, name: any)
	if not RunService:IsStudio() or not testLimiter:Allow(player) or typeof(name) ~= "string" then
		return
	end
	local product, pass = SHOP.Products[name], SHOP.Passes[name]
	if product and product.Id == 0 then
		testCounter += 1
		grant(player, name, string.format("studio-%d-%d-%d", player.UserId, os.time(), testCounter))
	elseif pass and pass.Id == 0 then
		owned[player] = owned[player] or {}
		owned[player][name] = true -- nur bis zum Verlassen (Studio)
		PlayerDataService.Notify(player, true, "✅ (Studio test) " .. pass.Title .. " unlocked")
		PlayerDataService.PushState(player)
	end
end

------------------------------------------------------------------------
-- Pro: Top 10 mit Namen
------------------------------------------------------------------------

local function namesFor(userIds: { number })
	local missing = {}
	for _, userId in userIds do
		local player = Players:GetPlayerByUserId(userId)
		if player then
			nameCache[userId] = player.DisplayName
		elseif not nameCache[userId] then
			table.insert(missing, userId)
		end
	end
	if #missing > 0 then
		local ok, infos = pcall(function()
			return UserService:GetUserInfosByUserIdsAsync(missing)
		end)
		if ok then
			for _, info in infos do
				nameCache[info.Id] = info.DisplayName
			end
		end
	end
end

local function onProInfo(player: Player, coinId: any)
	if not MonetizationService.HasPass(player, "Pro") or not proLimiter:Allow(player) then
		return nil
	end
	if typeof(coinId) ~= "string" or #coinId > 20 then
		return nil
	end
	local list = MarketService.TopHolders(coinId)
	if not list then
		return nil
	end
	local ids = {}
	for _, entry in list do
		local userId = tonumber(entry.Key)
		if userId then
			table.insert(ids, userId)
		end
	end
	namesFor(ids)
	local result = {}
	for _, entry in list do
		local userId = tonumber(entry.Key)
		table.insert(result, {
			N = if userId then nameCache[userId] or ("Player " .. userId) else "🤖 Bot trader",
			S = entry.Share,
			D = entry.Dev or nil, -- Ersteller
			U = if userId then entry.Key else nil,
		})
	end
	return result
end

------------------------------------------------------------------------

function MonetizationService.Init()
	for name, product in SHOP.Products do
		if product.Id ~= 0 then
			productById[product.Id] = name
		end
	end
	for name, pass in SHOP.Passes do
		if pass.Id ~= 0 then
			passById[pass.Id] = name
		end
	end
	MarketplaceService.ProcessReceipt = processReceipt
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		local name = passById[passId]
		if purchased and name then
			owned[player] = owned[player] or {}
			owned[player][name] = true
			print(string.format("[Shop] %s (%d) bought pass %s", player.Name, player.UserId, name))
			PlayerDataService.Notify(player, true, "✅ Thanks! " .. SHOP.Passes[name].Title .. " unlocked")
			PlayerDataService.PushState(player)
		end
	end)
	Remotes.Event("ShopTestBuy").OnServerEvent:Connect(onTestBuy)
	Remotes.Function("ProInfo").OnServerInvoke = onProInfo
	PlayerDataService.PassState = MonetizationService.PassState

	local function onJoin(player: Player)
		checkPasses(player)
		PlayerDataService.PushState(player)
	end
	Players.PlayerAdded:Connect(onJoin)
	for _, player in Players:GetPlayers() do
		task.spawn(onJoin, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		owned[player] = nil
		proLimiter:Remove(player)
		testLimiter:Remove(player)
	end)
end

return MonetizationService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX15">
				<Properties>
					<string name="Name">NpcTraderService</string>
					<ProtectedString name="Source"><![CDATA[-- NpcTraderService (ModuleScript) – ServerScriptService/Services/NpcTraderService
-- 20 NPC-Trader halten den Weltmarkt am Leben. Sie handeln über dieselben Regeln und Gebühren wie Spieler.
-- Nur der Host-Server (WorldService) lässt sie handeln – egal wie viele Server laufen, es gibt sie nur einmal.
-- Ihr Zustand (Cash, Positionen, Rug-Pläne) wird alle 10 Sek. gespeichert; ein neuer Host macht weiter.
-- Weltweit alle 1–3 Min. ein neuer NPC-Coin, ca. 10 % davon sind NPC-Rugs.
--
-- Typen:
--   Sniper   kauft neue Coins – zufällig OB (40 %) und WANN (5–120 Sek.), damit niemand sie vorhersagen
--            und „melken“ kann. Verkauft bei +50 %, -30 % oder nach 2 Min.
--   Momentum kauft, was gerade steigt, verkauft, wenn es fällt
--   Panik    kauft beliebte Coins, verkauft alles bei schnellem Fall
--   Zufall   kauft/verkauft zufällig kleine Beträge
-- Alle: kaufen nur Coins < 15 Min. und steigen danach aus (so sterben alte Coins).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Config = require(ReplicatedStorage.Shared.Config)
local Curve = require(ReplicatedStorage.Shared.BondingCurve)
local Store = require(ServerScriptService.Util.Store)
local Ledger = require(ServerScriptService.Util.Ledger)
local MarketService = require(ServerScriptService.Services.MarketService)
local WorldService = require(ServerScriptService.Services.WorldService)

local Npc = Config.Npc
local C = Config.Curve
local W = Config.World
local FEE_TOTAL = Config.Fees.Creator + Config.Fees.Burn

local NpcTraderService = {}

local marketMap = Store.Map(W.MarketMap, W.Expiration)
local npcs = {} -- [key] = npc
local npcList = {}
local rugPlans = {} -- [coinId] = { CreatorKey, StartPrice, MinGain } (geheim, nur Server)
local nextCoinAt = 0
local rng = Random.new()

local function now(): number
	return workspace:GetServerTimeNow()
end

local function pick(list)
	if #list == 0 then
		return nil
	end
	return list[rng:NextInteger(1, #list)]
end

------------------------------------------------------------------------
-- NPCs und ihr gespeicherter Zustand
------------------------------------------------------------------------

local function createNpc(index: number, kind: string)
	local npc = {
		Key = "npc:" .. index,
		Name = Npc.Names[index] or ("Trader" .. index),
		Kind = kind,
		Cash = Npc.StartCash,
		Holdings = {}, -- [coinId] = { Amount, Cost }
		BoughtAt = {}, -- [coinId] = Zeit des ersten Kaufs
		SnipePlans = {}, -- [coinId] = Verzögerung in Sek. oder false (kauft nicht) – nur Sniper
	}
	npc.Wallet = { Key = npc.Key, Name = npc.Name, IsNpc = true }
	return npc
end

local function saveState()
	local state = { N = {}, R = rugPlans, Next = nextCoinAt }
	for key, npc in npcs do
		state.N[key] = { Cash = npc.Cash, H = npc.Holdings, B = npc.BoughtAt, P = npc.SnipePlans }
	end
	marketMap:Set("Npcs", state)
end

-- Neuer Host: gespeicherten Zustand übernehmen (falls vorhanden)
local function loadState()
	local ok, state = marketMap:Get("Npcs")
	if not ok or type(state) ~= "table" then
		return
	end
	for key, saved in state.N or {} do
		local npc = npcs[key]
		if npc and type(saved) == "table" and type(saved.Cash) == "number" then
			npc.Cash = saved.Cash
			npc.Holdings = saved.H or {}
			npc.BoughtAt = saved.B or {}
			npc.SnipePlans = saved.P or {}
		end
	end
	rugPlans = state.R or {}
	nextCoinAt = state.Next or 0
end

------------------------------------------------------------------------
-- Handeln
------------------------------------------------------------------------

local function pnlOf(coin, holding): number
	if holding.Cost <= 0 then
		return 0
	end
	local value = Curve.CashForTokens(C, coin.Supply, holding.Amount) * (1 - FEE_TOTAL)
	return value / holding.Cost - 1
end

-- Bestand nach einem Trade (oder unklarem Ausgang) übernehmen
local function setHolding(npc, coinId: string, result)
	if result and result.Amount ~= nil then
		npc.Holdings[coinId] = if result.Amount > 0 then { Amount = result.Amount, Cost = result.Cost or 0 } else nil
		if not npc.Holdings[coinId] then
			npc.BoughtAt[coinId] = nil
		end
	end
end

-- NPCs kaufen nur lebende, nicht gerugte, fremde und nicht zu alte Coins
local function canBuy(npc, coin, t: number): boolean
	return not coin.Dead and not coin.Rugged and coin.CreatorKey ~= npc.Key and t - coin.CreatedAt <= Npc.MaxBuyAge
end

local function buy(npc, coin, minShare: number, maxShare: number): boolean
	local cash = Ledger.FloorCents(npc.Cash * rng:NextNumber(minShare, maxShare))
	if cash < Config.Trade.MinCash then
		return false
	end
	local ok, result = MarketService.NpcTrade(npc.Wallet, coin.Id, { Side = "Buy", Cash = cash })
	if ok then
		npc.Cash = Ledger.FloorCents(npc.Cash - result.Cash)
		npc.BoughtAt[coin.Id] = npc.BoughtAt[coin.Id] or now()
	end
	setHolding(npc, coin.Id, result)
	return ok
end

local function sell(npc, coin, share: number, rug: boolean?): boolean
	if not npc.Holdings[coin.Id] then
		return false
	end
	local ok, result = MarketService.NpcTrade(npc.Wallet, coin.Id, { Side = "Sell", Frac = share, Rug = rug })
	if ok then
		-- Rugpull: 30 % des Erlöses gehen in den Erstattungstopf (bucht der ProtectionService)
		local keep = if rug then 1 - Config.Protection.RugPotShare else 1
		npc.Cash = Ledger.FloorCents(npc.Cash + result.Cash * keep)
	end
	setHolding(npc, coin.Id, result)
	return ok
end

-- Geht alle Positionen durch. rule(coin, pnl, heldFor) gibt Anteil zum Verkaufen zurück (oder nil).
local function trySell(npc, t: number, rule): boolean
	for coinId, holding in npc.Holdings do
		local coin = MarketService.GetCoins()[coinId]
		if coin and not coin.Dead and coin.CreatorKey ~= npc.Key then
			local share = rule(coin, pnlOf(coin, holding), t - (npc.BoughtAt[coinId] or t))
			if share then
				return sell(npc, coin, share)
			end
		end
	end
	return false
end

local function buyable(npc, t: number, filter)
	local list = {}
	for _, coin in MarketService.GetCoins() do
		if canBuy(npc, coin, t) and filter(coin) then
			table.insert(list, coin)
		end
	end
	return list
end

-- Zu alte Coins: NPCs steigen komplett aus, damit alte Coins auslaufen und sterben
local function dumpOldCoin(npc, t: number): boolean
	for coinId in npc.Holdings do
		local coin = MarketService.GetCoins()[coinId]
		if coin and not coin.Dead and coin.CreatorKey ~= npc.Key and t - coin.CreatedAt > Npc.MaxBuyAge then
			return sell(npc, coin, 1)
		end
	end
	return false
end

local STRATEGIES = {
	Sniper = function(npc, t)
		local sold = trySell(npc, t, function(_, pnl, heldFor)
			return if pnl >= 0.5 or pnl <= -0.3 or heldFor >= 120 then 1 else nil
		end)
		if sold then
			return
		end
		local cfg = Npc.Sniper
		local ready = {}
		for _, coin in buyable(npc, t, function(c)
			return t - c.CreatedAt <= cfg.MaxAge and not npc.Holdings[c.Id]
		end) do
			local plan = npc.SnipePlans[coin.Id]
			if plan == nil then
				-- einmal pro Coin würfeln: kaufen ja/nein und nach wie vielen Sekunden
				plan = if rng:NextNumber() < cfg.Chance then rng:NextNumber(cfg.Delay[1], cfg.Delay[2]) else false
				npc.SnipePlans[coin.Id] = plan
			end
			if plan and t - coin.CreatedAt >= plan then
				table.insert(ready, coin)
			end
		end
		local coin = pick(ready)
		if coin then
			npc.SnipePlans[coin.Id] = false -- nur einmal kaufen
			buy(npc, coin, cfg.Share[1], cfg.Share[2])
		end
	end,

	Momentum = function(npc, t)
		local sold = trySell(npc, t, function(coin, pnl)
			return if MarketService.PriceChange(coin, 30) <= -0.08 or pnl >= 1 then 1 else nil
		end)
		if sold then
			return
		end
		local best, bestChange = nil, 0.10
		for _, coin in buyable(npc, t, function()
			return true
		end) do
			local change = MarketService.PriceChange(coin, 30)
			if change >= bestChange then
				best, bestChange = coin, change
			end
		end
		if best then
			buy(npc, best, 0.10, 0.20)
		end
	end,

	Panic = function(npc, t)
		local sold = trySell(npc, t, function(coin, pnl)
			if MarketService.PriceChange(coin, 15) <= -0.10 then
				return 1
			end
			return if pnl >= 0.3 then 0.5 else nil
		end)
		if sold then
			return
		end
		local coin = pick(buyable(npc, t, function(c)
			return c.Holders >= 3
		end))
		if coin then
			buy(npc, coin, 0.05, 0.15)
		end
	end,

	Random = function(npc, t)
		if rng:NextNumber() < 0.5 then
			local held = {}
			for coinId in npc.Holdings do
				local coin = MarketService.GetCoins()[coinId]
				if coin and not coin.Dead and coin.CreatorKey ~= npc.Key then
					table.insert(held, coin)
				end
			end
			local coin = pick(held)
			if coin then
				sell(npc, coin, rng:NextNumber(0.25, 1))
				return
			end
		end
		local coin = pick(buyable(npc, t, function()
			return true
		end))
		if coin then
			buy(npc, coin, 0.05, 0.15)
		end
	end,
}

------------------------------------------------------------------------
-- NPC-Coins und NPC-Rugs
------------------------------------------------------------------------

local function tickerTaken(ticker: string): boolean
	for _, coin in MarketService.GetCoins() do
		if coin.Ticker == ticker then
			return true
		end
	end
	return false
end

local function createNpcCoin()
	local creator = pick(npcList)
	local prefix, noun, ticker
	for _ = 1, 10 do
		prefix = pick(Npc.Prefixes)
		noun = pick(Npc.Nouns)
		ticker = string.upper(string.sub(prefix, 1, 2) .. string.sub(noun[1], 1, 3))
		if not tickerTaken(ticker) then
			break
		end
	end

	local isRug = rng:NextNumber() < Npc.RugChance
	local coin = MarketService.CreateCoin({
		Name = prefix .. " " .. noun[1],
		Ticker = ticker,
		Icon = noun[2],
		Desc = pick(Npc.Descriptions),
		CreatorKey = creator.Key,
		CreatorName = creator.Name,
	})
	if not coin then
		return
	end
	creator.Holdings[coin.Id] = { Amount = C.TotalSupply * Config.DevShare, Cost = 0 }

	if isRug then
		-- Rug-Dev kauft am Anfang viel dazu, das er später auf einmal verkauft
		local share = rng:NextNumber(Npc.Rug.DevBuy[1], Npc.Rug.DevBuy[2])
		buy(creator, coin, share, share)
		rugPlans[coin.Id] = {
			CreatorKey = creator.Key,
			StartPrice = MarketService.Price(coin),
			MinGain = rng:NextNumber(Npc.Rug.MinGain[1], Npc.Rug.MinGain[2]),
		}
	end
end

local function checkRugs(t: number)
	local ids = {}
	for coinId in rugPlans do
		table.insert(ids, coinId)
	end
	for _, coinId in ids do
		local plan = rugPlans[coinId]
		local coin = MarketService.GetCoins()[coinId]
		local npc = npcs[plan.CreatorKey]
		if not coin or coin.Dead or not npc then
			rugPlans[coinId] = nil
			continue
		end
		local age = t - coin.CreatedAt
		local gain = MarketService.Price(coin) / plan.StartPrice
		if (age >= Npc.Rug.MinAge and gain >= plan.MinGain) or age >= Npc.Rug.MaxAge then
			rugPlans[coinId] = nil
			-- Ein Klick: alles auf einmal verkaufen, Kurs fällt auf der Kurve (Meldung macht MarketService)
			sell(npc, coin, 1, true)
		end
	end
end

------------------------------------------------------------------------
-- Takt (nur auf dem Host)
------------------------------------------------------------------------

local function act(npc, t: number)
	if not dumpOldCoin(npc, t) then
		STRATEGIES[npc.Kind](npc, t)
	end
end

local function refill(npc, seconds: number)
	if npc.Cash < Npc.StartCash then
		npc.Cash = math.min(Npc.StartCash, npc.Cash + Npc.RefillPerMinute * seconds / 60)
	elseif npc.Cash > Npc.MaxCash then
		npc.Cash = Npc.MaxCash -- Überschuss verschwindet (Geld-Senke)
	end
end

-- Einträge zu gelöschten Coins entfernen (sonst wächst der Speicher bei langen Servern)
local function cleanup(npc)
	local coins = MarketService.GetCoins()
	for _, list in { npc.Holdings, npc.BoughtAt, npc.SnipePlans } do
		for coinId in list do
			if not coins[coinId] then
				list[coinId] = nil
			end
		end
	end
end

local function safe(name: string, fn, ...)
	local ok, err = pcall(fn, ...)
	if not ok then
		warn("[NpcTrader] " .. name .. ": " .. tostring(err))
	end
end

function NpcTraderService.Init()
	local index = 0
	for _, kind in { "Sniper", "Momentum", "Panic", "Random" } do
		for _ = 1, Npc.Types[kind] or 0 do
			index += 1
			local npc = createNpc(index, kind)
			npcs[npc.Key] = npc
			table.insert(npcList, npc)
		end
	end
end

function NpcTraderService.Start()
	task.spawn(function()
		local wasHost = false
		local lastSave, lastMaintenance, lastCharts, lastFees, lastCleanup = 0, 0, 0, 0, 0
		while true do
			task.wait(Npc.TickInterval)
			if not WorldService.IsHost() then
				wasHost = false
				continue
			end
			local t = now()
			if not wasHost then
				-- gerade Host geworden: Zustand des alten Hosts übernehmen
				wasHost = true
				safe("load", loadState)
				print("[NpcTrader] this server is now the NPC host")
			end

			for _, npc in npcList do
				refill(npc, Npc.TickInterval)
				if rng:NextNumber() < Npc.ActChance then
					safe(npc.Name, act, npc, t)
				end
			end
			safe("rugs", checkRugs, t)

			-- genug gelistete Coins? (mind. StartCoins, neue alle 1–3 Min., Obergrenze wächst mit Spielern)
			local live = MarketService.LiveCoinCount()
			if live < WorldService.MaxLiveCoins() and (live < Npc.StartCoins or t >= nextCoinAt) then
				nextCoinAt = t + rng:NextNumber(Npc.CreateEvery[1], Npc.CreateEvery[2])
				safe("new coin", createNpcCoin)
			end

			if t - lastFees >= W.FeeFlushInterval then
				lastFees = t
				safe("fees", function()
					for key, amount in MarketService.DrainNpcFees() do
						local npc = npcs[key]
						if npc and type(amount) == "number" then
							npc.Cash = Ledger.FloorCents(npc.Cash + amount)
						end
					end
				end)
			end
			if t - lastMaintenance >= W.MaintenanceInterval then
				lastMaintenance = t
				safe("maintenance", MarketService.HostMaintenance)
			end
			if t - lastCharts >= W.ChartSaveInterval then
				lastCharts = t
				safe("charts", MarketService.SaveCharts)
			end
			if t - lastCleanup >= 60 then
				lastCleanup = t
				for _, npc in npcList do
					cleanup(npc)
				end
			end
			if t - lastSave >= W.NpcSaveInterval then
				lastSave = t
				safe("save", saveState)
			end
		end
	end)
	game:BindToClose(function()
		if WorldService.IsHost() then
			pcall(saveState)
		end
	end)
end

return NpcTraderService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX16">
				<Properties>
					<string name="Name">PlayerDataService</string>
					<ProtectedString name="Source"><![CDATA[-- PlayerDataService (ModuleScript) – ServerScriptService/Services/PlayerDataService
-- Spielstand jedes Spielers:
--  * Geldbörse (Cash, offener Trade, Liste gehaltener Coins) liegt im Weltmarkt-Speicher (MemoryStore),
--    solange der Spieler spielt. Nur EIN Server darf sie halten (Session-Lock mit Lebenszeichen).
--  * Dauerhaft gespeichert im DataStore: alle 60 Sek., beim Verlassen und beim Herunterfahren.
--  * Coins (Mengen) liegen in den Coins selbst (MarketService) – so gibt es sie nur einmal.
-- Laden: erst Weltmarkt (neuester Stand), sonst DataStore, sonst neuer Spieler mit Startgeld.

local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Config = require(ReplicatedStorage.Shared.Config)
local Levels = require(ReplicatedStorage.Shared.Levels)
local Remotes = require(ServerScriptService.Util.Remotes)
local RateLimiter = require(ServerScriptService.Util.RateLimiter)
local Store = require(ServerScriptService.Util.Store)
local Ledger = require(ServerScriptService.Util.Ledger)
local WorldService = require(ServerScriptService.Services.WorldService)

local W = Config.World

local PlayerDataService = {}

-- Werden von Main gesetzt (MarketService), damit es keine gegenseitigen requires gibt
PlayerDataService.RecoverPending = nil :: ((Player) -> boolean)?
PlayerDataService.WaitIdle = nil :: ((Player, number) -> ())?
PlayerDataService.ExtraState = nil :: ((Player) -> any)? -- zusätzliche Infos für den Client (CreatorService)
PlayerDataService.PassState = nil :: ((Player) -> any)? -- eigene Gamepässe (MonetizationService)
PlayerDataService.OnTrade = nil :: ((Player, any) -> ())? -- Trade-Verlauf (TradeLogService)

local walletsMap = Store.Map(W.WalletsMap, W.WalletExpiration)
local coinsMap = Store.Map(W.CoinsMap, W.CoinExpiration)
local profileStore = Store.Data(W.ProfileStore)
local inboxMap = Store.Map(W.InboxMap, W.CoinExpiration)

local profiles = {} -- [Player] = { Wallet, Holdings = { [coinId] = { Amount, Cost } }, Loaded, Dirty }
local stateEvent: RemoteEvent

local function now(): number
	return workspace:GetServerTimeNow()
end

local function isValidNumber(n: any): boolean
	return typeof(n) == "number" and n == n and n > -math.huge and n < math.huge
end

function PlayerDataService.Key(player: Player): string
	return tostring(player.UserId)
end

local function profileKey(player: Player): string
	return "u_" .. player.UserId
end

function PlayerDataService.GetPlayerByKey(key: string): Player?
	local userId = tonumber(key)
	return if userId then Players:GetPlayerByUserId(userId) else nil
end

-- Lokale Kopie der Geldbörse (nur lesen!). nil = noch nicht geladen.
function PlayerDataService.GetWallet(player: Player)
	local profile = profiles[player]
	return if profile and profile.Loaded then profile.Wallet else nil
end

-- Alle gehaltenen Coins (nur lesen!): { [coinId] = { Amount, Cost } }
function PlayerDataService.GetHoldings(player: Player)
	local profile = profiles[player]
	return if profile then profile.Holdings else {}
end

function PlayerDataService.GetHolding(player: Player, coinId: string)
	local profile = profiles[player]
	return profile and profile.Holdings[coinId]
end

-- Geldbörse atomar ändern (Ledger-Funktion). -> ok, ergebnis
function PlayerDataService.WalletUpdate(player: Player, fn, args)
	local profile = profiles[player]
	if not profile then
		return false, nil
	end
	local ok, result, newValue = walletsMap:Update(PlayerDataService.Key(player), fn, args)
	if ok and newValue then
		profile.Wallet = newValue
		profile.Dirty = true
	elseif ok and result and result.Already then
		-- ein anderer Schritt war schneller (z. B. Wiederholung): aktuellen Stand holen
		local okGet, value = walletsMap:Get(PlayerDataService.Key(player))
		if okGet and value then
			profile.Wallet = value
		end
	end
	return ok, result
end

function PlayerDataService.SetHolding(player: Player, coinId: string, amount: number, cost: number)
	local profile = profiles[player]
	if not profile then
		return
	end
	local old = profile.Holdings[coinId]
	profile.Holdings[coinId] = if amount > 0 then { Amount = amount, Cost = cost, SL = old and old.SL } else nil
end

-- Stop-Loss-Stufe in der lokalen Kopie merken (Wahrheit liegt im Coin)
function PlayerDataService.SetStopLossLocal(player: Player, coinId: string, level: number?)
	local holding = PlayerDataService.GetHolding(player, coinId)
	if holding then
		holding.SL = level
	end
end

-- Hinweis oben im Terminal (gleicher Weg wie Trade-Meldungen)
function PlayerDataService.Notify(player: Player, ok: boolean, message: string)
	Remotes.Event("TradeResult"):FireClient(player, { Ok = ok, Message = message })
end

-- Geld gutschreiben/abziehen (für spätere Phasen: Daily Reward usw.). Nie doppelt.
function PlayerDataService.AddCash(player: Player, delta: number): boolean
	if not isValidNumber(delta) or not PlayerDataService.GetWallet(player) then
		return false
	end
	local ok, result = PlayerDataService.WalletUpdate(player, Ledger.WalletAddCash, {
		Job = WorldService.JobId,
		Id = HttpService:GenerateGUID(false),
		Delta = delta,
	})
	if ok and result and result.Ok then
		PlayerDataService.PushState(player)
		return true
	end
	return false
end

-- Statistiken (XP, PNL, bester Trade). Tag/Woche zählen nur, wenn sie zum aktuellen Tag/zur Woche gehören.
function PlayerDataService.GetStats(player: Player)
	local wallet = PlayerDataService.GetWallet(player)
	local st = (wallet and wallet.St) or {}
	local day, week = Ledger.PeriodKeys(now())
	local xp = Levels.Xp(st)
	return {
		Xp = xp,
		Level = Levels.LevelForXp(xp),
		Pnl = st.Pnl or 0,
		Best = st.Best or 0,
		DayPnl = if st.DK == day then st.DPnl else 0,
		DayBest = if st.DK == day then st.DBest else 0,
		WeekPnl = if st.WK == week then st.WPnl else 0,
		WeekBest = if st.WK == week then st.WBest else 0,
		FeesEarned = st.FE or 0, -- verdiente Ersteller-Gebühren
	}
end

-- Alle geladenen Spieler (für Ranglisten)
function PlayerDataService.LoadedPlayers(): { Player }
	local list = {}
	for player, profile in profiles do
		if profile.Loaded then
			table.insert(list, player)
		end
	end
	return list
end

function PlayerDataService.BuildState(player: Player)
	local profile = profiles[player]
	if not profile or not profile.Loaded then
		return nil
	end
	-- Daily Reward: heute schon abgeholt? Welcher Tag ist als Nächstes dran?
	local st = profile.Wallet.St or {}
	local today = Ledger.PeriodKeys(now())
	local claimed = st.DD == today
	local nextStreak = if claimed or st.DD == today - 1 then (st.DS or 0) % #Config.Protection.Daily + 1 else 1
	return {
		Cash = profile.Wallet.Cash,
		Positions = profile.Holdings,
		Stats = PlayerDataService.GetStats(player),
		Insured = profile.Wallet.Ins or {},
		MyCoin = profile.Wallet.MyCoin,
		FreeBoosts = profile.Wallet.FB or 0,
		RugLicense = profile.Wallet.RL or 0, -- übrige Rugpulls
		RugReadyAt = (st.LR or 0) + Config.Rug.Cooldown, -- ab dann wieder (Server-Zeit)
		Vouchers = profile.Wallet.V or {}, -- Robux-Gutscheine (CT = Coin, HT = Highlight)
		Favorites = profile.Wallet.Fav or {}, -- Favoriten ⭐ (Liste von Coin-Ids)
		Passes = if PlayerDataService.PassState then PlayerDataService.PassState(player) else {}, -- Gamepässe
		Extra = if PlayerDataService.ExtraState then PlayerDataService.ExtraState(player) else nil, -- Creator-Infos
		Daily = {
			CanClaim = not claimed,
			Streak = if claimed then st.DS else nextStreak - 1, -- bereits geschaffte Tage in Folge
			Next = nextStreak, -- dieser Tag ist als Nächstes dran
		},
		Settings = {
			Tutorial = st.TU == 1, -- Pflicht-Tutorial erledigt
			Mute = st.MU == 1, -- Sounds aus
		},
	}
end

function PlayerDataService.PushState(player: Player)
	local state = PlayerDataService.BuildState(player)
	if state then
		stateEvent:FireClient(player, state)
	end
end

------------------------------------------------------------------------
-- Speichern
------------------------------------------------------------------------

-- Gutscheine { CT = n, HT = n }
local function cleanCounts(data)
	if type(data) ~= "table" then
		return nil
	end
	local result = {}
	for key, value in data do
		if type(key) == "string" and #key <= 4 and isValidNumber(value) and value >= 0 then
			result[key] = math.floor(value)
		end
	end
	return result
end

-- Kauf-Nummern (Liste von Texten)
local function cleanReceipts(data)
	if type(data) ~= "table" then
		return nil
	end
	local result = {}
	for _, id in data do
		if type(id) == "string" and #id <= 64 then
			table.insert(result, id)
		end
	end
	return result
end

-- Gespeichertes Profil prüfen (kaputte oder manipulierte Daten nie übernehmen)
local function cleanProfile(data)
	if type(data) ~= "table" or not isValidNumber(data.Cash) or data.Cash < 0 then
		return nil
	end
	local coins = {}
	if type(data.Coins) == "table" then
		for coinId, flag in data.Coins do
			if type(coinId) == "string" and flag == true then
				coins[coinId] = true
			end
		end
	end
	local stats = {}
	if type(data.St) == "table" then
		for key, value in data.St do
			-- Zahlen + kurze Texte (z. B. eingelöster Creator-Code St.RC – darf nie verloren gehen)
			if type(key) == "string" and (isValidNumber(value) or (type(value) == "string" and #value <= 20)) then
				stats[key] = value
			end
		end
	end
	return {
		Cash = Ledger.FloorCents(data.Cash),
		Seq = if isValidNumber(data.Seq) then data.Seq else 0,
		P = if type(data.P) == "table" then data.P else nil,
		Coins = coins,
		St = stats,
		Ins = if type(data.Ins) == "table" then data.Ins else nil,
		Cr = if type(data.Cr) == "table" and isValidNumber(data.Cr.Max) then { Max = data.Cr.Max } else nil,
		FB = if isValidNumber(data.FB) and data.FB >= 0 then math.floor(data.FB) else nil,
		FCM = if isValidNumber(data.FCM) then data.FCM else nil,
		MyCoin = if type(data.MyCoin) == "string" and #data.MyCoin <= 20 then data.MyCoin else nil,
		RL = if isValidNumber(data.RL) and data.RL >= 0 then math.floor(data.RL) else nil,
		V = cleanCounts(data.V), -- Robux-Gutscheine
		Rc = cleanReceipts(data.Rc), -- gemerkte Kauf-Nummern
		Fav = cleanReceipts(data.Fav), -- Favoriten (Liste von Coin-Ids)
	}
end

local function save(player: Player): boolean
	local profile = profiles[player]
	if not profile or not profile.Loaded then
		return false
	end
	local snapshot = Ledger.ProfileFromWallet(profile.Wallet)
	local ok = profileStore:Update(profileKey(player), function()
		return snapshot
	end)
	if ok then
		profile.Dirty = false
	end
	return ok
end

-- Postfach leeren (z. B. Auszahlung automatisch geschlossener Coins) und gutschreiben.
-- Erst leeren, dann gutschreiben: bei Absturz dazwischen verfällt der Betrag, er kommt nie doppelt.
local refreshHoldings -- unten definiert

local function drainInbox(player: Player)
	local ok, content = inboxMap:Update("u_" .. player.UserId, Ledger.InboxDrain, {})
	if not ok or type(content) ~= "table" then
		return
	end
	local cash = if isValidNumber(content.Cash) then math.max(0, content.Cash) else 0
	local profit = if isValidNumber(content.Profit) then content.Profit else nil
	if cash <= 0 and not profit then
		return
	end
	local okWallet, result = PlayerDataService.WalletUpdate(player, Ledger.WalletInbox, {
		Job = WorldService.JobId,
		Id = HttpService:GenerateGUID(false),
		Cash = Ledger.FloorCents(cash),
		Profit = profit,
		Fee = if isValidNumber(content.Fee) then content.Fee else nil,
		Now = now(),
	})
	if not (okWallet and result and result.Ok) then
		return
	end
	-- Hinweise, woher das Geld kommt
	if isValidNumber(content.Refund) and content.Refund > 0 then
		PlayerDataService.Notify(player, true, string.format("🛡 Rug refund: +%.2f Cash", content.Refund))
	end
	if isValidNumber(content.Code) and content.Code > 0 then
		PlayerDataService.Notify(player, true, string.format("🎬 Your creator code was used: +%.2f Cash", content.Code))
	end
	if isValidNumber(content.SL) and content.SL > 0 then
		PlayerDataService.Notify(player, true, string.format("🛑 Stop-loss sold while you were away: +%.2f Cash", content.SL))
		if PlayerDataService.OnTrade then
			PlayerDataService.OnTrade(player, { S = "SL", T = "", I = "🛑", M = content.SL, P = profit })
		end
		refreshHoldings(player)
	end
	PlayerDataService.PushState(player)
end

PlayerDataService.DrainInbox = drainInbox

------------------------------------------------------------------------
-- Laden
------------------------------------------------------------------------

local function load(player: Player)
	local profile = { Wallet = nil, Holdings = {}, Loaded = false, Dirty = false }
	profiles[player] = profile
	local key = PlayerDataService.Key(player)

	-- 1) Geldbörse übernehmen. Hält sie noch ein anderer Server (Spieler hat gerade gewechselt): warten.
	local claimed = false
	for _ = 1, 25 do
		if not player.Parent then
			return
		end
		local ok, result, value = walletsMap:Update(key, Ledger.WalletClaim, {
			Job = WorldService.JobId,
			Now = now(),
			Stale = W.WalletStale,
		})
		if ok and result and result.Ok then
			profile.Wallet = value
			claimed = true
			break
		elseif ok and result and result.Missing then
			-- 2) Nicht im Weltmarkt: aus dem DataStore laden (oder neuer Spieler)
			local okData, data = profileStore:Get(profileKey(player))
			if not okData then
				break -- DataStore nicht erreichbar: lieber nicht spielen als Fortschritt verlieren
			end
			local saved = cleanProfile(data)
				or { Cash = Config.StartCash, Seq = 0, Coins = {} }
			local okCreate, created, newValue = walletsMap:Update(key, Ledger.WalletCreate, {
				Job = WorldService.JobId,
				Now = now(),
				Profile = saved,
			})
			if okCreate and created and created.Ok then
				profile.Wallet = newValue
				claimed = true
				break
			end
			-- jemand war schneller: nochmal übernehmen
		end
		task.wait(2)
	end
	if not claimed then
		profiles[player] = nil
		if player.Parent then
			player:Kick("Your data is still saving on another server. Please rejoin in a moment.")
		end
		return
	end
	if not player.Parent then
		return -- schon wieder weg: Freigabe übernimmt onPlayerRemoving
	end
	profile.Loaded = true

	-- 3) Offenen Trade fertig buchen (z. B. nach Server-Absturz)
	if profile.Wallet.P and PlayerDataService.RecoverPending then
		PlayerDataService.RecoverPending(player)
	end

	-- 4) Mengen der gehaltenen Coins aus den Coins lesen
	local gone = {}
	for coinId in profile.Wallet.Coins do
		local ok, coin = coinsMap:Get(coinId)
		if ok then
			local holding = coin and coin.H[key]
			if holding then
				profile.Holdings[coinId] = { Amount = holding.A, Cost = holding.C, SL = coin.SL and coin.SL[key] }
			else
				table.insert(gone, coinId)
			end
		end
	end
	if #gone > 0 then
		PlayerDataService.WalletUpdate(player, Ledger.WalletForget, { Job = WorldService.JobId, Coins = gone })
	end
	drainInbox(player)
	PlayerDataService.PushState(player)
end

-- Mengen aller gehaltenen Coins neu lesen (z. B. nachdem der Host per Stop-Loss verkauft hat)
refreshHoldings = function(player: Player)
	local profile = profiles[player]
	if not profile or not profile.Loaded then
		return
	end
	local key = PlayerDataService.Key(player)
	for coinId in profile.Wallet.Coins do
		local ok, coin = coinsMap:Get(coinId)
		if ok then
			local holding = coin and coin.H[key]
			profile.Holdings[coinId] = if holding
				then { Amount = holding.A, Cost = holding.C, SL = coin.SL and coin.SL[key] }
				else nil
		end
	end
end

-- Spieler geht: Trades fertig, speichern, Geldbörse freigeben
local function unload(player: Player)
	local profile = profiles[player]
	if not profile then
		return
	end
	if PlayerDataService.WaitIdle then
		PlayerDataService.WaitIdle(player, 15)
	end
	if profile.Loaded then
		local saved = save(player)
		-- Gespeichert und kein offener Trade: Geldbörse läuft im Weltmarkt nach 10 Min. ab.
		-- Sonst bleibt sie 30 Tage, damit nichts verloren geht.
		local expiration = if saved and not profile.Wallet.P then W.WalletReleasedExpiration else W.WalletExpiration
		walletsMap:Update(PlayerDataService.Key(player), Ledger.WalletRelease, { Job = WorldService.JobId }, expiration)
	end
	profiles[player] = nil
end

------------------------------------------------------------------------

-- Einstellungen vom Client: nur Tutorial (einmal auf "fertig") und Sounds an/aus
local flagLimiter = RateLimiter.new(2, 1)
local function onSetFlag(player: Player, name: any, on: any)
	if not flagLimiter:Allow(player) or not PlayerDataService.GetWallet(player) then
		return
	end
	local key, value
	if name == "Tutorial" then
		key, value = "TU", 1 -- kann nur erledigt werden, nie zurück
	elseif name == "Mute" and typeof(on) == "boolean" then
		key, value = "MU", if on then 1 else 0
	else
		return
	end
	local ok = PlayerDataService.WalletUpdate(player, Ledger.WalletSetFlag, {
		Job = WorldService.JobId,
		Key = key,
		Value = value,
	})
	if ok then
		PlayerDataService.PushState(player)
	end
end

-- Favorit ⭐ an/aus (nur Anzeige)
local function onSetFavorite(player: Player, coinId: any, on: any)
	if not flagLimiter:Allow(player) or not PlayerDataService.GetWallet(player) then
		return
	end
	if typeof(coinId) ~= "string" or #coinId > 20 or typeof(on) ~= "boolean" then
		return
	end
	local ok = PlayerDataService.WalletUpdate(player, Ledger.WalletFavorite, {
		Job = WorldService.JobId,
		Coin = coinId,
		On = on,
	})
	if ok then
		PlayerDataService.PushState(player)
	end
end

function PlayerDataService.Init()
	stateEvent = Remotes.Event("PlayerState")
	Remotes.Event("SetFlag").OnServerEvent:Connect(onSetFlag)
	Remotes.Event("SetFavorite").OnServerEvent:Connect(onSetFavorite)
	Players.PlayerRemoving:Connect(function(player)
		flagLimiter:Remove(player)
	end)
	Players.PlayerAdded:Connect(load)
	Players.PlayerRemoving:Connect(unload)
	for _, player in Players:GetPlayers() do
		task.spawn(load, player)
	end

	-- Endlos-Takt mit Fehlerschutz: ein Fehler stoppt nie die Schleife (sonst z. B. kein Lebenszeichen mehr)
	local function loop(name: string, interval: number, fn: () -> ())
		task.spawn(function()
			while true do
				task.wait(interval)
				local ok, err = pcall(fn)
				if not ok then
					warn("[PlayerData] " .. name .. ": " .. tostring(err))
				end
			end
		end)
	end

	-- Lebenszeichen: zeigt allen Servern, dass dieser Server die Geldbörse noch hält
	loop("heartbeat", W.HeartbeatInterval, function()
		-- Kopie der Liste: während der Speicherzugriffe kommen/gehen Spieler
		local list = {}
		for player, profile in profiles do
			table.insert(list, { player, profile })
		end
		for _, entry in list do
			local player, profile = entry[1], entry[2]
			if profile.Loaded and profiles[player] == profile then
				local ok, result = PlayerDataService.WalletUpdate(player, Ledger.WalletHeartbeat, {
					Job = WorldService.JobId,
					Now = now(),
					Add = W.HeartbeatInterval, -- Spielzeit mitzählen
				})
				if ok and result and result.Lost and player.Parent then
					-- Geldbörse gehört inzwischen einem anderen Server: sicherheitshalber raus
					profiles[player] = nil
					player:Kick("Your session moved to another server. Please rejoin.")
				end
			end
		end
	end)

	-- Postfach der Spieler regelmäßig prüfen
	loop("inbox", W.InboxInterval, function()
		for _, player in Players:GetPlayers() do
			local profile = profiles[player]
			if profile and profile.Loaded then
				task.spawn(drainInbox, player)
			end
		end
	end)

	-- Automatisch speichern
	loop("autosave", W.AutosaveInterval, function()
		for player, profile in profiles do
			if profile.Loaded and profile.Dirty then
				task.spawn(save, player)
			end
		end
	end)

	-- Server fährt herunter: alle speichern und freigeben (Roblox wartet max. 30 Sek.)
	game:BindToClose(function()
		local remaining = 0
		for _, player in Players:GetPlayers() do
			remaining += 1
			task.spawn(function()
				unload(player)
				remaining -= 1
			end)
		end
		local started = os.clock()
		while remaining > 0 and os.clock() - started < 25 do
			task.wait(0.2)
		end
	end)
end

return PlayerDataService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX17">
				<Properties>
					<string name="Name">ProtectionService</string>
					<ProtectedString name="Source"><![CDATA[-- ProtectionService (ModuleScript) – ServerScriptService/Services/ProtectionService
-- Schutz vor Bankrott (Phase 5):
--  * Mindestgeld: Vermögen unter 100 -> alle 10 Min. 250 Cash (Zeit in der Geldbörse: Rejoin hilft nicht)
--  * Daily Reward: Tag 1..7 (500 bis 5.000), Lücke -> Tag 1
--  * Stop-Loss (ab Level 3): online verkauft der eigene Server sofort,
--    offline verkauft der Host (wenn der Stop seit 15 Sek. erreicht ist), Cash ins Postfach
--  * Rug-Versicherung (ab Level 5, Schalter pro Coin) + Anfänger-Erstattung (unter Level 5):
--    nach einem Rugpull aus den Töpfen bezahlt, ins Postfach der Spieler
-- Alle Geldbuchungen laufen über den Ledger: nie doppelt.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ServerScriptService.Util.Remotes)
local RateLimiter = require(ServerScriptService.Util.RateLimiter)
local Store = require(ServerScriptService.Util.Store)
local Ledger = require(ServerScriptService.Util.Ledger)
local WorldService = require(ServerScriptService.Services.WorldService)
local PlayerDataService = require(ServerScriptService.Services.PlayerDataService)
local MarketService = require(ServerScriptService.Services.MarketService)
local LeaderboardService = require(ServerScriptService.Services.LeaderboardService)

local P = Config.Protection
local W = Config.World

local ProtectionService = {}
ProtectionService.HasPass = nil :: ((Player, string) -> boolean)? -- vom MonetizationService (Doppelter Daily)

local marketMap = Store.Map(W.MarketMap, W.Expiration)
local inboxMap = Store.Map(W.InboxMap, W.CoinExpiration)
local limiter = RateLimiter.new(3)
local pendingStops = {} -- [player] = { [coinId] = true }: Stop-Loss-Verkauf läuft schon
local hitSince = {} -- Host: ["coinId|key"] = Zeit, seit der Stop erreicht ist

local function now(): number
	return workspace:GetServerTimeNow()
end

local function level(player: Player): number
	return PlayerDataService.GetStats(player).Level
end

------------------------------------------------------------------------
-- Anfragen vom Client
------------------------------------------------------------------------

local function onClaimDaily(player: Player)
	if not limiter:Allow(player) or not PlayerDataService.GetWallet(player) then
		return
	end
	local day = Ledger.PeriodKeys(now())
	local ok, result = PlayerDataService.WalletUpdate(player, Ledger.WalletDaily, {
		Job = WorldService.JobId,
		Day = day,
		Multiplier = if ProtectionService.HasPass and ProtectionService.HasPass(player, "DoubleDaily") then 2 else 1,
	})
	if ok and result and result.Ok then
		PlayerDataService.Notify(
			player,
			true,
			string.format("🎁 Day %d reward: +%s Cash", result.Streak, tostring(result.Amount))
		)
	else
		PlayerDataService.Notify(player, false, (result and result.Error) or "Please try again")
	end
	PlayerDataService.PushState(player)
end

-- index: 0 = aus, 1..4 = Config.Protection.StopLossLevels
local function onSetStopLoss(player: Player, coinId: any, index: any)
	if not limiter:Allow(player) or not PlayerDataService.GetWallet(player) then
		return
	end
	if typeof(coinId) ~= "string" or #coinId > 20 or typeof(index) ~= "number" then
		return
	end
	index = math.floor(index)
	if index < 0 or index > #P.StopLossLevels then
		return
	end
	if level(player) < P.StopLossMinLevel then
		PlayerDataService.Notify(player, false, "Stop-loss unlocks at level " .. P.StopLossMinLevel)
		return
	end
	if not PlayerDataService.GetHolding(player, coinId) then
		PlayerDataService.Notify(player, false, "You don't own this coin")
		return
	end
	local value = if index == 0 then nil else P.StopLossLevels[index]
	local ok, err = MarketService.SetStopLoss(player, coinId, value)
	if ok then
		PlayerDataService.SetStopLossLocal(player, coinId, value)
		PlayerDataService.Notify(
			player,
			true,
			if value then string.format("🛑 Stop-loss set: sells all at -%d%%", math.floor(value * 100 + 0.5)) else "Stop-loss off"
		)
	else
		PlayerDataService.Notify(player, false, err or "Please try again")
	end
	PlayerDataService.PushState(player)
end

local function onSetInsurance(player: Player, coinId: any, on: any)
	if not limiter:Allow(player) or not PlayerDataService.GetWallet(player) then
		return
	end
	if typeof(coinId) ~= "string" or #coinId > 20 or typeof(on) ~= "boolean" then
		return
	end
	if level(player) < P.InsuranceMinLevel then
		PlayerDataService.Notify(player, false, "Rug insurance unlocks at level " .. P.InsuranceMinLevel)
		return
	end
	local ok = PlayerDataService.WalletUpdate(player, Ledger.WalletSetInsure, {
		Job = WorldService.JobId,
		Coin = coinId,
		On = on,
	})
	if ok then
		PlayerDataService.Notify(
			player,
			true,
			if on
				then string.format(
					"🛡 Insurance ON: +%d%% on buys, %d%% back if rugged",
					math.floor(P.InsurancePremium * 100 + 0.5),
					math.floor(P.InsurancePayout * 100 + 0.5)
				)
				else "🛡 Insurance off"
		)
	end
	PlayerDataService.PushState(player)
end

------------------------------------------------------------------------
-- Mindestgeld
------------------------------------------------------------------------

local function stipendTick()
	for _, player in PlayerDataService.LoadedPlayers() do
		if LeaderboardService.Wealth(player) < P.StipendBelow then
			local ok, result = PlayerDataService.WalletUpdate(player, Ledger.WalletStipend, {
				Job = WorldService.JobId,
				Now = now(),
				Amount = P.StipendAmount,
				Interval = P.StipendInterval,
			})
			if ok and result and result.Ok then
				PlayerDataService.Notify(player, true, string.format("💸 Starter help: +%d Cash", P.StipendAmount))
				PlayerDataService.PushState(player)
			end
		end
	end
end

------------------------------------------------------------------------
-- Stop-Loss
------------------------------------------------------------------------

-- Online: eigener Server prüft jede Sekunde die Positionen seiner Spieler
local function onlineStopTick()
	local coins = MarketService.GetCoins()
	for _, player in PlayerDataService.LoadedPlayers() do
		for coinId, holding in PlayerDataService.GetHoldings(player) do
			local coin = coins[coinId]
			if holding.SL and coin and holding.Cost > 0 then
				local value = MarketService.PositionValue(coin, holding.Amount)
				local pending = pendingStops[player] or {}
				pendingStops[player] = pending
				if value <= holding.Cost * (1 - holding.SL) and not pending[coinId] then
					pending[coinId] = true
					local queued = MarketService.QueueSell(player, coinId, "🛑 Stop-loss: ")
					if queued then
						task.delay(5, function()
							pending[coinId] = nil
						end)
					else
						pending[coinId] = nil
					end
				end
			end
		end
	end
end

-- Offline: Host prüft Coins mit Stop-Loss-Aufträgen und verkauft, wenn der Stop seit 15 Sek. erreicht ist
-- (online-Spieler verkauft ihr eigener Server schon nach ca. 1 Sek.)
local function hostStopTick()
	if not WorldService.IsHost() then
		hitSince = {}
		return
	end
	local ids = {}
	for id, coin in MarketService.GetCoins() do
		if (coin.StopLossCount or 0) > 0 then
			table.insert(ids, id)
		end
	end
	local t = now()
	local stillHit = {}
	for _, coinId in ids do
		local value = MarketService.ReadCoin(coinId)
		if value and value.SL then
			for key in value.SL do
				if Ledger.StopLossHit(value, key) then
					local id = coinId .. "|" .. key
					stillHit[id] = hitSince[id] or t
					if t - stillHit[id] >= P.StopLossOfflineDelay then
						stillHit[id] = nil
						local result = MarketService.StopLossExec(coinId, key)
						if result then
							-- ohne Wiederholung: im Zweifel nichts, aber nie doppelt
							inboxMap:UpdateOnce("u_" .. key, Ledger.InboxAdd, {
								Adds = { Cash = result.Cash, Profit = result.Profit, SL = result.Cash },
							})
						end
					end
				end
			end
		end
	end
	hitSince = stillHit
end

------------------------------------------------------------------------
-- Rug: Versicherung + Anfänger-Erstattung
------------------------------------------------------------------------

local function onRug(_coin, result)
	local comp = result.Comp or {}
	-- Spieler-Rug: Anteil schon im Ledger abgezogen (result.Pot); NPC-Rug: 30 % vom Erlös
	local share = result.Pot or (result.Cash or 0) * P.RugPotShare
	if next(comp) == nil and share <= 0 then
		return
	end
	local day = Ledger.PeriodKeys(now())
	-- ohne Wiederholung: Töpfe werden nie doppelt belastet
	local ok, payouts = marketMap:UpdateOnce("Pots", Ledger.PotsPay, {
		Comp = comp,
		AddRef = share,
		Day = day,
		TopUp = P.DailyTopUp,
	})
	if not ok or type(payouts) ~= "table" then
		return
	end
	for key, amount in payouts do
		inboxMap:UpdateOnce("u_" .. key, Ledger.InboxAdd, { Adds = { Cash = amount, Refund = amount } })
		local player = PlayerDataService.GetPlayerByKey(key)
		if player then
			task.delay(1, function()
				-- online auf diesem Server: Postfach gleich leeren (sonst spätestens nach 1 Min.)
				PlayerDataService.DrainInbox(player)
			end)
		end
	end
end

------------------------------------------------------------------------

local function loop(name: string, interval: number, fn: () -> ())
	task.spawn(function()
		while true do
			task.wait(interval)
			local ok, err = pcall(fn)
			if not ok then
				warn("[Protection] " .. name .. ": " .. tostring(err))
			end
		end
	end)
end

function ProtectionService.Init()
	Remotes.Event("ClaimDaily").OnServerEvent:Connect(onClaimDaily)
	Remotes.Event("SetStopLoss").OnServerEvent:Connect(onSetStopLoss)
	Remotes.Event("SetInsurance").OnServerEvent:Connect(onSetInsurance)
	MarketService.RugHandler = onRug
	Players.PlayerRemoving:Connect(function(player)
		limiter:Remove(player)
		pendingStops[player] = nil
	end)
end

function ProtectionService.Start()
	loop("stipend", 30, stipendTick)
	loop("stop-loss", 1, onlineStopTick)
	loop("host stop-loss", P.StopLossHostInterval, hostStopTick)
end

return ProtectionService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX18">
				<Properties>
					<string name="Name">TradeLogService</string>
					<ProtectedString name="Source"><![CDATA[-- TradeLogService (ModuleScript) – ServerScriptService/Services/TradeLogService
-- Trade-Verlauf pro Spieler (nur Anzeige, kein Geld): die letzten 500 Trades mit Gewinn/Verlust.
-- Eigener DataStore "MoR_TradeLog_v1", damit die Geldbörse klein bleibt (32-KB-Grenze im Weltmarkt).
-- Neue Einträge werden gesammelt und jede Minute (und beim Verlassen) ANGEHÄNGT, nie überschrieben:
-- so gehen beim Server-Wechsel keine Einträge verloren. Im Zweifel fehlt mal ein Eintrag (Absturz),
-- am Geld ändert das nichts.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ServerScriptService.Util.Remotes)
local RateLimiter = require(ServerScriptService.Util.RateLimiter)
local Store = require(ServerScriptService.Util.Store)

local KEEP = Config.Market.TradeLogKeep
local FLUSH_INTERVAL = 60

local TradeLogService = {}

local logStore = Store.Data("MoR_TradeLog_v1")
local logs = {} -- [player] = { Loaded, List = gesamt (für die Anzeige), Unsaved = noch nicht gespeichert }
local limiter = RateLimiter.new(1, 2)

local function key(player: Player): string
	return "u_" .. player.UserId
end

local function trim(list)
	while #list > KEEP do
		table.remove(list, 1)
	end
end

-- Eintrag hinzufügen. entry = { C = coinId, T = Ticker, I = Icon, S = "Buy"/"Sell"/"Rug"/"Dev"/"SL", M = Cash, P = Gewinn? }
function TradeLogService.Add(player: Player, entry)
	local log = logs[player]
	if not log then
		return
	end
	entry.At = math.floor(workspace:GetServerTimeNow())
	table.insert(log.List, entry)
	trim(log.List)
	table.insert(log.Unsaved, entry)
end

local function flush(player: Player)
	local log = logs[player]
	if not log or #log.Unsaved == 0 then -- nur Anhängen: geht auch, wenn das Laden noch fehlt
		return
	end
	local batch = log.Unsaved
	log.Unsaved = {}
	local ok = logStore:Update(key(player), function(old)
		local list = if type(old) == "table" then old else {}
		for _, entry in batch do
			table.insert(list, entry)
		end
		trim(list)
		return list
	end)
	if not ok then
		-- nicht gespeichert: beim nächsten Mal nochmal (vorne einreihen)
		for i = #batch, 1, -1 do
			table.insert(log.Unsaved, 1, batch[i])
		end
	end
end

local function load(player: Player)
	local log = { Loaded = false, List = {}, Unsaved = {} }
	logs[player] = log
	local ok, stored = logStore:Get(key(player))
	if logs[player] ~= log then
		return
	end
	local list = if ok and type(stored) == "table" then stored else {}
	-- schon während des Ladens hinzugekommene Einträge hinten anhängen
	for _, entry in log.List do
		table.insert(list, entry)
	end
	trim(list)
	log.List = list
	log.Loaded = ok
	if not ok then -- Laden fehlgeschlagen: in 30 Sek. nochmal (nur für die Anzeige)
		task.delay(30, function()
			if logs[player] == log and player.Parent then
				local okRetry, storedRetry = logStore:Get(key(player))
				if okRetry then
					local merged = if type(storedRetry) == "table" then storedRetry else {}
					for _, entry in log.Unsaved do
						table.insert(merged, entry)
					end
					trim(merged)
					log.List = merged
					log.Loaded = true
				end
			end
		end)
	end
end

-- Client fragt seinen Verlauf ab (nur den eigenen)
local function onGet(player: Player)
	if not limiter:Allow(player) then
		return nil
	end
	local log = logs[player]
	return if log then log.List else nil
end

function TradeLogService.Init()
	Remotes.Function("TradeLog").OnServerInvoke = onGet
	Players.PlayerAdded:Connect(load)
	for _, player in Players:GetPlayers() do
		task.spawn(load, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		limiter:Remove(player)
		pcall(flush, player)
		logs[player] = nil
	end)
	task.spawn(function()
		while true do
			task.wait(FLUSH_INTERVAL)
			for _, player in Players:GetPlayers() do
				local ok, err = pcall(flush, player)
				if not ok then
					warn("[TradeLog] flush: " .. tostring(err))
				end
			end
		end
	end)
	game:BindToClose(function()
		for _, player in Players:GetPlayers() do
			task.spawn(pcall, flush, player)
		end
		task.wait(3)
	end)
end

return TradeLogService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX19">
				<Properties>
					<string name="Name">WorldService</string>
					<ProtectedString name="Source"><![CDATA[-- WorldService (ModuleScript) – ServerScriptService/Services/WorldService
-- Weltmarkt-Verwaltung über alle Server:
--  * jeder Server meldet sich alle 10 Sek. (Spielerzahl)
--  * genau EIN Server ist "Host": nur er lässt NPCs handeln, erstellt NPC-Coins und räumt auf.
--    Fällt er aus, übernimmt nach max. 30 Sek. automatisch ein anderer.
--  * Spieler weltweit -> wie viele Coins gleichzeitig gelistet sein dürfen

local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Config = require(ReplicatedStorage.Shared.Config)
local Store = require(ServerScriptService.Util.Store)
local Ledger = require(ServerScriptService.Util.Ledger)

local W = Config.World

local WorldService = {}

-- Eindeutige Server-Kennung (in Studio ist JobId leer)
WorldService.JobId = if game.JobId ~= "" then game.JobId else HttpService:GenerateGUID(false)

local market = Store.Map(W.MarketMap, W.Expiration)
local isHost = false
local totalPlayers = 1
local serverCount = 1

local function now(): number
	return workspace:GetServerTimeNow()
end

local function tick(release: boolean?)
	local ok, result = market:Update("World", Ledger.WorldTick, {
		Job = WorldService.JobId,
		Players = #Players:GetPlayers(),
		Now = now(),
		Lease = W.HostLease,
		Stale = W.ServerStale,
		Release = release,
	})
	if ok and result then
		isHost = result.IsHost
		totalPlayers = math.max(1, result.Players)
		serverCount = math.max(1, result.Servers or 1)
	elseif not ok then
		-- Speicher nicht erreichbar: lieber nicht Host sein (sonst könnten zwei Hosts gleichzeitig laufen)
		isHost = false
	end
end

function WorldService.IsHost(): boolean
	return isHost
end

function WorldService.TotalPlayers(): number
	return totalPlayers
end

-- Abstand zwischen zwei Abfragen von "requests" Schlüsseln, so dass dieser Server
-- höchstens SyncBudgetShare seines Anteils am Roblox-Budget (1000 + 120 pro Spieler pro Min.) nutzt.
function WorldService.SyncInterval(requests: number): number
	local players = math.max(1, #Players:GetPlayers())
	local budget = (1000 / serverCount + 120 * players) * W.SyncBudgetShare -- pro Minute
	local interval = requests * 60 / budget
	return math.clamp(interval, W.MinSyncInterval, W.MaxSyncInterval)
end

-- Wie viele Coins weltweit gelistet sein dürfen (wächst mit der Spielerzahl)
function WorldService.MaxLiveCoins(): number
	local count = W.CoinsBase + math.floor(totalPlayers * W.CoinsPerPlayer)
	return math.clamp(count, W.CoinsBase, W.CoinsMax)
end

function WorldService.Start()
	tick()
	task.spawn(function()
		while true do
			task.wait(W.TickInterval)
			local ok, err = pcall(tick)
			if not ok then
				isHost = false -- im Zweifel nicht Host (nie zwei Hosts gleichzeitig)
				warn("[World] tick: " .. tostring(err))
			end
		end
	end)
	game:BindToClose(function()
		tick(true) -- Host-Rolle sofort freigeben
	end)
end

return WorldService
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
		<Item class="Folder" referent="RBX26">
			<Properties><string name="Name">Util</string></Properties>
			<Item class="ModuleScript" referent="RBX21">
				<Properties>
					<string name="Name">Ledger</string>
					<ProtectedString name="Source"><![CDATA[-- Ledger (ModuleScript) – ServerScriptService/Util/Ledger
-- Reine Buchungs-Funktionen für den Weltmarkt (keine Roblox-APIs, keine Wartezeiten).
-- Jede Funktion bekommt den alten Wert eines Speicher-Schlüssels und gibt zurück:
--   neuerWert (oder nil = nichts schreiben), ergebnis
-- Sie werden in MemoryStore:UpdateAsync benutzt. Dort können sie mehrfach laufen,
-- deshalb dürfen sie NUR den übergebenen Wert verändern und sonst nichts.
--
-- Duplikat-Schutz bei Spieler-Trades (3 Schritte):
--   1. WalletBegin:  Geldbörse merkt sich den Trade (P) mit fortlaufender Nummer, Kauf-Geld wird reserviert
--   2. CoinTrade:    Coin bucht den Trade genau EINMAL (Q[Spieler].S = letzte gebuchte Nummer)
--   3. WalletFinish: Geldbörse schließt den Trade ab (Auszahlung oder Erstattung), genau EINMAL (P.S)
-- Bricht etwas zwischen den Schritten ab, werden 2 und 3 später einfach wiederholt.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Curve = require(ReplicatedStorage.Shared.BondingCurve)

local C = Config.Curve
local P = Config.Protection
local R = Config.Rug
local FEE_TOTAL = Config.Fees.Creator + Config.Fees.Burn
local DUST = 1e-9
local MAX_TRADES = 5 -- letzte Trades pro Coin (für Live-Trades auf allen Servern)

local Ledger = {}

local function floorCents(n: number): number
	return math.floor(n * 100 + 1e-6) / 100
end
Ledger.FloorCents = floorCents

------------------------------------------------------------------------
-- Coins
------------------------------------------------------------------------

-- Neuer Coin. info = { Id, Name, Ticker, Icon, Desc, CreatorKey?, CreatorName }
function Ledger.NewCoin(info, now: number)
	local devAmount = C.TotalSupply * Config.DevShare
	local coin = {
		V = 1, -- Version, steigt bei jeder Änderung
		Id = info.Id,
		Name = info.Name,
		Ticker = info.Ticker,
		Icon = info.Icon,
		Desc = info.Desc or "",
		CK = info.CreatorKey, -- Ersteller-Schlüssel (Spieler-UserId oder "npc:3")
		CN = info.CreatorName or "System",
		At = now, -- erstellt
		LT = now, -- letzter Trade
		Sup = devAmount, -- Dev-Anteil zählt als schon verkauft
		Mig = false,
		Dead = false,
		Rug = false,
		Vol = 0,
		H = {}, -- Holder: [Schlüssel] = { A = Menge, C = Kosten }
		E = {}, -- Früh-Käufer: [Schlüssel] = true
		Q = {}, -- Duplikat-Schutz: [Spieler] = { S = letzte Nummer, R = Ergebnis }
		SL = {}, -- Stop-Loss-Aufträge: [Spieler] = 0.1 / 0.2 / 0.3 / 0.5
		T = {}, -- letzte Trades
	}
	if info.CreatorKey then
		coin.H[info.CreatorKey] = { A = devAmount, C = 0 }
	end
	return coin
end

local function fail(message: string, holding)
	return { Ok = false, Error = message, Amount = if holding then holding.A else 0, Cost = if holding then holding.C else 0 }
end

local function addTrade(coin, side: string, a, tokens: number, cash: number)
	table.insert(coin.T, {
		I = coin.V + 1, -- eindeutig pro Coin (= neue Version)
		S = side,
		N = a.Name,
		B = a.IsNpc == true,
		U = if a.IsNpc then nil else a.Key, -- Spieler (für Creator-Abzeichen)
		P = if a.Vip then true else nil, -- VIP-Gamepass (⭐)
		G = if (a.Level or 0) >= Config.Prestige.LegendLevel then true else nil, -- Legend (👑)
		K = tokens,
		M = cash,
		At = a.Now,
	})
	while #coin.T > MAX_TRADES do
		table.remove(coin.T, 1)
	end
end

local function buy(coin, a)
	local holding = coin.H[a.Key]
	if coin.Dead then
		return fail("This coin is dead", holding)
	end
	if not holding then
		local count = 0
		for _ in coin.H do
			count += 1
		end
		if count >= Config.World.MaxHoldersPerCoin then
			return fail("Too many holders right now – try again later", nil)
		end
	end
	local cash = floorCents(a.Cash)
	if cash < Config.Trade.MinCash then
		return fail("Amount too small", holding)
	end
	local tokens = Curve.TokensForCash(C, coin.Sup, cash * (1 - FEE_TOTAL))
	if tokens <= DUST then
		return fail("Amount too small", holding)
	end
	coin.Sup += tokens
	if a.Now - coin.At <= Config.Indicators.EarlyWindow and a.Key ~= coin.CK then
		coin.E[a.Key] = true
	end
	local amount = (if holding then holding.A else 0) + tokens
	local cost = (if holding then holding.C else 0) + cash
	local insured = (if holding then holding.I or 0 else 0) + (if a.Insure then cash else 0)
	coin.H[a.Key] = {
		A = amount,
		C = cost,
		I = if insured > 0 then insured else nil, -- versicherter Einsatz
		T = math.floor(a.Now), -- letzter Kauf (für die 60-Sek.-Regel), ganze Sekunden sparen Platz
		L = a.Level, -- Level beim Kauf (Anfänger-Erstattung)
		DS = if holding then holding.DS else nil, -- letzter Ersteller-Verkauf (bleibt beim Nachkaufen)
	}
	coin.Vol += cash
	coin.LT = a.Now
	addTrade(coin, "Buy", a, tokens, cash)
	if not coin.Mig and Curve.MarketCap(C, coin.Sup) >= C.MigrationMarketCap then
		coin.Mig = true
	end
	return {
		Ok = true,
		Tokens = tokens,
		Cash = cash,
		Amount = amount,
		Cost = cost,
		Profit = 0,
		Fee = cash * Config.Fees.Creator,
		CreatorKey = coin.CK,
	}
end

local function sell(coin, a)
	local holding = coin.H[a.Key]
	if not holding then
		return fail("You don't own this coin", nil)
	end
	local frac = a.Frac
	local tokens = if frac >= 1 then holding.A else holding.A * frac
	-- Ersteller (Spieler) im eigenen Coin: Rugpull = alles auf einmal, sonst nur stufenweise
	local isDev = a.Key == coin.CK and not a.IsNpc
	local limited = false
	if a.Rug and not a.IsNpc then
		if not isDev then
			return fail("Only the creator can rug pull", holding)
		end
		if coin.Rug or coin.Dead then
			return fail("This coin can't be rugged anymore", holding)
		end
		if a.Now - coin.At < R.MinCoinAge then
			return fail(string.format("Rug pull: coin must be %d min old", math.floor(R.MinCoinAge / 60)), holding)
		end
		tokens = holding.A
	elseif isDev then
		local waitLeft = R.DevSellCooldown - (a.Now - (holding.DS or 0))
		if waitLeft > 0 then
			return fail(string.format("Creators sell step by step – next sell in %ds", math.ceil(waitLeft)), holding)
		end
		-- max. 25 % pro Verkauf (mind. 25 % des Dev-Anteils, damit es nicht ewig dauert)
		local cap = math.max(holding.A, C.TotalSupply * Config.DevShare) * R.DevSellMax
		if tokens > cap + DUST then
			tokens, limited = cap, true
		end
	end
	tokens = math.min(tokens, holding.A, coin.Sup)
	if tokens <= DUST then
		return fail("Amount too small", holding)
	end
	local gross = Curve.CashForTokens(C, coin.Sup, tokens)
	local payout = floorCents(gross * (1 - FEE_TOTAL))
	if payout <= 0 then
		return fail("Amount too small", holding)
	end
	local costPart = holding.C * (tokens / holding.A)
	local rest = holding.A - tokens
	local restCost = holding.C - costPart
	if rest <= DUST then
		coin.H[a.Key] = nil
		if coin.SL then
			coin.SL[a.Key] = nil
		end
		rest, restCost = 0, 0
	else
		coin.H[a.Key] = {
			A = rest,
			C = math.max(0, restCost),
			I = if holding.I then holding.I * (rest / holding.A) else nil,
			T = holding.T,
			L = holding.L,
			DS = if isDev then math.floor(a.Now) else holding.DS,
		}
	end
	coin.Sup = math.max(0, coin.Sup - tokens)
	coin.Vol += payout
	coin.LT = a.Now
	addTrade(coin, "Sell", a, tokens, payout)
	local comp, pot = nil, nil
	if a.Rug then
		coin.Rug = true -- Rugpull im selben Schritt wie der Verkauf
		comp = Ledger.RugCompensation(coin, a.Now)
		if not a.IsNpc then
			-- Spieler: 30 % des Erlöses in den Erstattungstopf (NPCs ziehen es selbst ab)
			pot = floorCents(payout * P.RugPotShare)
			payout -= pot
		end
	end
	return {
		Comp = comp,
		Pot = pot,
		Limited = limited or nil,
		Ok = true,
		Tokens = tokens,
		Cash = payout,
		Amount = rest,
		Cost = math.max(0, restCost),
		Profit = payout - costPart,
		Fee = gross * Config.Fees.Creator,
		CreatorKey = coin.CK,
	}
end

-- Erstattungen nach einem Rugpull (Wert jetzt, nach dem Crash) -> { [Spieler] = { Ins = x } oder { Beg = x } }
-- Versicherung: 60 % des versicherten Verlusts. Anfänger (Level < 5): 50 % des Verlusts. Der höhere zählt.
-- Nur wenn der letzte Kauf mind. 60 Sek. vor dem Rug war. NPCs bekommen nichts.
function Ledger.RugCompensation(coin, now: number)
	local comp = {}
	for key, h in coin.H do
		if string.sub(key, 1, 4) ~= "npc:" and h.C > 0 and now - (h.T or 0) >= P.MinHoldSeconds then
			local value = Curve.CashForTokens(C, coin.Sup, h.A) * (1 - FEE_TOTAL)
			local loss = math.max(0, h.C - value)
			local ins = if (h.I or 0) > 0 then loss * math.min(1, h.I / h.C) * P.InsurancePayout else 0
			local beg = if (h.L or 99) < P.BeginnerBelowLevel then loss * P.BeginnerPayout else 0
			ins, beg = floorCents(ins), floorCents(beg)
			if ins > 0 and ins >= beg then
				comp[key] = { Ins = ins }
			elseif beg > 0 then
				comp[key] = { Beg = beg }
			end
		end
	end
	return comp
end

-- Ältere volle Belege auf ihre Nummer verkleinern (Speicher-Grenze 32 KB).
-- Die Nummer reicht, damit nie doppelt gebucht wird.
local function compactReceipts(coin)
	local full = {}
	for key, entry in coin.Q do
		if type(entry) == "table" then
			table.insert(full, key)
		end
	end
	local limit = Config.World.FullReceipts
	if #full <= limit then
		return
	end
	table.sort(full, function(x, y)
		return coin.Q[x].At < coin.Q[y].At
	end)
	for i = 1, #full - limit do
		coin.Q[full[i]] = coin.Q[full[i]].S
	end
end

-- Kurzer Beleg (nur was für eine Wiederholung gebraucht wird)
local function receipt(result)
	return {
		Ok = result.Ok,
		Error = result.Error,
		Tokens = result.Tokens,
		Cash = result.Cash,
		Amount = result.Amount,
		Cost = result.Cost,
	}
end

-- Trade im Coin buchen.
-- a = { Key, Name, IsNpc, Seq (nur Spieler), Side "Buy"/"Sell", Cash (Kauf), Frac (Verkauf), Rug?, Now }
function Ledger.CoinTrade(coin, a)
	if not coin then
		return nil, fail("Coin not found", nil)
	end
	if a.Seq then
		local done = coin.Q[a.Key]
		local doneSeq = if type(done) == "number" then done elseif done then done.S else nil
		if doneSeq and doneSeq >= a.Seq then
			-- schon gebucht: nichts ändern, altes Ergebnis zurückgeben
			if type(done) == "table" then
				return nil, done.R
			end
			-- nur noch die Nummer bekannt: als erledigt behandeln (lieber 0 auszahlen als doppelt)
			local holding = coin.H[a.Key]
			return nil, {
				Ok = true,
				Unknown = true,
				Tokens = 0,
				Cash = 0,
				Amount = if holding then holding.A else 0,
				Cost = if holding then holding.C else 0,
			}
		end
	end
	local result = if a.Side == "Buy" then buy(coin, a) else sell(coin, a)
	if a.Seq then
		-- auch Fehlschläge merken (Wiederholung = gleiches Ergebnis)
		coin.Q[a.Key] = { S = a.Seq, R = receipt(result), At = a.Now }
		compactReceipts(coin)
	elseif not result.Ok then
		return nil, result -- NPC-Fehlschlag: nichts schreiben
	end
	coin.V += 1
	return coin, result
end

-- Stop-Loss eines Spielers setzen (Level = 0.1 .. 0.5) oder löschen (nil). Nur mit Position.
function Ledger.CoinSetStopLoss(coin, a)
	if not coin or not coin.H[a.Key] then
		return nil, { Ok = false, Error = "You don't own this coin" }
	end
	if a.Level and a.Key == coin.CK then
		return nil, { Ok = false, Error = "No stop-loss on your own coin" }
	end
	coin.SL = coin.SL or {}
	if coin.SL[a.Key] == a.Level then
		return nil, { Ok = true }
	end
	coin.SL[a.Key] = a.Level
	coin.V += 1
	return coin, { Ok = true }
end

-- Ist der Stop-Loss eines Holders erreicht? (Verkaufswert nach Gebühr <= Einsatz * (1 - Level))
function Ledger.StopLossHit(coin, key: string): boolean
	local level = coin.SL and coin.SL[key]
	local h = coin.H[key]
	if not level or not h or h.C <= 0 or key == coin.CK then
		return false
	end
	local value = Curve.CashForTokens(C, coin.Sup, h.A) * (1 - FEE_TOTAL)
	return value <= h.C * (1 - level)
end

-- Host verkauft für einen Offline-Spieler (nur wenn der Stop wirklich erreicht ist).
-- a = { Key, Now } -> Coin, Ergebnis (Cash, Profit) oder nil
function Ledger.CoinStopLossExec(coin, a)
	if not coin or not Ledger.StopLossHit(coin, a.Key) then
		return nil, nil
	end
	local result = sell(coin, { Key = a.Key, Name = "🛑 Stop-loss", IsNpc = false, Frac = 1, Now = a.Now })
	if not result.Ok then
		return nil, nil
	end
	coin.SL[a.Key] = nil
	coin.V += 1
	return coin, result
end

-- Spieler-Coin anlegen (Schritt 2 von "Coin erstellen"), optional mit Dev-Buy im selben Schritt.
-- a = { Id, Info = { Name, Ticker, Icon, Desc }, Key, Name, Seq, DevCash, Level, Now }
function Ledger.CoinLaunch(coin, a)
	if coin then
		local done = coin.Q[a.Key]
		local doneSeq = if type(done) == "number" then done elseif done then done.S else nil
		if doneSeq and doneSeq >= a.Seq then
			if type(done) == "table" then
				return nil, done.R -- schon angelegt
			end
			local holding = coin.H[a.Key]
			return nil, { Ok = true, Unknown = true, Tokens = 0, Cash = 0, Amount = if holding then holding.A else 0 }
		end
		return nil, { Ok = false, Error = "Please try again", Amount = 0 } -- Id schon vergeben (praktisch unmöglich)
	end
	local info = a.Info
	coin = Ledger.NewCoin({
		Id = a.Id,
		Name = info.Name,
		Ticker = info.Ticker,
		Icon = info.Icon,
		Desc = info.Desc,
		CreatorKey = a.Key,
		CreatorName = a.Name,
	}, a.Now)
	local holding = coin.H[a.Key]
	local result = { Ok = true, Tokens = 0, Cash = 0, Amount = holding.A, Cost = 0 }
	if (a.DevCash or 0) >= Config.Trade.MinCash then
		local bought = buy(coin, { Key = a.Key, Name = a.Name, Cash = a.DevCash, Level = a.Level, Now = a.Now })
		if bought.Ok then
			result = bought
		end
	end
	coin.Q[a.Key] = { S = a.Seq, R = receipt(result), At = a.Now }
	return coin, result
end

-- Coin als "Dead" markieren (30 Min. ohne Trade)
function Ledger.CoinMarkDead(coin, a)
	if not coin or coin.Dead or a.Now - coin.LT < a.DeadAfter then
		return nil, false
	end
	coin.Dead = true
	coin.V += 1
	return coin, true
end

-- Delisteten Coin schließen: alle Reste zum Kurvenwert verkaufen (größte zuerst).
-- -> Coin (leer, geschlossen), { [Spieler-Schlüssel] = Auszahlung }. NPC-Reste verfallen.
function Ledger.CoinCloseOut(coin, a)
	if not coin or not coin.Dead or coin.Closed or a.Now - coin.LT < a.KeepSeconds then
		return nil, nil
	end
	local list = {}
	for key, holding in coin.H do
		table.insert(list, { Key = key, A = holding.A })
	end
	table.sort(list, function(x, y)
		return x.A > y.A
	end)
	local payouts = {}
	for _, entry in list do
		local tokens = math.min(entry.A, coin.Sup)
		local payout = floorCents(Curve.CashForTokens(C, coin.Sup, tokens) * (1 - FEE_TOTAL))
		coin.Sup = math.max(0, coin.Sup - tokens)
		if string.sub(entry.Key, 1, 4) ~= "npc:" and payout > 0 then
			payouts[entry.Key] = payout
		end
	end
	coin.H = {}
	coin.Closed = true
	coin.V += 1
	return coin, payouts
end

-- Hält noch ein Spieler (kein NPC) diesen Coin?
function Ledger.HasPlayerHolders(coin): boolean
	for key in coin.H do
		if string.sub(key, 1, 4) ~= "npc:" then
			return true
		end
	end
	return false
end

------------------------------------------------------------------------
-- Geldbörse (Wallet) eines Spielers
-- { Cash, Seq, P = offener Trade oder nil, Coins = { [coinId] = true }, Owner = Server, HB = Lebenszeichen }
------------------------------------------------------------------------

-- Server übernimmt die Geldbörse (Session-Lock). Gehört sie einem anderen, lebenden Server: abbrechen.
function Ledger.WalletClaim(wallet, a)
	if not wallet then
		return nil, { Missing = true }
	end
	if wallet.Owner and wallet.Owner ~= a.Job and a.Now - (wallet.HB or 0) < a.Stale then
		return nil, { Locked = true }
	end
	wallet.Owner = a.Job
	wallet.HB = a.Now
	return wallet, { Ok = true }
end

-- Neue Geldbörse aus dem gespeicherten Profil (nur wenn es noch keine gibt)
function Ledger.WalletCreate(wallet, a)
	if wallet then
		return nil, { Exists = true }
	end
	local profile = a.Profile
	return {
		Cash = profile.Cash,
		Seq = profile.Seq or 0,
		P = profile.P,
		Coins = profile.Coins or {},
		St = profile.St or {},
		Ins = profile.Ins or {},
		Cr = profile.Cr,
		FB = profile.FB,
		FCM = profile.FCM,
		MyCoin = profile.MyCoin,
		RL = profile.RL,
		V = profile.V,
		Rc = profile.Rc,
		Fav = profile.Fav,
		Owner = a.Job,
		HB = a.Now,
	}, { Ok = true }
end

-- Schritt 1: Trade anmelden. Kauf: Geld sofort reservieren.
-- a = { Job, Side, Coin, Cash (Kauf), Frac (Verkauf), Now }
function Ledger.WalletBegin(wallet, a)
	if not wallet or wallet.Owner ~= a.Job then
		return nil, { Error = "Session lost – please rejoin" }
	end
	if wallet.P then
		return nil, { Error = "Previous trade still processing", Pending = true }
	end
	local premium = a.Premium or 0 -- Versicherung: 5 % zusätzlich
	local st = wallet.St or {}
	wallet.St = st
	local prevRug = st.LR
	if a.Rug then
		if (wallet.RL or 0) <= 0 then
			return nil, { Error = "You need a rug pull license" }
		end
		local waitLeft = (st.LR or 0) + R.Cooldown - a.Now
		if waitLeft > 0 then
			return nil, { Error = string.format("Next rug pull in %dh %dm", math.floor(waitLeft / 3600), math.floor(waitLeft % 3600 / 60)) }
		end
		wallet.RL -= 1 -- bei Fehlschlag gibt WalletFinish die Nutzung zurück
		st.LR = a.Now
	end
	if a.Side == "Buy" then
		if a.Cash < Config.Trade.MinCash then
			return nil, { Error = "Amount too small" }
		end
		if wallet.Cash < a.Cash + premium then
			return nil, { Error = "Not enough cash" }
		end
		wallet.Cash = floorCents(wallet.Cash - a.Cash - premium)
		wallet.Coins[a.Coin] = true
	end
	wallet.Seq += 1
	wallet.P = {
		S = wallet.Seq,
		Side = a.Side,
		Coin = a.Coin,
		Cash = a.Cash,
		Frac = a.Frac,
		Prem = if premium > 0 then premium else nil,
		Ins = a.Insure,
		L = a.Level,
		Rug = a.Rug or nil,
		PLR = if a.Rug then prevRug else nil,
		At = a.Now,
	}
	return wallet, { Ok = true, Seq = wallet.Seq }
end

-- Tag- und Wochen-Nummer (UTC; Woche beginnt Montag) für Tages-/Wochen-Ranglisten
function Ledger.PeriodKeys(now: number): (number, number)
	local day = math.floor(now / 86400)
	local week = math.floor((day + 3) / 7) -- 1.1.1970 war ein Donnerstag
	return day, week
end

-- Statistiken nach einem abgeschlossenen Trade (XP, PNL, bester Trade – gesamt, Woche, Tag)
local function updateStats(wallet, p, r, now: number)
	local st = wallet.St or {}
	wallet.St = st
	local xp = Config.Xp
	if (r.Cash or 0) >= xp.MinTradeCash and now - (st.LXT or 0) >= xp.TradeCooldown then
		st.TXp = (st.TXp or 0) + xp.PerTrade
		st.LXT = now
	end
	if p.Side == "Sell" and r.Profit then
		local profit = r.Profit
		local day, week = Ledger.PeriodKeys(now)
		if st.DK ~= day then
			st.DK, st.DPnl, st.DBest = day, 0, 0
		end
		if st.WK ~= week then
			st.WK, st.WPnl, st.WBest = week, 0, 0
		end
		st.Pnl = (st.Pnl or 0) + profit
		st.DPnl += profit
		st.WPnl += profit
		if profit > 0 then
			st.PP = (st.PP or 0) + profit -- für Gewinn-XP
		end
		st.Best = math.max(st.Best or 0, profit)
		st.DBest = math.max(st.DBest, profit)
		st.WBest = math.max(st.WBest, profit)
	end
end

-- Schritt 1 von "Coin erstellen": Gebühr + Dev-Buy reservieren.
-- a = { Job, Coin, Fee, Cash (Dev-Buy), Info, Level, Now }
function Ledger.WalletLaunchBegin(wallet, a)
	if not wallet or wallet.Owner ~= a.Job then
		return nil, { Error = "Session lost – please rejoin" }
	end
	if wallet.P then
		return nil, { Error = "Previous trade still processing", Pending = true }
	end
	if wallet.Cash < a.Fee + a.Cash then
		return nil, { Error = "Not enough cash" }
	end
	if a.Voucher then
		local v = wallet.V or {}
		if (v.CT or 0) <= 0 then
			return nil, { Error = "No coin voucher left" }
		end
		v.CT -= 1 -- Robux-Gutschein verbraucht (bei Fehlschlag zurück)
		wallet.V = v
	end
	if a.FreeMonth then
		if wallet.FCM == a.FreeMonth then
			return nil, { Error = "Free coin already used this month" }
		end
		wallet.FCM = a.FreeMonth -- Gold-Creator: Gratis-Coin dieses Monats verbraucht
	end
	wallet.Cash = floorCents(wallet.Cash - a.Fee - a.Cash)
	wallet.Seq += 1
	wallet.P = {
		S = wallet.Seq,
		Side = "Launch",
		Coin = a.Coin,
		Fee = a.Fee,
		Cash = a.Cash,
		Info = a.Info,
		L = a.Level,
		FM = a.FreeMonth,
		VC = a.Voucher or nil,
		At = a.Now,
	}
	return wallet, { Ok = true, Seq = wallet.Seq }
end

-- Schritt 3: Trade abschließen (genau einmal, egal welcher Server es tut).
-- a = { Seq, Result, Now }
function Ledger.WalletFinish(wallet, a)
	if not wallet or not wallet.P or wallet.P.S ~= a.Seq then
		return nil, { Already = true }
	end
	local p = wallet.P
	local r = a.Result
	wallet.P = nil
	if p.Side == "Launch" then
		if r.Ok then
			wallet.MyCoin = p.Coin
			wallet.Coins[p.Coin] = true
			-- nicht benutzter Dev-Buy zurück (bei unbekanntem Ergebnis nicht: lieber nichts als doppelt)
			local unused = if r.Unknown then 0 else (p.Cash or 0) - (r.Cash or 0)
			if unused > 0 then
				wallet.Cash = floorCents(wallet.Cash + unused)
			end
		else
			wallet.Cash = floorCents(wallet.Cash + (p.Fee or 0) + (p.Cash or 0)) -- alles zurück
			if p.FM and wallet.FCM == p.FM then
				wallet.FCM = nil -- Gratis-Coin nicht verbraucht
			end
			if p.VC then
				wallet.V = wallet.V or {}
				wallet.V.CT = (wallet.V.CT or 0) + 1 -- Gutschein zurück
			end
		end
		return wallet, { Ok = true }
	end
	if r.Ok then
		if p.Side == "Sell" then
			wallet.Cash = floorCents(wallet.Cash + r.Cash)
		end
	elseif p.Side == "Buy" then
		wallet.Cash = floorCents(wallet.Cash + p.Cash + (p.Prem or 0)) -- Kauf fehlgeschlagen: Geld + Prämie zurück
	end
	if p.Rug and not r.Ok then
		wallet.RL = (wallet.RL or 0) + 1 -- Rugpull fehlgeschlagen: Lizenz-Nutzung + Cooldown zurück
		wallet.St = wallet.St or {}
		wallet.St.LR = p.PLR
	end
	if (r.Amount or 0) <= 0 then
		wallet.Coins[p.Coin] = nil
	end
	if r.Ok and not r.Unknown then
		updateStats(wallet, p, r, a.Now or 0)
	end
	return wallet, { Ok = true }
end

-- Lebenszeichen. Gehört die Geldbörse nicht mehr diesem Server: melden (Spieler wird gekickt).
function Ledger.WalletHeartbeat(wallet, a)
	if not wallet or wallet.Owner ~= a.Job then
		return nil, { Lost = true }
	end
	wallet.HB = a.Now
	if a.Add then
		local st = wallet.St or {}
		wallet.St = st
		st.PT = (st.PT or 0) + a.Add -- Spielzeit in Sek. (Creator-Code erst ab 30 Min.)
	end
	return wallet, { Ok = true }
end

-- Geld gutschreiben/abziehen (Daily Reward usw.). Nie unter 0.
-- a.Id = eindeutige Nummer der Buchung: wird sie wiederholt, passiert nichts (kein Doppel-Geld).
function Ledger.WalletAddCash(wallet, a)
	if not wallet or wallet.Owner ~= a.Job then
		return nil, { Ok = false }
	end
	if wallet.Op == a.Id then
		return nil, { Ok = true, Already = true }
	end
	wallet.Op = a.Id
	local newCash = floorCents(wallet.Cash + a.Delta)
	if newCash < 0 then
		return nil, { Ok = false }
	end
	wallet.Cash = newCash
	return wallet, { Ok = true }
end

-- Versicherung für einen Coin an/aus (nur Einstellung, kein Geld)
function Ledger.WalletSetInsure(wallet, a)
	if not wallet or wallet.Owner ~= a.Job then
		return nil, { Ok = false }
	end
	wallet.Ins = wallet.Ins or {}
	wallet.Ins[a.Coin] = if a.On then true else nil
	return wallet, { Ok = true }
end

-- Mindestgeld: höchstens alle Interval Sek. (Zeit in der Geldbörse -> Rejoin hilft nicht)
function Ledger.WalletStipend(wallet, a)
	if not wallet or wallet.Owner ~= a.Job then
		return nil, { Ok = false }
	end
	local st = wallet.St or {}
	wallet.St = st
	if a.Now - (st.LS or 0) < a.Interval then
		return nil, { Ok = false }
	end
	st.LS = a.Now
	wallet.Cash = floorCents(wallet.Cash + a.Amount)
	return wallet, { Ok = true, Amount = a.Amount }
end

-- Daily Reward abholen. a = { Job, Day, Multiplier? }. Einmal pro Tag (Wiederholung = nichts doppelt).
function Ledger.WalletDaily(wallet, a)
	if not wallet or wallet.Owner ~= a.Job then
		return nil, { Ok = false, Error = "Session lost – please rejoin" }
	end
	local st = wallet.St or {}
	wallet.St = st
	if st.DD == a.Day then
		return nil, { Ok = false, Error = "Already claimed today – come back tomorrow" }
	end
	local streak = if st.DD == a.Day - 1 then (st.DS or 0) % #P.Daily + 1 else 1
	local amount = P.Daily[streak] * (a.Multiplier or 1)
	st.DD, st.DS = a.Day, streak
	wallet.Cash = floorCents(wallet.Cash + amount)
	return wallet, { Ok = true, Streak = streak, Amount = amount }
end

-- Postfach in die Geldbörse buchen (Stop-Loss offline, Erstattungen, geschlossene Coins).
-- a = { Job, Id, Cash, Profit, Now }. Gleiche Id nochmal = nichts doppelt.
function Ledger.WalletInbox(wallet, a)
	if not wallet or wallet.Owner ~= a.Job then
		return nil, { Ok = false }
	end
	if wallet.Op == a.Id then
		return nil, { Ok = true, Already = true }
	end
	wallet.Op = a.Id
	wallet.Cash = floorCents(wallet.Cash + math.max(0, a.Cash or 0))
	if a.Fee and a.Fee > 0 then
		local st = wallet.St or {}
		wallet.St = st
		st.FE = (st.FE or 0) + a.Fee -- verdiente Ersteller-Gebühren (Anzeige im Portfolio)
	end
	if a.Profit then
		updateStats(wallet, { Side = "Sell" }, { Cash = 0, Profit = a.Profit }, a.Now)
	end
	return wallet, { Ok = true }
end

-- Creator-Stufe auszahlen: nur wenn höher als alles bisher Bezahlte (jede Stufe einmal, keine Nachzahlung
-- übersprungener Stufen, nach Gold keine niedrigere). a = { Job, Tier, Cash, FreeBoosts }
function Ledger.WalletCreatorGrant(wallet, a)
	if not wallet or wallet.Owner ~= a.Job then
		return nil, { Ok = false }
	end
	wallet.Cr = wallet.Cr or {}
	if (wallet.Cr.Max or 0) >= a.Tier then
		return nil, { Ok = false, Already = true }
	end
	wallet.Cr.Max = a.Tier
	wallet.Cash = floorCents(wallet.Cash + (a.Cash or 0))
	wallet.FB = (wallet.FB or 0) + (a.FreeBoosts or 0)
	return wallet, { Ok = true }
end

-- Creator-Code einlösen: einmal im ganzen Spiel. a = { Job, Code, Cash }
function Ledger.WalletRedeem(wallet, a)
	if not wallet or wallet.Owner ~= a.Job then
		return nil, { Ok = false, Error = "Session lost – please rejoin" }
	end
	local st = wallet.St or {}
	wallet.St = st
	if st.RC then
		return nil, { Ok = false, Error = "You already used a creator code" }
	end
	st.RC = a.Code
	wallet.Cash = floorCents(wallet.Cash + a.Cash)
	return wallet, { Ok = true }
end

-- Einstellung/Fortschritt merken (nur erlaubte Schlüssel, prüft der Service). a = { Job, Key, Value }
function Ledger.WalletSetFlag(wallet, a)
	if not wallet or wallet.Owner ~= a.Job then
		return nil, { Ok = false }
	end
	local st = wallet.St or {}
	wallet.St = st
	if st[a.Key] == a.Value then
		return nil, { Ok = true }
	end
	st[a.Key] = a.Value
	return wallet, { Ok = true }
end

-- Favorit an/aus. Liste (älteste zuerst), max. MaxFavorites: ist sie voll, fällt der älteste raus.
-- a = { Job, Coin, On }
function Ledger.WalletFavorite(wallet, a)
	if not wallet or wallet.Owner ~= a.Job then
		return nil, { Ok = false }
	end
	local list = wallet.Fav or {}
	local index = table.find(list, a.Coin)
	if a.On == (index ~= nil) then
		return nil, { Ok = true }
	end
	if a.On then
		table.insert(list, a.Coin)
		while #list > Config.Market.MaxFavorites do
			table.remove(list, 1)
		end
	else
		table.remove(list, index)
	end
	wallet.Fav = list
	return wallet, { Ok = true }
end

-- Rug-Lizenz kaufen (gilt für LicenseUses Rugpulls). a = { Job, Id, Cost, Uses }. Gleiche Id = nichts doppelt.
function Ledger.WalletBuyLicense(wallet, a)
	if not wallet or wallet.Owner ~= a.Job then
		return nil, { Ok = false, Error = "Session lost – please rejoin" }
	end
	if wallet.Op == a.Id then
		return nil, { Ok = true, Already = true }
	end
	if (wallet.RL or 0) > 0 then
		return nil, { Ok = false, Error = string.format("You still have %d rug pulls left", wallet.RL) }
	end
	if wallet.Cash < a.Cost then
		return nil, { Ok = false, Error = "Not enough cash" }
	end
	wallet.Op = a.Id
	wallet.Cash = floorCents(wallet.Cash - a.Cost)
	wallet.RL = a.Uses
	return wallet, { Ok = true }
end

-- Robux-Kauf gutschreiben (ProcessReceipt). a = { Job, Receipt, Grant ("CT"/"FB"/"HT"/"RL"), Uses }
-- Die Kauf-Nummer wird gemerkt: Roblox wiederholt ProcessReceipt, bis "granted" kommt -> nie doppelt.
function Ledger.WalletGrantProduct(wallet, a)
	if not wallet or wallet.Owner ~= a.Job then
		return nil, { Ok = false }
	end
	wallet.Rc = wallet.Rc or {}
	if table.find(wallet.Rc, a.Receipt) then
		return nil, { Ok = true, Already = true }
	end
	table.insert(wallet.Rc, a.Receipt)
	while #wallet.Rc > Config.Shop.ReceiptsKept do
		table.remove(wallet.Rc, 1)
	end
	if a.Grant == "FB" then
		wallet.FB = (wallet.FB or 0) + 1
	elseif a.Grant == "RL" then
		wallet.RL = (wallet.RL or 0) + a.Uses
	else
		wallet.V = wallet.V or {}
		wallet.V[a.Grant] = (wallet.V[a.Grant] or 0) + 1
	end
	return wallet, { Ok = true }
end

-- Gutschein verbrauchen (-1) oder zurückgeben (+1). a = { Job, Id, Kind, Delta }. Gleiche Id = nichts doppelt.
function Ledger.WalletVoucher(wallet, a)
	if not wallet or wallet.Owner ~= a.Job then
		return nil, { Ok = false }
	end
	if wallet.Op == a.Id then
		return nil, { Ok = true, Already = true }
	end
	wallet.V = wallet.V or {}
	local count = (wallet.V[a.Kind] or 0) + a.Delta
	if count < 0 then
		return nil, { Ok = false }
	end
	wallet.Op = a.Id
	wallet.V[a.Kind] = count
	return wallet, { Ok = true }
end

-- Highlight am eigenen Coin (rein optisch). a = { Key, Id, Now, Seconds }. Gleiche Id = schon gebucht.
function Ledger.CoinHighlight(coin, a)
	if not coin or coin.CK ~= a.Key or coin.Dead then
		return nil, { Ok = false, Error = "Coin not found" }
	end
	if coin.HLI == a.Id then
		return nil, { Ok = true }
	end
	coin.HL = math.max(coin.HL or 0, a.Now) + a.Seconds -- läuft schon eins: verlängern
	coin.HLI = a.Id
	coin.V += 1
	return coin, { Ok = true, Until = coin.HL }
end

-- Gratis-Boosts (Bronze-Creator) verbrauchen (-1) oder zurückgeben (+1). a = { Job, Id, Delta }
function Ledger.WalletFreeBoost(wallet, a)
	if not wallet or wallet.Owner ~= a.Job then
		return nil, { Ok = false }
	end
	if wallet.Op == a.Id then
		return nil, { Ok = true, Already = true }
	end
	local count = (wallet.FB or 0) + a.Delta
	if count < 0 then
		return nil, { Ok = false }
	end
	wallet.Op = a.Id
	wallet.FB = count
	return wallet, { Ok = true }
end

-- Coins entfernen, die es nicht mehr gibt
function Ledger.WalletForget(wallet, a)
	if not wallet or wallet.Owner ~= a.Job then
		return nil
	end
	for _, coinId in a.Coins do
		wallet.Coins[coinId] = nil
	end
	return wallet
end

-- Server gibt die Geldbörse frei (Spieler hat den Server verlassen)
function Ledger.WalletRelease(wallet, a)
	if not wallet or wallet.Owner ~= a.Job then
		return nil
	end
	wallet.Owner = nil
	return wallet
end

-- Gespeichertes Profil (DataStore) aus der Geldbörse
function Ledger.ProfileFromWallet(wallet)
	return {
		Cash = wallet.Cash,
		Seq = wallet.Seq,
		P = wallet.P,
		Coins = wallet.Coins,
		St = wallet.St,
		Ins = wallet.Ins,
		Cr = wallet.Cr,
		FB = wallet.FB,
		FCM = wallet.FCM,
		MyCoin = wallet.MyCoin,
		RL = wallet.RL,
		V = wallet.V,
		Rc = wallet.Rc,
		Fav = wallet.Fav,
		Version = 1,
	}
end

------------------------------------------------------------------------
-- Sammel-Schlüssel (Shards): Kurzinfos aller Coins für alle Server
------------------------------------------------------------------------

-- a = { Updates = { [coinId] = Kurzinfo }, Removes = { [coinId] = true } }
function Ledger.ShardMerge(shard, a)
	shard = shard or {}
	for id, info in a.Updates do
		local old = shard[id]
		if not old or old.V < info.V then
			shard[id] = info
		end
	end
	for id in a.Removes do
		shard[id] = nil
	end
	return shard, true
end

------------------------------------------------------------------------
-- Welt: welche Server laufen, wie viele Spieler, wer ist NPC-Host
------------------------------------------------------------------------

-- a = { Job, Players, Now, Lease, Stale, Release? }
function Ledger.WorldTick(world, a)
	world = world or { Servers = {} }
	if a.Release then
		world.Servers[a.Job] = nil
		if world.Host and world.Host.Job == a.Job then
			world.Host = nil
		end
	else
		world.Servers[a.Job] = { P = a.Players, T = a.Now }
	end
	local total = 0
	for job, server in world.Servers do
		if a.Now - server.T > a.Stale then
			world.Servers[job] = nil
		else
			total += server.P
		end
	end
	local host = world.Host
	if not a.Release and (not host or host.Until < a.Now or host.Job == a.Job) then
		world.Host = { Job = a.Job, Until = a.Now + a.Lease }
	end
	local servers = 0
	for _ in world.Servers do
		servers += 1
	end
	return world, { IsHost = world.Host ~= nil and world.Host.Job == a.Job, Players = total, Servers = servers }
end

------------------------------------------------------------------------
-- Meldungen (Ticker) und Gebühren-Postfach
------------------------------------------------------------------------

function Ledger.NewsAdd(news, a)
	news = news or { Seq = 0, Items = {} }
	for _, item in a.Items do
		news.Seq += 1
		table.insert(news.Items, { S = news.Seq, K = item.Kind, X = item.Text })
	end
	while #news.Items > 10 do
		table.remove(news.Items, 1)
	end
	return news, true
end

-- Töpfe: { Ins = Versicherungstopf, Ref = Erstattungstopf, D = { Day, Used = { [Spieler] = Betrag } } }
function Ledger.PotsAdd(pots, a)
	pots = pots or { Ins = 0, Ref = 0 }
	pots.Ins = (pots.Ins or 0) + (a.Ins or 0)
	pots.Ref = (pots.Ref or 0) + (a.Ref or 0)
	return pots, true
end

-- Rug-Erstattungen bezahlen: erst aus dem Topf, fehlt etwas, legt das Spiel max. TopUp pro Spieler und Tag drauf.
-- a = { Comp = { [Spieler] = { Ins | Beg } }, AddRef = Rug-Anteil für den Topf, Day, TopUp } -> { [Spieler] = Betrag }
function Ledger.PotsPay(pots, a)
	pots = pots or { Ins = 0, Ref = 0 }
	pots.Ins = pots.Ins or 0
	pots.Ref = (pots.Ref or 0) + (a.AddRef or 0)
	if not pots.D or pots.D.Day ~= a.Day then
		pots.D = { Day = a.Day, Used = {} }
	end
	local payouts = {}
	for key, c in a.Comp do
		local want = c.Ins or c.Beg or 0
		local potName = if c.Ins then "Ins" else "Ref"
		local fromPot = math.min(want, pots[potName])
		pots[potName] = floorCents(pots[potName] - fromPot)
		local used = pots.D.Used[key] or 0
		local topUp = math.max(0, math.min(want - fromPot, a.TopUp - used))
		pots.D.Used[key] = used + topUp
		local total = floorCents(fromPot + topUp)
		if total > 0 then
			payouts[key] = total
		end
	end
	return pots, payouts
end

-- Boost-Plätze: { [coinId] = { U = bis, Id = Buchungsnummer } }
-- a = { Coin, Id, Now, Seconds, Slots }. Gleiche Id nochmal = schon gebucht (kein Doppel-Boost, keine falsche Erstattung).
function Ledger.BoostClaim(boosts, a)
	boosts = boosts or {}
	local active, nextFree = 0, math.huge
	for coinId, entry in boosts do
		if entry.U <= a.Now then
			boosts[coinId] = nil
		else
			active += 1
			nextFree = math.min(nextFree, entry.U - a.Now)
		end
	end
	local mine = boosts[a.Coin]
	if mine then
		if mine.Id == a.Id then
			return nil, { Ok = true, Until = mine.U }
		end
		return nil, { Ok = false, Error = string.format("Already boosted (%dm left)", math.ceil((mine.U - a.Now) / 60)) }
	end
	if active >= a.Slots then
		return nil, { Ok = false, Full = true, NextFree = nextFree }
	end
	boosts[a.Coin] = { U = a.Now + a.Seconds, Id = a.Id }
	return boosts, { Ok = true, Until = a.Now + a.Seconds }
end

-- Postfach: { [Schlüssel] = Betrag }. a = { Adds = { [Schlüssel] = Betrag } }
function Ledger.InboxAdd(inbox, a)
	inbox = inbox or {}
	for key, amount in a.Adds do
		inbox[key] = (inbox[key] or 0) + amount
	end
	return inbox, true
end

-- Postfach leeren, Inhalt zurückgeben
function Ledger.InboxDrain(inbox, _a)
	if not inbox or next(inbox) == nil then
		return nil, {}
	end
	return {}, inbox
end

return Ledger
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX22">
				<Properties>
					<string name="Name">RateLimiter</string>
					<ProtectedString name="Source"><![CDATA[-- RateLimiter (ModuleScript) – ServerScriptService/Util/RateLimiter
-- Erlaubt max. N Aktionen pro Zeitfenster (Standard 1 Sek.) pro Schlüssel (z. B. pro Spieler).

local RateLimiter = {}
RateLimiter.__index = RateLimiter

function RateLimiter.new(maxPerWindow: number, windowSeconds: number?)
	return setmetatable({ max = maxPerWindow, window = windowSeconds or 1, hits = {} }, RateLimiter)
end

function RateLimiter:Allow(key: any): boolean
	local now = os.clock()
	local list = self.hits[key]
	if not list then
		list = {}
		self.hits[key] = list
	end
	while list[1] and now - list[1] >= self.window do
		table.remove(list, 1)
	end
	if #list >= self.max then
		return false
	end
	table.insert(list, now)
	return true
end

function RateLimiter:Remove(key: any)
	self.hits[key] = nil
end

return RateLimiter
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX23">
				<Properties>
					<string name="Name">Remotes</string>
					<ProtectedString name="Source"><![CDATA[-- Remotes (ModuleScript) – ServerScriptService/Util/Remotes
-- Legt alle RemoteEvents/RemoteFunctions automatisch in ReplicatedStorage/Remotes an.
-- Du musst in Studio also KEINE Remotes von Hand erstellen.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local folder = ReplicatedStorage:FindFirstChild("Remotes")
if not folder then
	folder = Instance.new("Folder")
	folder.Name = "Remotes"
	folder.Parent = ReplicatedStorage
end

local Remotes = {}

local function get(className: string, name: string): Instance
	local remote = folder:FindFirstChild(name)
	if not remote then
		remote = Instance.new(className)
		remote.Name = name
		remote.Parent = folder
	end
	return remote
end

function Remotes.Event(name: string): RemoteEvent
	return get("RemoteEvent", name) :: RemoteEvent
end

function Remotes.Function(name: string): RemoteFunction
	return get("RemoteFunction", name) :: RemoteFunction
end

return Remotes
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX24">
				<Properties>
					<string name="Name">Store</string>
					<ProtectedString name="Source"><![CDATA[-- Store (ModuleScript) – ServerScriptService/Util/Store
-- Zugriff auf MemoryStore (Weltmarkt, alle Server) und DataStore (dauerhaft speichern),
-- jeweils mit Wiederholungen bei Fehlern.
--
-- Lokaler Testmodus: Ist das Spiel nicht veröffentlicht oder in Studio der API-Zugriff aus,
-- läuft alles nur im Speicher dieses Servers (nichts wird gespeichert). Steht dann als Warnung im Output.

local MemoryStoreService = game:GetService("MemoryStoreService")
local DataStoreService = game:GetService("DataStoreService")

local Store = {}

local RETRIES = 4

local function deepCopy(value)
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for key, item in value do
		copy[key] = deepCopy(item)
	end
	return copy
end

------------------------------------------------------------------------
-- Lokaler Ersatz (gleiche Schnittstelle wie die echten Dienste)
------------------------------------------------------------------------
local LocalMap = {}
LocalMap.__index = LocalMap

function LocalMap.new()
	return setmetatable({ data = {} }, LocalMap)
end

function LocalMap:GetAsync(key: string)
	return deepCopy(self.data[key])
end

function LocalMap:SetAsync(key: string, value: any)
	self.data[key] = deepCopy(value)
	return true
end

function LocalMap:UpdateAsync(key: string, transform: (any) -> any)
	local new = transform(deepCopy(self.data[key]))
	if new == nil then
		return nil
	end
	self.data[key] = deepCopy(new)
	return deepCopy(new)
end

function LocalMap:RemoveAsync(key: string)
	self.data[key] = nil
end

------------------------------------------------------------------------
-- Testmodus erkennen (echte Dienste einmal ausprobieren)
------------------------------------------------------------------------
local memoryOk = pcall(function()
	MemoryStoreService:GetHashMap("MoR_Probe"):GetAsync("probe")
end)
local dataOk = pcall(function()
	DataStoreService:GetDataStore("MoR_Probe"):GetAsync("probe")
end)
Store.LocalMode = not (memoryOk and dataOk)
if Store.LocalMode then
	warn(
		"[Store] MemoryStore/DataStore not available -> LOCAL TEST MODE (nothing is saved, only this server). "
			.. "For the real world market: publish the game and enable "
			.. "Game Settings > Security > 'Enable Studio Access to API Services'."
	)
end

local localMaps = {}

-- Wiederholt fn bei Fehlern (0,2 / 0,4 / 0,8 Sek. warten)
local function retry(label: string, fn)
	local delay = 0.2
	for attempt = 1, RETRIES do
		local ok, a, b = pcall(fn)
		if ok then
			return true, a, b
		end
		if attempt == RETRIES then
			warn(string.format("[Store] %s failed: %s", label, tostring(a)))
			return false, nil, nil
		end
		task.wait(delay)
		delay *= 2
	end
	return false, nil, nil
end

------------------------------------------------------------------------
-- Öffentliche Schnittstelle
------------------------------------------------------------------------
local Map = {}
Map.__index = Map

-- HashMap im MemoryStore (Weltmarkt). expiration in Sekunden (max. 45 Tage).
function Store.Map(name: string, expiration: number)
	local backend
	if Store.LocalMode then
		backend = localMaps[name] or LocalMap.new()
		localMaps[name] = backend
	else
		backend = MemoryStoreService:GetHashMap(name)
	end
	return setmetatable({ name = name, backend = backend, expiration = expiration }, Map)
end

-- -> ok, Wert
function Map:Get(key: string)
	local ok, value = retry(self.name .. ":Get " .. key, function()
		return self.backend:GetAsync(key)
	end)
	return ok, value
end

-- Atomar ändern mit einer Ledger-Funktion fn(alt, args) -> neu, ergebnis
-- -> ok, ergebnis, neuerWert (neuerWert = nil, wenn nichts geschrieben wurde)
-- expiration (optional): eigene Ablaufzeit für diesen Schreibvorgang
function Map:Update(key: string, fn, args, expiration: number?)
	local result
	local ok, newValue = retry(self.name .. ":Update " .. key, function()
		return self.backend:UpdateAsync(key, function(old)
			local new, r = fn(old, args)
			result = r
			return new
		end, expiration or self.expiration)
	end)
	return ok, result, newValue
end

-- Wie Update, aber OHNE Wiederholung. Für Buchungen, die keine eigene Nummer haben
-- (NPC-Trades, Gebühren): eine Wiederholung nach verlorener Antwort würde doppelt buchen.
-- -> ok, ergebnis, neuerWert. ok = false heißt: unklar, ob geschrieben wurde.
function Map:UpdateOnce(key: string, fn, args)
	local result
	local ok, newValue = pcall(function()
		return self.backend:UpdateAsync(key, function(old)
			local new, r = fn(old, args)
			result = r
			return new
		end, self.expiration)
	end)
	if not ok then
		warn(string.format("[Store] %s:UpdateOnce %s failed: %s", self.name, key, tostring(newValue)))
		return false, result, nil
	end
	return true, result, newValue
end

function Map:Set(key: string, value: any): boolean
	local ok = retry(self.name .. ":Set " .. key, function()
		return self.backend:SetAsync(key, value, self.expiration)
	end)
	return ok
end

function Map:Remove(key: string): boolean
	local ok = retry(self.name .. ":Remove " .. key, function()
		return self.backend:RemoveAsync(key)
	end)
	return ok
end

-- DataStore (dauerhaft). Gleiche Methoden Get/Update wie oben.
local Data = {}
Data.__index = Data

function Store.Data(name: string)
	local backend
	if Store.LocalMode then
		backend = localMaps["DS:" .. name] or LocalMap.new()
		localMaps["DS:" .. name] = backend
	else
		backend = DataStoreService:GetDataStore(name)
	end
	return setmetatable({ name = name, backend = backend }, Data)
end

function Data:Get(key: string)
	local ok, value = retry(self.name .. ":Get " .. key, function()
		return self.backend:GetAsync(key)
	end)
	return ok, value
end

-- fn(alt) -> neu
function Data:Update(key: string, fn)
	local ok, newValue = retry(self.name .. ":Update " .. key, function()
		return self.backend:UpdateAsync(key, function(old)
			return fn(old)
		end)
	end)
	return ok, newValue
end

return Store
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX25">
				<Properties>
					<string name="Name">TextFilter</string>
					<ProtectedString name="Source"><![CDATA[-- TextFilter (ModuleScript) – ServerScriptService/Util/TextFilter
-- Spieler-Texte (Coin-Name, Ticker, Beschreibung) prüfen:
--  1. eigene Regeln (Länge, erlaubte Zeichen, Sperrliste echter Krypto-Namen)
--  2. Roblox-Textfilter (Pflicht). Wird etwas weggefiltert (####), lehnen wir den Text ab.

local TextService = game:GetService("TextService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local L = Config.Launch

local TextFilter = {}

local blocked = {}
for _, word in L.Blocked do
	blocked[word] = true
end

-- Enthält der Text ein gesperrtes Wort (als ganzes Wort, Groß/klein egal)?
local function hasBlockedWord(text: string): boolean
	local upper = string.upper(text)
	for word in string.gmatch(upper, "%a+") do
		if blocked[word] then
			return true
		end
	end
	-- auch zusammengeschrieben, z. B. "BabyBitcoin" (nur lange Wörter, sonst zu viele Fehlalarme)
	for word in blocked do
		if #word >= 4 and string.find(upper, word, 1, true) then
			return true
		end
	end
	return false
end

-- Roblox-Filter. -> ok, gefilterter Text
local function robloxFilter(text: string, userId: number): (boolean, string?)
	local ok, result = pcall(function()
		return TextService:FilterStringAsync(text, userId, Enum.TextFilterContext.PublicChat)
	end)
	if not ok then
		return false, nil
	end
	local ok2, filtered = pcall(function()
		return result:GetNonChatStringForBroadcastAsync()
	end)
	if not ok2 then
		return false, nil
	end
	return true, filtered
end

local function clean(text: any): string?
	if typeof(text) ~= "string" or #text > 200 then
		return nil -- kein Text oder absurd lang (Exploiter)
	end
	-- Leerzeichen am Rand weg, mehrere Leerzeichen zu einem (gsub gibt 2 Werte zurück -> Klammern)
	local trimmed = (string.gsub(text, "^%s+", ""))
	trimmed = (string.gsub(trimmed, "%s+$", ""))
	return (string.gsub(trimmed, "%s+", " "))
end

-- Prüft alle Felder für einen neuen Coin. -> info oder nil, fehlertext
function TextFilter.CheckCoin(player: Player, name: any, ticker: any, desc: any, icon: any)
	name, ticker, desc = clean(name), clean(ticker), clean(desc or "")
	if not name or not ticker or not desc then
		return nil, "Invalid input"
	end
	ticker = string.upper(ticker)

	if #name < L.NameMin or #name > L.NameMax then
		return nil, string.format("Name: %d to %d characters", L.NameMin, L.NameMax)
	end
	if not string.match(name, "^[%w ]+$") then
		return nil, "Name: only letters, numbers and spaces"
	end
	if #ticker < L.TickerMin or #ticker > L.TickerMax or not string.match(ticker, "^%u+$") then
		return nil, string.format("Ticker: %d to %d letters A-Z", L.TickerMin, L.TickerMax)
	end
	if #desc > L.DescMax then
		return nil, string.format("Description: max. %d characters", L.DescMax)
	end
	if typeof(icon) ~= "string" or not table.find(Config.CoinIcons, icon) then
		return nil, "Please pick an icon"
	end
	if blocked[ticker] or hasBlockedWord(name) or hasBlockedWord(desc) then
		return nil, "Real coin names and brands are not allowed – use a fictional name"
	end

	-- Roblox-Filter für alles, was andere sehen
	for _, text in { name, ticker, desc } do
		if text ~= "" then
			local ok, filtered = robloxFilter(text, player.UserId)
			if not ok then
				return nil, "Text check failed – please try again"
			end
			if filtered ~= text then
				return nil, "That text is not allowed"
			end
		end
	end
	return { Name = name, Ticker = ticker, Desc = desc, Icon = icon }, nil
end

-- Creator-Code prüfen (4–12 Zeichen A–Z/0–9, Sperrliste, Roblox-Filter). -> Code (groß) oder nil, fehlertext
function TextFilter.CheckCode(player: Player, code: any)
	if typeof(code) ~= "string" or #code > 50 then
		return nil, "Invalid code"
	end
	code = string.upper((string.gsub(code, "%s", "")))
	local C = Config.Creator
	if #code < C.CodeMin or #code > C.CodeMax or not string.match(code, "^[%u%d]+$") then
		return nil, string.format("Code: %d to %d letters/numbers", C.CodeMin, C.CodeMax)
	end
	if blocked[code] or hasBlockedWord(code) then
		return nil, "That code is not allowed"
	end
	local ok, filtered = robloxFilter(code, player.UserId)
	if not ok then
		return nil, "Text check failed – please try again"
	end
	if filtered ~= code then
		return nil, "That code is not allowed"
	end
	return code, nil
end

-- Nur Format prüfen (beim Einlösen: der Code wurde beim Anlegen schon gefiltert)
function TextFilter.NormalizeCode(code: any): string?
	if typeof(code) ~= "string" or #code > 50 then
		return nil
	end
	code = string.upper((string.gsub(code, "%s", "")))
	local C = Config.Creator
	if #code < C.CodeMin or #code > C.CodeMax or not string.match(code, "^[%u%d]+$") then
		return nil
	end
	return code
end

return TextFilter
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
	</Item>
	<Item class="Folder" referent="RBX44">
		<Properties><string name="Name">StarterPlayerScripts</string></Properties>
		<Item class="LocalScript" referent="RBX28">
			<Properties>
				<string name="Name">ClientMain</string>
				<ProtectedString name="Source"><![CDATA[-- ClientMain (LocalScript) – StarterPlayer/StarterPlayerScripts/ClientMain
-- Startet den Client. Der Client zeigt nur an, alle Entscheidungen trifft der Server.

local modules = script.Parent:WaitForChild("ClientModules")
local Screen = require(modules:WaitForChild("Screen"))
local TerminalUI = require(modules:WaitForChild("TerminalUI"))

Screen.Setup()
TerminalUI.Start()
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="Folder" referent="RBX43">
			<Properties><string name="Name">ClientModules</string></Properties>
			<Item class="ModuleScript" referent="RBX29">
				<Properties>
					<string name="Name">AdminUI</string>
					<ProtectedString name="Source"><![CDATA[-- AdminUI (ModuleScript) – StarterPlayer/StarterPlayerScripts/ClientModules/AdminUI
-- Admin-Fenster für das Creator-Programm: Roblox-Name, Video-Link (nur Admins sehen ihn), Stufe wählen,
-- GRANT / REVOKE, letzte 10 Aktionen. Nur sichtbar für Admins – der Server prüft trotzdem jede Anfrage.
--
-- Platz: Fenster 85 % breit, 484 hoch (passt in die kleinste Höhe von 496)

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Screen = require(script.Parent.Screen)
local MarketClient = require(script.Parent.MarketClient)

local Colors = Screen.Colors
local TIERS = Config.Creator.Tiers

local AdminUI = {}

function AdminUI.new(parent: GuiObject)
	local self = {}
	local tier = 1

	local overlay = Screen.New("TextButton", {
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Colors.Background,
		BackgroundTransparency = 0.3,
		Visible = false,
		ZIndex = 40,
		Parent = parent,
	})
	local panel = Screen.New("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0.85, 0, 0, 484),
		BackgroundColor3 = Colors.Panel,
		Active = true,
		ZIndex = 41,
		Parent = overlay,
	}, {
		Screen.Corner(14),
		Screen.Padding(16),
		Screen.New("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
	})

	local function row(order: number, height: number)
		return Screen.New("Frame", {
			Size = UDim2.new(1, 0, 0, height),
			BackgroundTransparency = 1,
			LayoutOrder = order,
			ZIndex = 42,
			Parent = panel,
		}, {
			Screen.New("UIListLayout", {
				FillDirection = Enum.FillDirection.Horizontal,
				Padding = UDim.new(0, 8),
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		})
	end

	local function textBox(placeholder: string, maxLength: number, size: UDim2, order: number, parentFrame)
		local box = Screen.New("TextBox", {
			PlaceholderText = placeholder,
			Text = "",
			ClearTextOnFocus = false,
			Font = Screen.Fonts.Medium,
			TextSize = 22,
			TextColor3 = Colors.Text,
			PlaceholderColor3 = Colors.Muted,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			BackgroundColor3 = Colors.PanelLight,
			Size = size,
			LayoutOrder = order,
			ZIndex = 42,
			Parent = parentFrame,
		}, {
			Screen.Corner(10),
			Screen.New("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) }),
		})
		box:GetPropertyChangedSignal("Text"):Connect(function()
			if #box.Text > maxLength then
				box.Text = string.sub(box.Text, 1, maxLength)
			end
		end)
		return box
	end

	Screen.Label({
		Text = "🛠 ADMIN · CREATORS",
		Font = Screen.Fonts.Bold,
		TextSize = 28,
		Size = UDim2.new(1, 0, 0, 34),
		LayoutOrder = 1,
		ZIndex = 42,
		Parent = panel,
	})

	local inputRow = row(2, 56)
	local nameBox = textBox("Roblox name", 20, UDim2.new(0.4, -4, 1, 0), 1, inputRow)
	local videoBox = textBox("Video link (only admins see it)", 200, UDim2.new(0.6, -4, 1, 0), 2, inputRow)

	local tierRow = row(3, 72)
	local tierButtons = {}
	for i, info in TIERS do
		local button = Screen.Button({
			Text = info.Name,
			TextSize = 22,
			Size = UDim2.new(0.25, -6, 1, 0),
			LayoutOrder = i,
			ZIndex = 43,
			Parent = tierRow,
		})
		button.Activated:Connect(function()
			tier = i
			self.Refresh()
		end)
		tierButtons[i] = button
	end

	local actionRow = row(4, 72)
	local grantButton = Screen.Button({
		Text = "GRANT",
		BackgroundColor3 = Colors.Green,
		Size = UDim2.new(0, 200, 1, 0),
		LayoutOrder = 1,
		ZIndex = 43,
		Parent = actionRow,
	})
	local revokeButton = Screen.Button({
		Text = "REVOKE",
		BackgroundColor3 = Colors.Red,
		Size = UDim2.new(0, 200, 1, 0),
		LayoutOrder = 2,
		ZIndex = 43,
		Parent = actionRow,
	})
	local closeButton = Screen.Button({
		Text = "CLOSE",
		Size = UDim2.new(0, 160, 1, 0),
		LayoutOrder = 3,
		ZIndex = 43,
		Parent = actionRow,
	})

	local status = Screen.Label({
		Text = "",
		TextSize = 20,
		TextColor3 = Colors.Muted,
		Size = UDim2.new(1, 0, 0, 24),
		LayoutOrder = 5,
		ZIndex = 42,
		Parent = panel,
	})

	-- Letzte 10 Aktionen
	local logList = Screen.Scroller({
		Size = UDim2.new(1, 0, 0, 140),
		LayoutOrder = 6,
		ZIndex = 42,
		Parent = panel,
	})
	local logRows = {}

	local function showLog(log)
		for _, label in logRows do
			label:Destroy()
		end
		logRows = {}
		if type(log) ~= "table" or #log == 0 then
			table.insert(
				logRows,
				Screen.Label({
					Text = "No actions yet.",
					TextSize = 20,
					TextColor3 = Colors.Muted,
					Size = UDim2.new(1, -10, 0, 24),
					ZIndex = 43,
					Parent = logList,
				})
			)
			return
		end
		for i, entry in log do
			local when = os.date("%d.%m. %H:%M", math.floor(entry.At or 0))
			local text = string.format(
				"%s · %s %s %s%s · by %s",
				when,
				string.upper(entry.Act or "?"),
				entry.T or "?",
				if entry.Act == "grant" then "→ " .. (entry.Tier or "?") else "",
				if entry.V and entry.V ~= "" then " · " .. entry.V else "",
				entry.A or "?"
			)
			table.insert(
				logRows,
				Screen.Label({
					Text = text,
					TextSize = 20,
					TextTruncate = Enum.TextTruncate.AtEnd,
					Size = UDim2.new(1, -10, 0, 24),
					LayoutOrder = i,
					ZIndex = 43,
					Parent = logList,
				})
			)
		end
	end

	function self.Refresh()
		for i, button in tierButtons do
			button.BackgroundColor3 = if i == tier then Colors.Accent else Colors.PanelLight
		end
	end

	local function hide()
		overlay.Visible = false
	end

	function self.Show()
		self.Refresh()
		overlay.Visible = true
		status.Text = "Loading log…"
		task.spawn(function()
			local log = MarketClient.AdminLog()
			status.Text = if log then "" else "Not allowed"
			showLog(log)
		end)
	end

	-- Doppelklick-Schutz: bis zur Antwort (max. 10 Sek.) gesperrt
	local waiting = false
	local function send(action: string)
		if waiting then
			return
		end
		local name = string.gsub(nameBox.Text, "%s", "")
		if #name < 3 then
			status.Text = "❌ Enter a Roblox name"
			status.TextColor3 = Colors.Red
			return
		end
		waiting = true
		status.Text = "Saving…"
		status.TextColor3 = Colors.Muted
		MarketClient.AdminAction(action, name, if action == "grant" then tier else nil, videoBox.Text)
		task.delay(10, function()
			waiting = false
		end)
	end

	MarketClient.AdminResult.Event:Connect(function(result)
		waiting = false
		status.Text = (if result.Ok then "✅ " else "❌ ") .. tostring(result.Message)
		status.TextColor3 = if result.Ok then Colors.Green else Colors.Red
		showLog(result.Log)
		if result.Ok then
			nameBox.Text, videoBox.Text = "", ""
		end
	end)

	grantButton.Activated:Connect(function()
		send("grant")
	end)
	revokeButton.Activated:Connect(function()
		send("revoke")
	end)
	closeButton.Activated:Connect(hide)
	overlay.Activated:Connect(hide)

	return self
end

return AdminUI
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX30">
				<Properties>
					<string name="Name">ChartRenderer</string>
					<ProtectedString name="Source"><![CDATA[-- ChartRenderer (ModuleScript) – StarterPlayer/StarterPlayerScripts/ClientModules/ChartRenderer
-- Zeichnet einen Linien-Chart aus kleinen Balken (Frames). Roblox hat keine Chart-Bibliothek.
-- 60 Punkte + aktueller Punkt. Grün = gestiegen, Rot = gefallen.
-- Pro-Terminal (Phase 8): Kerzen-Modus (Docht = Hoch/Tief, Körper = Start/Ende je 5 Sek.).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Format = require(ReplicatedStorage.Shared.Format)
local Screen = require(script.Parent.Screen)

local Colors = Screen.Colors
local LINE_THICKNESS = 3 -- Design-Pixel

local ChartRenderer = {}
ChartRenderer.__index = ChartRenderer

-- parent: Frame, in den der Chart gezeichnet wird (füllt ihn ganz aus)
function ChartRenderer.new(parent: GuiObject)
	local self = setmetatable({}, ChartRenderer)
	self.Frame = Screen.New("Frame", {
		Name = "Chart",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Colors.Panel,
		ClipsDescendants = true,
		Parent = parent,
	}, {
		Screen.Corner(12),
	})
	-- Zeichenfläche mit Rand, damit Linie und Beschriftung nicht am Rand kleben
	self.Area = Screen.New("Frame", {
		Position = UDim2.fromOffset(12, 30),
		Size = UDim2.new(1, -24, 1, -60),
		BackgroundTransparency = 1,
		Parent = self.Frame,
	})
	self.HighLabel = Screen.Label({
		Position = UDim2.fromOffset(12, 4),
		Size = UDim2.new(1, -24, 0, 24),
		TextSize = 20,
		TextColor3 = Colors.Muted,
		Parent = self.Frame,
	})
	self.LowLabel = Screen.Label({
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 12, 1, -4),
		Size = UDim2.new(1, -24, 0, 24),
		TextSize = 20,
		TextColor3 = Colors.Muted,
		Parent = self.Frame,
	})
	self.Segments = {}
	self.Wicks = {}
	self.Points = {}
	self.Candles = {} -- { O, H, L, C }
	self.CandleMode = false
	self.Area:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		self:Draw()
	end)
	return self
end

-- chart = Liste { O, H, L, C }, current = aktueller Punkt (oder nil)
function ChartRenderer:SetData(chart, current)
	local points, candles = {}, {}
	for _, point in chart do
		table.insert(points, point.C)
		table.insert(candles, point)
	end
	if current then
		table.insert(points, current.C)
		table.insert(candles, current)
	end
	self.Points = points
	self.Candles = candles
	self:Draw()
end

function ChartRenderer:SetCandles(on: boolean)
	self.CandleMode = on
	self:Draw()
end

local function segment(self, index: number, list)
	list = list or self.Segments
	local frame = list[index]
	if not frame then
		frame = Screen.New("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			BorderSizePixel = 0,
			Parent = self.Area,
		})
		list[index] = frame
	end
	frame.Visible = true
	frame.Rotation = 0
	return frame
end

local function hideFrom(list, first: number)
	for i = first, #list do
		list[i].Visible = false
	end
end

-- Kerzen: Docht von Tief bis Hoch, Körper von Start bis Ende
local function drawCandles(self, size: Vector2)
	local candles = self.Candles
	local low, high = math.huge, -math.huge
	for _, c in candles do
		low = math.min(low, c.L or c.C)
		high = math.max(high, c.H or c.C)
	end
	if high - low < high * 0.001 then
		high += high * 0.01
		low -= low * 0.01
	end
	self.HighLabel.Text = "High " .. Format.Price(high)
	self.LowLabel.Text = "Low " .. Format.Price(low)
	local stepX = size.X / math.max(1, #candles)
	local function y(price: number): number
		return size.Y * (1 - (price - low) / (high - low))
	end
	for i, c in candles do
		local x = (i - 0.5) * stepX
		local color = if c.C >= c.O then Colors.Green else Colors.Red
		local wick = segment(self, i, self.Wicks)
		wick.BackgroundColor3 = color
		local top, bottom = y(c.H or c.C), y(c.L or c.C)
		wick.Position = UDim2.fromOffset(x, (top + bottom) / 2)
		wick.Size = UDim2.fromOffset(2, math.max(1, bottom - top))
		local body = segment(self, i)
		body.BackgroundColor3 = color
		local bodyTop, bodyBottom = y(math.max(c.O, c.C)), y(math.min(c.O, c.C))
		body.Position = UDim2.fromOffset(x, (bodyTop + bodyBottom) / 2)
		body.Size = UDim2.fromOffset(math.max(2, stepX * 0.6), math.max(2, bodyBottom - bodyTop))
	end
	hideFrom(self.Segments, #candles + 1)
	hideFrom(self.Wicks, #candles + 1)
end

function ChartRenderer:Draw()
	local points = self.Points
	local scale = Screen.GetScale()
	local size = self.Area.AbsoluteSize / scale -- Größe in Design-Pixeln
	if #points < 2 or size.X <= 0 or size.Y <= 0 then
		hideFrom(self.Segments, 1)
		hideFrom(self.Wicks, 1)
		self.HighLabel.Text = if points[1] then Format.Price(points[1]) else ""
		self.LowLabel.Text = "Waiting for trades…"
		return
	end

	if self.CandleMode then
		drawCandles(self, size)
		return
	end
	hideFrom(self.Wicks, 1)

	local low, high = math.huge, -math.huge
	for _, p in points do
		low = math.min(low, p)
		high = math.max(high, p)
	end
	if high - low < high * 0.001 then -- flacher Kurs: etwas Luft oben/unten
		high += high * 0.01
		low -= low * 0.01
	end
	self.HighLabel.Text = "High " .. Format.Price(high)
	self.LowLabel.Text = "Low " .. Format.Price(low)

	local color = if points[#points] >= points[1] then Colors.Green else Colors.Red
	local stepX = size.X / (#points - 1)
	local function pos(i: number): Vector2
		return Vector2.new((i - 1) * stepX, size.Y * (1 - (points[i] - low) / (high - low)))
	end

	for i = 1, #points - 1 do
		local a, b = pos(i), pos(i + 1)
		local delta = b - a
		local frame = segment(self, i)
		frame.BackgroundColor3 = color
		frame.Position = UDim2.fromOffset((a.X + b.X) / 2, (a.Y + b.Y) / 2)
		frame.Size = UDim2.fromOffset(delta.Magnitude + 1, LINE_THICKNESS)
		frame.Rotation = math.deg(math.atan2(delta.Y, delta.X))
	end
	hideFrom(self.Segments, #points)
end

return ChartRenderer
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX31">
				<Properties>
					<string name="Name">CoinPage</string>
					<ProtectedString name="Source"><![CDATA[-- CoinPage (ModuleScript) – StarterPlayer/StarterPlayerScripts/ClientModules/CoinPage
-- Coin-Seite: links Chart + Ampel-Indikatoren + Infos, rechts Position, Kaufen/Verkaufen
-- (10/25/50 %/alles), Live-Trades. Stop-Loss und Versicherung kommen in Phase 5.
--
-- Platz (kleinster Fall 976 x 368 Design-Pixel):
--   links 60 %: Kopf 72 | Chart (mind. 176) | 4 Ampel-Kacheln 72 | 1 Infozeile 24
--   rechts 40 %: Position 26 | BUY 20+72 | SELL 20+72 | Live-Trades (Rest, mind. 3 Zeilen)

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Screen = require(script.Parent.Screen)
local MarketClient = require(script.Parent.MarketClient)
local ChartRenderer = require(script.Parent.ChartRenderer)
local Indicators = require(ReplicatedStorage.Shared.Indicators)
local CreatorStyle = require(ReplicatedStorage.Shared.CreatorStyle)

local Colors = Screen.Colors
local TRADE_ROWS = 8
local CHIPS = 72 -- Höhe der Ampel-Kacheln
local INFO = 24 -- Höhe der Infozeile

local RATING_COLORS = {
	Good = Colors.Green,
	Ok = Colors.Accent,
	Bad = Colors.Red,
}
local RATING_DOTS = { Good = "🟢", Ok = "🟡", Bad = "🔴" }

local CoinPage = {}

-- parent: Seite, onBack(): zurück zur vorigen Seite
function CoinPage.new(parent: GuiObject, onBack: () -> ())
	local self = { CoinId = nil :: string? }
	local helpDef -- gerade geöffnete Erklärung (oder nil)
	local updateHelp -- Funktion, wird weiter unten gesetzt

	------------------------------------------------------------------
	-- Links: Kopf, Chart, Infos
	------------------------------------------------------------------
	local left = Screen.New("Frame", {
		Size = UDim2.new(0.6, -6, 1, 0),
		BackgroundTransparency = 1,
		Parent = parent,
	})
	local back = Screen.Button({
		Text = "◀",
		Size = UDim2.fromOffset(72, 72),
		Parent = left,
	})
	back.Activated:Connect(onBack)
	-- Favorit ⭐ an/aus
	local favButton = Screen.Button({
		Text = "☆",
		TextSize = 34,
		Position = UDim2.fromOffset(80, 0),
		Size = UDim2.fromOffset(72, 72),
		Parent = left,
	})
	favButton.Activated:Connect(function()
		if self.CoinId then
			MarketClient.SetFavorite(self.CoinId, not MarketClient.IsFavorite(self.CoinId))
		end
	end)

	local NAME_X = 162 -- ◀ 72 | 8 | ⭐ 72 | 10
	local nameLabel = Screen.Label({
		Font = Screen.Fonts.Bold,
		TextSize = 28,
		Position = UDim2.fromOffset(NAME_X, 2),
		Size = UDim2.new(1, -NAME_X, 0, 36),
		Parent = left,
	})
	local priceLabel = Screen.Label({
		Font = Screen.Fonts.Bold,
		TextSize = 24,
		Position = UDim2.fromOffset(NAME_X, 40),
		Size = UDim2.new(1, -NAME_X, 0, 30),
		Parent = left,
	})
	-- Boost: nur beim eigenen Coin (ab Level 15, 25.000 Cash, 10 Min.)
	local boostButton = Screen.Button({
		TextSize = 20,
		BackgroundColor3 = Colors.Accent,
		TextColor3 = Colors.Background,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.fromOffset(120, 72),
		Visible = false,
		Parent = left,
	})
	-- Mit Cash, wenn möglich; sonst Robux-Kauf (49 R$, ohne Level), danach automatisch boosten
	local function canBoostWithCash(): boolean
		local me = MarketClient.Me
		local level = if me.Stats then me.Stats.Level else 1
		return level >= Config.Launch.BoostMinLevel and (me.Cash or 0) >= Config.Launch.BoostCost
	end
	boostButton.Activated:Connect(function()
		local coinId = self.CoinId
		if not coinId then
			return
		end
		if (MarketClient.Me.FreeBoosts or 0) > 0 or canBoostWithCash() or MarketClient.BoostLeft(coinId) > 0 then
			MarketClient.Boost(coinId)
			return
		end
		local before = MarketClient.Me.FreeBoosts or 0
		MarketClient.BuyThen("Boost", function()
			return (MarketClient.Me.FreeBoosts or 0) > before
		end, function()
			MarketClient.Boost(coinId)
		end)
	end)
	-- Rugpull: nur beim eigenen Coin mit Lizenz, ein Klick verkauft alles (Phase 7)
	local rugButton = Screen.Button({
		TextSize = 20,
		BackgroundColor3 = Colors.Red,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -128, 0, 0),
		Size = UDim2.fromOffset(120, 72),
		Visible = false,
		Parent = left,
	})
	rugButton.Activated:Connect(function()
		if self.CoinId then
			MarketClient.RugPull(self.CoinId)
		end
	end)

	local chartHolder = Screen.New("Frame", {
		Position = UDim2.fromOffset(0, 82),
		Size = UDim2.new(1, 0, 1, -82 - 8 - CHIPS - 4 - INFO),
		BackgroundTransparency = 1,
		Parent = left,
	})
	local chart = ChartRenderer.new(chartHolder)
	-- Pro: Kerzen-Chart an/aus (ohne Pro: 🔒, antippen = kaufen)
	local candles = false
	local candleButton = Screen.Button({
		TextSize = 20,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -4, 0, 4),
		Size = UDim2.fromOffset(112, 72),
		BackgroundTransparency = 0.2,
		Parent = chartHolder,
	})
	candleButton.Activated:Connect(function()
		if not MarketClient.HasPass("Pro") then
			MarketClient.Buy("Pro")
			return
		end
		candles = not candles
		chart:SetCandles(candles)
		self.Refresh()
	end)

	------------------------------------------------------------------
	-- Ampel-Indikatoren (antippen = Erklärung)
	------------------------------------------------------------------
	local chipRow = Screen.New("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, -(4 + INFO)),
		Size = UDim2.new(1, 0, 0, CHIPS),
		BackgroundTransparency = 1,
		Parent = left,
	}, {
		Screen.New("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	local chips = {} -- [id] = { Value, Stroke }
	local count = #Indicators.List
	local showHelp -- wird unten gesetzt
	for i, def in Indicators.List do
		local chip = Screen.Button({
			Text = "",
			BackgroundColor3 = Colors.Panel,
			Size = UDim2.new(1 / count, -8 * (count - 1) / count, 1, 0),
			LayoutOrder = i,
			Parent = chipRow,
		})
		Screen.Label({
			Text = def.Label .. " ?",
			TextSize = 20,
			TextColor3 = Colors.Muted,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.fromOffset(4, 6),
			Size = UDim2.new(1, -8, 0, 24),
			Parent = chip,
		})
		chips[def.Id] = {
			Value = Screen.Label({
				Font = Screen.Fonts.Bold,
				TextSize = 26,
				TextXAlignment = Enum.TextXAlignment.Center,
				Position = UDim2.fromOffset(4, 32),
				Size = UDim2.new(1, -8, 0, 32),
				Parent = chip,
			}),
			Stroke = Screen.New("UIStroke", {
				Thickness = 2,
				ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
				Parent = chip,
			}),
		}
		chip.Activated:Connect(function()
			showHelp(def)
		end)
	end

	local infoLabel = Screen.Label({
		TextSize = 20,
		TextColor3 = Colors.Muted,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 4, 1, 0),
		Size = UDim2.new(1, -8, 0, INFO),
		Parent = left,
	})

	------------------------------------------------------------------
	-- Rechts: Position, Kaufen, Verkaufen, Live-Trades
	------------------------------------------------------------------
	local right = Screen.New("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.new(0.4, -6, 1, 0),
		BackgroundColor3 = Colors.Panel,
		ClipsDescendants = true,
		Parent = parent,
	}, {
		Screen.Corner(12),
		Screen.Padding(12),
		Screen.New("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	local positionLabel = Screen.Label({
		Font = Screen.Fonts.Bold,
		Size = UDim2.new(1, 0, 0, 26),
		LayoutOrder = 1,
		Parent = right,
	})

	local function tradeRow(order: number, side: string, color: Color3)
		local row = Screen.New("Frame", {
			Size = UDim2.new(1, 0, 0, 72),
			BackgroundTransparency = 1,
			LayoutOrder = order,
			Parent = right,
		}, {
			Screen.New("UIListLayout", {
				FillDirection = Enum.FillDirection.Horizontal,
				Padding = UDim.new(0, 8),
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		})
		local count = #Config.Trade.Fractions
		for i, fraction in Config.Trade.Fractions do
			local amount = if fraction >= 1
				then (if side == "Buy" then "MAX" else "ALL")
				else math.floor(fraction * 100 + 0.5) .. "%"
			local button = Screen.Button({
				Text = string.upper(side) .. "\n" .. amount, -- zwei Zeilen: passt auch auf schmale Bildschirme
				TextSize = 22,
				BackgroundColor3 = color,
				Size = UDim2.new(1 / count, -8 * (count - 1) / count, 1, 0),
				LayoutOrder = i,
				Parent = row,
			})
			button.Activated:Connect(function()
				if self.CoinId then
					MarketClient.Trade(self.CoinId, side, fraction)
				end
			end)
		end
		return row
	end
	self.BuyRow = tradeRow(2, "Buy", Colors.Green) -- für das Tutorial
	self.SellRow = tradeRow(3, "Sell", Colors.Red)

	-- Schutz: Stop-Loss (ab Level 3) und Versicherung (ab Level 5)
	local protectRow = Screen.New("Frame", {
		Size = UDim2.new(1, 0, 0, 64),
		BackgroundTransparency = 1,
		LayoutOrder = 4,
		Parent = right,
	}, {
		Screen.New("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	local stopButton = Screen.Button({
		TextSize = 20,
		Size = UDim2.new(0.5, -4, 1, 0),
		LayoutOrder = 1,
		Parent = protectRow,
	})
	local insureButton = Screen.Button({
		TextSize = 20,
		Size = UDim2.new(0.5, -4, 1, 0),
		LayoutOrder = 2,
		Parent = protectRow,
	})
	local stopLevels = Config.Protection.StopLossLevels
	stopButton.Activated:Connect(function()
		local coinId = self.CoinId
		if not coinId then
			return
		end
		-- Stufen durchschalten: OFF -> -10 % -> -20 % -> -30 % -> -50 % -> OFF
		local position = MarketClient.Me.Positions[coinId]
		local current = 0
		for i, level in stopLevels do
			if position and position.SL == level then
				current = i
			end
		end
		MarketClient.SetStopLoss(coinId, (current + 1) % (#stopLevels + 1))
	end)
	insureButton.Activated:Connect(function()
		local coinId = self.CoinId
		if coinId then
			local insured = MarketClient.Me.Insured or {}
			MarketClient.SetInsurance(coinId, not insured[coinId])
		end
	end)

	Screen.Label({
		Text = "LIVE TRADES",
		Font = Screen.Fonts.Bold,
		TextSize = 20,
		TextColor3 = Colors.Muted,
		Size = UDim2.new(1, 0, 0, 22),
		LayoutOrder = 6,
		Parent = right,
	})
	local tradeList = Screen.New("Frame", {
		-- füllt den Rest: 26 + 72 + 72 + 64 + 22 + 5 Abstände à 6 = 286 (kleinster Bildschirm: 2 Zeilen)
		Size = UDim2.new(1, 0, 1, -286),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		LayoutOrder = 7,
		Parent = right,
	}, {
		Screen.New("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	local tradeLabels = {}
	for i = 1, TRADE_ROWS do
		tradeLabels[i] = Screen.Label({
			TextSize = 20,
			Size = UDim2.new(1, 0, 0, 24),
			LayoutOrder = i,
			Parent = tradeList,
		})
	end

	------------------------------------------------------------------
	-- Erklärung zu einer Ampel (Fenster über der Coin-Seite)
	------------------------------------------------------------------
	local overlay = Screen.New("TextButton", {
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Colors.Background,
		BackgroundTransparency = 0.3,
		Visible = false,
		ZIndex = 20,
		Parent = parent,
	})
	local helpPanel = Screen.New("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0.65, 0, 1, -20),
		BackgroundColor3 = Colors.Panel,
		Active = true, -- Tippen ins Fenster schließt es nicht
		ZIndex = 21,
		Parent = overlay,
	}, {
		Screen.Corner(14),
		Screen.Padding(16),
		Screen.New("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	local function helpLabel(order: number, height: number, props)
		props.Size = UDim2.new(1, 0, 0, height)
		props.LayoutOrder = order
		props.ZIndex = 22
		props.Parent = helpPanel
		return Screen.Label(props)
	end
	local helpTitle = helpLabel(1, 32, { Font = Screen.Fonts.Bold, TextSize = 28 })
	local helpText = helpLabel(2, 80, {
		TextWrapped = true,
		TextTruncate = Enum.TextTruncate.None,
		TextYAlignment = Enum.TextYAlignment.Top,
	})
	local helpRules = {}
	for i = 1, 3 do
		helpRules[i] = helpLabel(2 + i, 26, {})
	end
	-- Pro: Top-10-Namen (2 Spalten à 5) bzw. Dev-Verkäufe; ohne Pro gesperrte Kachel "🔒 PRO"
	local proList = Screen.New("Frame", {
		Size = UDim2.new(1, 0, 0, 5 * 26),
		BackgroundTransparency = 1,
		Visible = false,
		LayoutOrder = 6,
		ZIndex = 22,
		Parent = helpPanel,
	}, {
		Screen.New("UIGridLayout", {
			CellSize = UDim2.new(0.5, -6, 0, 26),
			CellPadding = UDim2.fromOffset(6, 0),
			FillDirection = Enum.FillDirection.Vertical,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	local proRows = {}
	for i = 1, 10 do
		proRows[i] = Screen.Label({ TextSize = 20, LayoutOrder = i, ZIndex = 23, Parent = proList })
	end
	local buttonRow = Screen.New("Frame", {
		Size = UDim2.new(1, 0, 0, 72),
		BackgroundTransparency = 1,
		LayoutOrder = 10,
		ZIndex = 22,
		Parent = helpPanel,
	}, {
		Screen.New("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	local okButton = Screen.Button({
		Text = "OK",
		Size = UDim2.fromOffset(200, 72),
		LayoutOrder = 1,
		ZIndex = 22,
		Parent = buttonRow,
	})
	local proButton = Screen.Button({
		BackgroundColor3 = Colors.Accent,
		TextColor3 = Colors.Background,
		TextSize = 20,
		Size = UDim2.new(1, -208, 1, 0),
		Visible = false,
		LayoutOrder = 2,
		ZIndex = 22,
		Parent = buttonRow,
	})
	proButton.Activated:Connect(function()
		MarketClient.Buy("Pro")
	end)
	local proTop = nil -- zuletzt geladene Top-10-Liste
	local proTopCoin = nil

	updateHelp = function()
		local coin = self.CoinId and MarketClient.Coins[self.CoinId]
		if not (helpDef and coin) then
			return
		end
		local value = Indicators.Value(coin, helpDef.Id)
		local rating = Indicators.Rate(helpDef.Id, value)
		helpTitle.Text = string.format("%s: %s %s", helpDef.Title, Indicators.Display(helpDef.Id, value), RATING_DOTS[rating])
		helpTitle.TextColor3 = RATING_COLORS[rating]
		helpText.Text = helpDef.Explain
		local rules = Indicators.Rules(helpDef.Id)
		for i, label in helpRules do
			label.Text = rules[i] or ""
		end

		-- Pro-Teile: Top 10 mit Namen, Dev-Verkäufe live
		local pro = MarketClient.HasPass("Pro")
		local proTopic = helpDef.Id == "Top10" or helpDef.Id == "Dev"
		proButton.Visible = proTopic and not pro
		proButton.Text = if helpDef.Id == "Top10" then "🔒 PRO: see top 10 names" else "🔒 PRO: dev sells live"
		local showList = proTopic and pro
		proList.Visible = showList
		helpText.Visible = not showList
		for _, label in helpRules do
			label.Visible = not showList
		end
		if not showList then
			return
		end
		for _, label in proRows do
			label.Text = ""
			label.TextColor3 = Colors.Text
		end
		if helpDef.Id == "Top10" then
			if proTopCoin ~= coin.Id or not proTop then
				proRows[1].Text = "Loading…"
				return
			end
			for i, entry in proTop do
				proRows[i].Text = string.format(
					"%d. %s%s %s",
					i,
					if entry.D then "👨‍💻 " else "",
					CreatorStyle.Name(entry.N, MarketClient.CreatorTier(entry.U)),
					Indicators.Display("Top10", entry.S)
				)
				proRows[i].TextColor3 = if entry.D then Colors.Accent else Colors.Text
			end
		else
			-- Dev-Trades aus den letzten Live-Trades
			local shown = 0
			local trades = coin.Trades or {}
			for i = #trades, 1, -1 do
				local trade = trades[i]
				if MarketClient.IsDevTrade(coin, trade) and shown < 10 then
					shown += 1
					proRows[shown].Text = string.format(
						"%s %s · %s ago",
						if trade.Side == "Buy" then "🟢 bought" else "🔴 sold",
						Format.Cash(trade.Cash),
						Format.Duration(workspace:GetServerTimeNow() - (trade.Time or 0))
					)
				end
			end
			if shown == 0 then
				proRows[1].Text = "No dev trades in the last " .. Config.Market.RecentTrades .. " trades"
			end
		end
	end
	showHelp = function(def)
		helpDef = def
		updateHelp()
		overlay.Visible = true
		local coinId = self.CoinId
		if def.Id == "Top10" and coinId and MarketClient.HasPass("Pro") then
			proTop, proTopCoin = nil, coinId
			task.spawn(function()
				local list = MarketClient.ProInfo(coinId)
				if helpDef == def and self.CoinId == coinId then
					proTop = list or {}
					updateHelp()
				end
			end)
		end
	end
	local function hideHelp()
		helpDef = nil
		overlay.Visible = false
	end
	okButton.Activated:Connect(hideHelp)
	overlay.Activated:Connect(hideHelp)

	------------------------------------------------------------------
	-- Anzeige
	------------------------------------------------------------------
	function self.Show(coinId: string)
		hideHelp()
		self.CoinId = coinId
		self.Refresh()
	end

	function self.Refresh()
		local coin = self.CoinId and MarketClient.Coins[self.CoinId]
		if not coin then
			nameLabel.Text = "Coin is gone"
			priceLabel.Text = ""
			return
		end

		nameLabel.Text = string.format("%s %s  $%s", coin.Icon, coin.Name, coin.Ticker)
		local mine = coin.CreatorId == MarketClient.MyKey
		local canRug = mine and (MarketClient.Me.RugLicense or 0) > 0 and not coin.Rugged and coin.Stage ~= "Dead"
		boostButton.Visible = mine
		rugButton.Visible = canRug
		local labelWidth = if canRug then -NAME_X - 256 elseif mine then -NAME_X - 128 else -NAME_X
		local favorite = MarketClient.IsFavorite(coin.Id)
		favButton.Text = if favorite then "⭐" else "☆"
		favButton.BackgroundColor3 = if favorite then Colors.Accent else Colors.PanelLight
		if canRug then
			local t = workspace:GetServerTimeNow()
			local ageLeft = Config.Rug.MinCoinAge - (t - coin.CreatedAt)
			local cooldownLeft = (MarketClient.Me.RugReadyAt or 0) - t
			if cooldownLeft > 0 then
				rugButton.Text = "☠ RUG\n" .. Format.Duration(cooldownLeft)
			elseif ageLeft > 0 then
				rugButton.Text = "☠ RUG\nin " .. Format.Duration(ageLeft)
			else
				rugButton.Text = "☠ RUG\n" .. MarketClient.Me.RugLicense .. " left"
			end
		end
		nameLabel.Size = UDim2.new(1, labelWidth, 0, 36)
		priceLabel.Size = UDim2.new(1, labelWidth, 0, 30)
		if mine then
			local boostLeft = MarketClient.BoostLeft(coin.Id)
			local myStats = MarketClient.Me.Stats
			if boostLeft > 0 then
				boostButton.Text = "🚀 " .. Format.Duration(boostLeft)
			elseif (MarketClient.Me.FreeBoosts or 0) > 0 then
				boostButton.Text = "🚀 BOOST\nFREE ×" .. MarketClient.Me.FreeBoosts -- Bronze-Creator / Robux
			elseif not canBoostWithCash() then
				boostButton.Text = "🚀 BOOST\nR$ " .. Config.Shop.Products.Boost.Robux -- ohne Level, mit Robux
			else
				boostButton.Text = "🚀 BOOST\n" .. Format.Short(Config.Launch.BoostCost)
			end
		end
		local change = MarketClient.ChartChange(coin)
		if coin.Rugged then
			priceLabel.Text = string.format("%s  ·  RUGGED", Format.Price(coin.Price))
			priceLabel.TextColor3 = Colors.Red
		else
			priceLabel.Text = string.format("%s  %s", Format.Price(coin.Price), Format.Percent(change))
			priceLabel.TextColor3 = if change >= 0 then Colors.Green else Colors.Red
		end

		chart:SetData(coin.Chart or {}, coin.Candle)
		local pro = MarketClient.HasPass("Pro")
		if not pro and candles then
			candles = false
			chart:SetCandles(false)
		end
		candleButton.Text = if not pro then "🕯 🔒 PRO" elseif candles then "📈 LINE" else "🕯 CANDLE"

		infoLabel.Text = string.format(
			"MC %s · Migration %d%% · %s · %s · by %s",
			Format.Short(coin.MarketCap),
			math.min(100, math.floor(coin.MarketCap / Config.Curve.MigrationMarketCap * 100)),
			Format.Duration(MarketClient.Age(coin)),
			coin.Stage,
			(if MarketClient.IsFriend(coin.CreatorId) then "👥 " else "")
				.. CreatorStyle.Name(coin.CreatorName or "?", MarketClient.CreatorTier(coin.CreatorId))
		)

		for _, def in Indicators.List do
			local value = Indicators.Value(coin, def.Id)
			local rating = Indicators.Rate(def.Id, value)
			local chip = chips[def.Id]
			chip.Value.Text = Indicators.Display(def.Id, value)
			chip.Value.TextColor3 = RATING_COLORS[rating]
			chip.Stroke.Color = RATING_COLORS[rating]
		end
		if helpDef then
			updateHelp()
		end

		local position = MarketClient.Me.Positions[coin.Id]
		if position then
			local value = MarketClient.PositionValue(coin, position)
			local pnl = if position.Cost > 0 then value / position.Cost - 1 else 0
			positionLabel.Text = string.format(
				"You: %s · %s (%s)%s",
				Format.Short(position.Amount),
				Format.Cash(value),
				Format.Percent(pnl),
				if mine then " · sell max 25%/min" else "" -- Ersteller verkauft stufenweise
			)
			positionLabel.TextColor3 = if pnl >= 0 then Colors.Green else Colors.Red
		else
			positionLabel.Text = "You hold none"
			positionLabel.TextColor3 = Colors.Muted
		end

		local stats = MarketClient.Me.Stats
		local myLevel = if stats then stats.Level else 1
		local protection = Config.Protection
		if myLevel < protection.StopLossMinLevel then
			stopButton.Text = "🛑 STOP 🔒 Lv " .. protection.StopLossMinLevel
			stopButton.BackgroundColor3 = Colors.PanelLight
		else
			local sl = position and position.SL
			stopButton.Text = if sl then string.format("🛑 STOP -%d%%", math.floor(sl * 100 + 0.5)) else "🛑 STOP OFF"
			stopButton.BackgroundColor3 = if sl then Colors.Border else Colors.PanelLight
		end
		if myLevel < protection.InsuranceMinLevel then
			insureButton.Text = "🛡 INSURE 🔒 Lv " .. protection.InsuranceMinLevel
			insureButton.BackgroundColor3 = Colors.PanelLight
		else
			local on = (MarketClient.Me.Insured or {})[coin.Id] == true
			insureButton.Text = if on then "🛡 INSURED +5%" else "🛡 INSURE OFF"
			insureButton.BackgroundColor3 = if on then Colors.Border else Colors.PanelLight
		end

		local trades = coin.Trades or {}
		for i = 1, TRADE_ROWS do
			local trade = trades[#trades - i + 1]
			local label = tradeLabels[i]
			if trade then
				-- Pro: Käufe/Verkäufe des Erstellers live markiert
				local isDev = pro and MarketClient.IsDevTrade(coin, trade)
				label.Text = string.format(
					"%s%s%s %s %s",
					if isDev then "👨‍💻 DEV " else "",
					if trade.IsNpc then "🤖 " elseif MarketClient.IsFriend(trade.TraderId) then "👥 " else "",
					CreatorStyle.Name(trade.Trader or "?", MarketClient.CreatorTier(trade.TraderId), trade.Vip, trade.Legend),
					if trade.Side == "Buy" then "bought" else "sold",
					Format.Cash(trade.Cash)
				)
				label.TextColor3 = if isDev then Colors.Accent elseif trade.Side == "Buy" then Colors.Green else Colors.Red
			else
				label.Text = ""
			end
		end
	end

	return self
end

return CoinPage
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX32">
				<Properties>
					<string name="Name">CreateCoinUI</string>
					<ProtectedString name="Source"><![CDATA[-- CreateCoinUI (ModuleScript) – StarterPlayer/StarterPlayerScripts/ClientModules/CreateCoinUI
-- Formular "Coin erstellen": Name, Ticker, Beschreibung, Icon (feste Auswahl), Dev-Buy (0/10/25/50 %).
-- Unten rechts: Rug-Lizenz kaufen (Phase 7, ab Level 25, zweimal tippen zum Bestätigen).
-- Robux (Phase 8): "R$ 99" erstellt den Coin ohne Level/Cash, "R$ 299" gibt eine Lizenz ohne Level.
-- Breite Knopfzeile (kleinster Fall 798): CREATE 200 | R$ 110 | CANCEL 130 | Lizenz Cash | Lizenz R$
-- Der Server prüft alles noch einmal (Level, Cash, Regeln, Roblox-Filter, Sperrliste).
--
-- Platz: Fenster 85 % breit, 484 hoch (passt in die kleinste Höhe von 496)

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Screen = require(script.Parent.Screen)
local MarketClient = require(script.Parent.MarketClient)

local Colors = Screen.Colors
local L = Config.Launch
local RG = Config.Rug
local ICON = 46

local CreateCoinUI = {}

function CreateCoinUI.new(parent: GuiObject)
	local self = {}
	local selectedIcon = Config.CoinIcons[1]
	local devIndex = 1

	local overlay = Screen.New("TextButton", {
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Colors.Background,
		BackgroundTransparency = 0.3,
		Visible = false,
		ZIndex = 40,
		Parent = parent,
	})
	local panel = Screen.New("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0.85, 0, 0, 484),
		BackgroundColor3 = Colors.Panel,
		Active = true,
		ZIndex = 41,
		Parent = overlay,
	}, {
		Screen.Corner(14),
		Screen.Padding(16),
		Screen.New("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
	})

	local function textBox(placeholder: string, maxLength: number, size: UDim2, order: number, parentFrame)
		local box = Screen.New("TextBox", {
			PlaceholderText = placeholder,
			Text = "",
			ClearTextOnFocus = false,
			Font = Screen.Fonts.Medium,
			TextSize = 22,
			TextColor3 = Colors.Text,
			PlaceholderColor3 = Colors.Muted,
			TextXAlignment = Enum.TextXAlignment.Left,
			BackgroundColor3 = Colors.PanelLight,
			Size = size,
			LayoutOrder = order,
			ZIndex = 42,
			Parent = parentFrame,
		}, {
			Screen.Corner(10),
			Screen.New("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) }),
		})
		box:GetPropertyChangedSignal("Text"):Connect(function()
			if #box.Text > maxLength then
				box.Text = string.sub(box.Text, 1, maxLength)
			end
		end)
		return box
	end

	local function row(order: number, height: number)
		return Screen.New("Frame", {
			Size = UDim2.new(1, 0, 0, height),
			BackgroundTransparency = 1,
			LayoutOrder = order,
			ZIndex = 42,
			Parent = panel,
		}, {
			Screen.New("UIListLayout", {
				FillDirection = Enum.FillDirection.Horizontal,
				Padding = UDim.new(0, 8),
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		})
	end

	Screen.Label({
		Text = "🚀 CREATE A COIN",
		Font = Screen.Fonts.Bold,
		TextSize = 30,
		Size = UDim2.new(1, 0, 0, 36),
		LayoutOrder = 1,
		ZIndex = 42,
		Parent = panel,
	})

	local nameRow = row(2, 56)
	local nameBox = textBox(
		string.format("Name (%d-%d)", L.NameMin, L.NameMax),
		L.NameMax,
		UDim2.new(0.62, -4, 1, 0),
		1,
		nameRow
	)
	local tickerBox = textBox("TICKER (3-5)", L.TickerMax, UDim2.new(0.38, -4, 1, 0), 2, nameRow)
	tickerBox:GetPropertyChangedSignal("Text"):Connect(function()
		local upper = string.upper((string.gsub(tickerBox.Text, "[^%a]", "")))
		if upper ~= tickerBox.Text then
			tickerBox.Text = upper
		end
	end)
	local descBox = textBox(
		string.format("Short description (max. %d)", L.DescMax),
		L.DescMax,
		UDim2.new(1, 0, 0, 56),
		3,
		panel
	)

	-- Icons: 2 Reihen à 10
	local iconGrid = Screen.New("Frame", {
		Size = UDim2.new(1, 0, 0, ICON * 2 + 6),
		BackgroundTransparency = 1,
		LayoutOrder = 4,
		ZIndex = 42,
		Parent = panel,
	}, {
		Screen.New("UIGridLayout", {
			CellSize = UDim2.fromOffset(ICON, ICON),
			CellPadding = UDim2.fromOffset(6, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	local iconButtons = {}
	for i, icon in Config.CoinIcons do
		local button = Screen.Button({
			Text = icon,
			TextSize = 28,
			LayoutOrder = i,
			ZIndex = 43,
			Parent = iconGrid,
		})
		button.Activated:Connect(function()
			selectedIcon = icon
			self.Refresh()
		end)
		iconButtons[icon] = button
	end

	-- Dev-Buy
	local devRow = row(5, 56)
	Screen.Label({
		Text = "Dev buy:",
		TextSize = 22,
		Size = UDim2.new(0, 100, 1, 0),
		LayoutOrder = 0,
		ZIndex = 43,
		Parent = devRow,
	})
	local devButtons = {}
	for i, share in L.DevBuyOptions do
		local button = Screen.Button({
			Text = math.floor(share * 100 + 0.5) .. "%",
			TextSize = 22,
			Size = UDim2.new(0, 96, 1, 0),
			LayoutOrder = i,
			ZIndex = 43,
			Parent = devRow,
		})
		button.Activated:Connect(function()
			devIndex = i
			self.Refresh()
		end)
		devButtons[i] = button
	end

	local costLabel = Screen.Label({
		TextSize = 20,
		TextColor3 = Colors.Muted,
		Size = UDim2.new(1, 0, 0, 26),
		LayoutOrder = 6,
		ZIndex = 42,
		Parent = panel,
	})

	local buttonRow = row(7, 72)
	local createButton = Screen.Button({
		Text = "CREATE",
		BackgroundColor3 = Colors.Green,
		Size = UDim2.new(0, 200, 1, 0),
		LayoutOrder = 1,
		ZIndex = 43,
		Parent = buttonRow,
	})
	local robuxButton = Screen.Button({
		Text = "R$ " .. Config.Shop.Products.CreateCoin.Robux,
		TextSize = 22,
		BackgroundColor3 = Colors.Accent,
		TextColor3 = Colors.Background,
		Size = UDim2.new(0, 110, 1, 0),
		LayoutOrder = 2,
		ZIndex = 43,
		Parent = buttonRow,
	})
	local cancelButton = Screen.Button({
		Text = "CANCEL",
		Size = UDim2.new(0, 130, 1, 0),
		LayoutOrder = 3,
		ZIndex = 43,
		Parent = buttonRow,
	})

	-- Rug-Lizenz: 1. Tippen = Preis zeigen, 2. Tippen (innerhalb 4 Sek.) = kaufen
	local licenseButton = Screen.Button({
		TextSize = 20,
		BackgroundColor3 = Colors.Red,
		Size = UDim2.new(0.5, -244, 1, 0),
		LayoutOrder = 4,
		ZIndex = 43,
		Parent = buttonRow,
	})
	local licenseRobux = Screen.Button({
		Text = "☠ R$ " .. Config.Shop.Products.License.Robux,
		TextSize = 20,
		BackgroundColor3 = Colors.Red,
		Size = UDim2.new(0.5, -244, 1, 0),
		LayoutOrder = 5,
		ZIndex = 43,
		Parent = buttonRow,
	})
	licenseRobux.Activated:Connect(function()
		MarketClient.Buy("License")
	end)
	local confirmUntil = 0
	local function licenseText()
		local me = MarketClient.Me
		local level = if me.Stats then me.Stats.Level else 1
		if (me.RugLicense or 0) > 0 then
			return string.format("☠ %d rugs left", me.RugLicense), false
		elseif level < RG.MinLevel then
			return "☠ 🔒 Lv " .. RG.MinLevel, false
		elseif os.clock() < confirmUntil then
			return "TAP AGAIN", true
		end
		return string.format("☠ %s · %d rugs", Format.Short(RG.LicenseCost), RG.LicenseUses), true
	end
	-- nur den Lizenz-Knopf neu zeichnen (läuft bei jeder Änderung; lässt Fehlermeldungen im Formular stehen)
	function self.RefreshLicense()
		local text, canBuy = licenseText()
		licenseButton.Text = text
		licenseButton.BackgroundColor3 = if canBuy then Colors.Red else Colors.PanelLight
		local vouchers = MarketClient.Me.Vouchers or {}
		createButton.Text = if (vouchers.CT or 0) > 0 then "CREATE (FREE)" else "CREATE"
	end
	licenseButton.Activated:Connect(function()
		local _, canBuy = licenseText()
		if not canBuy then
			return
		end
		if os.clock() < confirmUntil then
			confirmUntil = 0
			MarketClient.BuyLicense()
		else
			confirmUntil = os.clock() + 4
			task.delay(4.1, self.RefreshLicense)
		end
		self.RefreshLicense()
	end)

	function self.Refresh()
		for icon, button in iconButtons do
			button.BackgroundColor3 = if icon == selectedIcon then Colors.Accent else Colors.PanelLight
		end
		for i, button in devButtons do
			button.BackgroundColor3 = if i == devIndex then Colors.Border else Colors.PanelLight
		end
		local cash = MarketClient.Me.Cash or 0
		local level = if MarketClient.Me.Stats then MarketClient.Me.Stats.Level else 1
		local gold = level >= L.CreateMinLevel and MarketClient.Me.Extra ~= nil and MarketClient.Me.Extra.FreeCoin == true
		local voucher = ((MarketClient.Me.Vouchers or {}).CT or 0) > 0 -- Robux-Gutschein
		local free = gold or voucher
		local fee = if free then 0 else L.CreateCost
		local devCash = math.max(0, cash - fee) * L.DevBuyOptions[devIndex]
		costLabel.Text = string.format(
			"Cost: %s + dev buy %s · you get 5%% of the coins · %s Cash",
			if gold then "FREE (Gold creator)"
				elseif voucher then "FREE (Robux)"
				elseif level < L.CreateMinLevel then string.format("Lv %d + %s, or R$", L.CreateMinLevel, Format.Short(L.CreateCost))
				else Format.Short(L.CreateCost),
			Format.Short(devCash),
			if cash >= fee then "enough" else "not enough"
		)
		costLabel.TextColor3 = if cash >= fee then Colors.Muted else Colors.Red
		self.RefreshLicense()
	end

	function self.Show()
		self.Refresh()
		overlay.Visible = true
	end

	local function hide()
		overlay.Visible = false
	end

	-- Fenster bleibt offen, bis der Server antwortet: Erfolg -> zu, Fehler -> im Fenster anzeigen (nichts neu tippen)
	local waiting = false
	local function submit()
		if waiting then
			return
		end
		waiting = true
		costLabel.Text = "Checking…"
		costLabel.TextColor3 = Colors.Muted
		MarketClient.CreateCoin(nameBox.Text, tickerBox.Text, descBox.Text, selectedIcon, devIndex)
		task.delay(8, function()
			waiting = false -- falls keine Antwort kommt: wieder klickbar
		end)
	end
	createButton.Activated:Connect(submit)
	-- Robux: Gutschein kaufen, danach automatisch erstellen (Name/Ticker bleiben im Formular)
	robuxButton.Activated:Connect(function()
		local before = (MarketClient.Me.Vouchers or {}).CT or 0
		if before > 0 then
			submit()
			return
		end
		if #nameBox.Text < L.NameMin or #tickerBox.Text < L.TickerMin then
			costLabel.Text = "❌ Enter name and ticker first"
			costLabel.TextColor3 = Colors.Red
			return
		end
		MarketClient.BuyThen("CreateCoin", function()
			return ((MarketClient.Me.Vouchers or {}).CT or 0) > before
		end, function()
			if overlay.Visible then
				submit()
			end
		end)
	end)
	MarketClient.TradeResult.Event:Connect(function(ok: boolean, message: string)
		if not waiting or not overlay.Visible then
			return
		end
		waiting = false
		if ok then
			hide()
			nameBox.Text, tickerBox.Text, descBox.Text = "", "", ""
		else
			costLabel.Text = "❌ " .. message
			costLabel.TextColor3 = Colors.Red
		end
	end)
	cancelButton.Activated:Connect(hide)

	overlay.Activated:Connect(hide)

	return self
end

return CreateCoinUI
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX33">
				<Properties>
					<string name="Name">DailyRewardUI</string>
					<ProtectedString name="Source"><![CDATA[-- DailyRewardUI (ModuleScript) – StarterPlayer/StarterPlayerScripts/ClientModules/DailyRewardUI
-- Fenster mit den 7 Tagen des Daily Rewards und CLAIM-Knopf, darunter der Creator-Code
-- (einlösen – einmal im ganzen Spiel – oder als Gold-Creator den eigenen Code wählen/sehen).
-- Der Server entscheidet alles (einmal pro Tag, Lücke = Tag 1, Code-Regeln).
--
-- Platz: Fenster 80 % breit (bei 1000 Breite ca. 100 pro Tag), 440 hoch (passt in 496)

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Screen = require(script.Parent.Screen)
local MarketClient = require(script.Parent.MarketClient)
local CreatorStyle = require(ReplicatedStorage.Shared.CreatorStyle)

local Colors = Screen.Colors
local DAYS = Config.Protection.Daily
local CR = Config.Creator

local DailyRewardUI = {}

function DailyRewardUI.new(parent: GuiObject)
	local self = {}

	local overlay = Screen.New("TextButton", {
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Colors.Background,
		BackgroundTransparency = 0.3,
		Visible = false,
		ZIndex = 30,
		Parent = parent,
	})
	local panel = Screen.New("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0.8, 0, 0, 440),
		BackgroundColor3 = Colors.Panel,
		Active = true,
		ZIndex = 31,
		Parent = overlay,
	}, {
		Screen.Corner(14),
		Screen.Padding(16),
	})
	Screen.Label({
		Text = "🎁 DAILY REWARD",
		Font = Screen.Fonts.Bold,
		TextSize = 30,
		Size = UDim2.new(1, 0, 0, 36),
		ZIndex = 32,
		Parent = panel,
	})
	local subtitle = Screen.Label({
		TextColor3 = Colors.Muted,
		Position = UDim2.fromOffset(0, 40),
		Size = UDim2.new(1, 0, 0, 26),
		ZIndex = 32,
		Parent = panel,
	})

	local row = Screen.New("Frame", {
		Position = UDim2.fromOffset(0, 76),
		Size = UDim2.new(1, 0, 0, 120),
		BackgroundTransparency = 1,
		ZIndex = 32,
		Parent = panel,
	}, {
		Screen.New("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	local boxes = {}
	for day, amount in DAYS do
		local box = Screen.New("Frame", {
			Size = UDim2.new(1 / #DAYS, -8 * (#DAYS - 1) / #DAYS, 1, 0),
			BackgroundColor3 = Colors.PanelLight,
			LayoutOrder = day,
			ZIndex = 32,
			Parent = row,
		}, {
			Screen.Corner(10),
		})
		Screen.Label({
			Text = "Day " .. day,
			TextSize = 20,
			TextColor3 = Colors.Muted,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.fromOffset(0, 10),
			Size = UDim2.new(1, 0, 0, 24),
			ZIndex = 33,
			Parent = box,
		})
		Screen.Label({
			Text = Format.Cash(amount):gsub("%.00$", ""),
			Font = Screen.Fonts.Bold,
			TextSize = 26,
			TextColor3 = Colors.Accent,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.fromOffset(0, 42),
			Size = UDim2.new(1, 0, 0, 32),
			ZIndex = 33,
			Parent = box,
		})
		local mark = Screen.Label({
			TextSize = 24,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.fromOffset(0, 80),
			Size = UDim2.new(1, 0, 0, 30),
			ZIndex = 33,
			Parent = box,
		})
		local stroke = Screen.New("UIStroke", {
			Color = Colors.Accent,
			Thickness = 3,
			Enabled = false,
			Parent = box,
		})
		boxes[day] = { Mark = mark, Stroke = stroke }
	end

	-- Creator-Code
	Screen.Label({
		Text = "🎬 CREATOR CODE",
		Font = Screen.Fonts.Bold,
		TextSize = 22,
		Position = UDim2.fromOffset(0, 206),
		Size = UDim2.new(1, 0, 0, 26),
		ZIndex = 32,
		Parent = panel,
	})
	local codeHint = Screen.Label({
		TextSize = 20,
		TextColor3 = Colors.Muted,
		Position = UDim2.fromOffset(0, 232),
		Size = UDim2.new(1, 0, 0, 24),
		ZIndex = 32,
		Parent = panel,
	})
	local codeBox = Screen.New("TextBox", {
		Text = "",
		ClearTextOnFocus = false,
		Font = Screen.Fonts.Medium,
		TextSize = 22,
		TextColor3 = Colors.Text,
		PlaceholderColor3 = Colors.Muted,
		TextXAlignment = Enum.TextXAlignment.Left,
		BackgroundColor3 = Colors.PanelLight,
		Position = UDim2.fromOffset(0, 262),
		Size = UDim2.new(1, -228, 0, 72),
		ZIndex = 32,
		Parent = panel,
	}, {
		Screen.Corner(10),
		Screen.New("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) }),
	})
	codeBox:GetPropertyChangedSignal("Text"):Connect(function()
		local clean = string.sub(string.upper((string.gsub(codeBox.Text, "[^%w]", ""))), 1, CR.CodeMax)
		if clean ~= codeBox.Text then
			codeBox.Text = clean
		end
	end)
	local codeButton = Screen.Button({
		Text = "REDEEM",
		BackgroundColor3 = Colors.Accent,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 262),
		Size = UDim2.fromOffset(216, 72),
		ZIndex = 32,
		Parent = panel,
	})
	local myCodeLabel = Screen.Label({
		Font = Screen.Fonts.Bold,
		TextSize = 26,
		TextColor3 = CreatorStyle.Gold,
		Position = UDim2.fromOffset(0, 262),
		Size = UDim2.new(1, 0, 0, 72),
		Visible = false,
		ZIndex = 32,
		Parent = panel,
	})
	local codeMode = "redeem" -- "redeem" / "choose" / "none"

	local claim = Screen.Button({
		Text = "CLAIM",
		BackgroundColor3 = Colors.Green,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.fromOffset(260, 72),
		ZIndex = 32,
		Parent = panel,
	})
	local close = Screen.Button({
		Text = "CLOSE",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.fromScale(1, 1),
		Size = UDim2.fromOffset(160, 72),
		ZIndex = 32,
		Parent = panel,
	})

	function self.Refresh()
		local daily = MarketClient.Me.Daily
		if not daily then
			subtitle.Text = "Loading…"
			claim.Visible = false
			return
		end
		claim.Visible = daily.CanClaim
		subtitle.Text = if daily.CanClaim
			then string.format("Day %d is ready! Miss a day and you start again at day 1.", daily.Next)
			else "Claimed today. Come back tomorrow for day " .. daily.Next .. "."
		for day, box in boxes do
			local done = day <= daily.Streak
			box.Mark.Text = if done then "✅" else ""
			box.Stroke.Enabled = daily.CanClaim and day == daily.Next
		end

		-- Creator-Code: Gold -> eigener Code, sonst einlösen (einmal im ganzen Spiel)
		local extra = MarketClient.Me.Extra or {}
		if (extra.Tier or 0) >= 4 then
			codeMode = if extra.Code then "none" else "choose"
			myCodeLabel.Text = if extra.Code then "Your code: " .. extra.Code else ""
			codeHint.Text = if extra.Code
				then string.format("Used %d times · you get %d Cash per use (max. %d per day)", extra.Uses or 0, CR.CreatorPerRedeem, CR.CreatorDailyCap)
				else string.format("Pick your own code (%d-%d letters/numbers). You can choose it only once!", CR.CodeMin, CR.CodeMax)
		elseif extra.Redeemed then
			codeMode = "none"
			myCodeLabel.Text = "✅ Code " .. extra.Redeemed .. " used"
			codeHint.Text = "Every player can use one creator code."
		else
			codeMode = "redeem"
			if extra.AccountOk == false then
				codeHint.Text = string.format("Your Roblox account must be at least %d days old.", CR.MinAccountAgeDays)
			elseif (extra.PlaytimeLeft or 0) > 0 then
				codeHint.Text = string.format("Play %d more minutes to use a code.", math.ceil(extra.PlaytimeLeft / 60))
			else
				codeHint.Text = string.format("Enter a creator code: +%s Cash (only once!)", Format.Short(CR.CodeReward))
			end
		end
		codeBox.Visible = codeMode ~= "none"
		codeButton.Visible = codeMode ~= "none"
		myCodeLabel.Visible = codeMode == "none"
		codeButton.Text = if codeMode == "choose" then "SET CODE" else "REDEEM"
		codeBox.PlaceholderText = if codeMode == "choose" then "YOUR CODE" else "CODE"
	end

	function self.Show()
		self.Refresh()
		overlay.Visible = true
	end

	function self.Hide()
		overlay.Visible = false
	end

	claim.Activated:Connect(function()
		MarketClient.ClaimDaily()
		self.Hide()
	end)
	codeButton.Activated:Connect(function()
		local code = codeBox.Text
		if #code < CR.CodeMin then
			codeHint.Text = string.format("Code: %d to %d letters/numbers", CR.CodeMin, CR.CodeMax)
			return
		end
		if codeMode == "choose" then
			MarketClient.SetCreatorCode(code)
		elseif codeMode == "redeem" then
			MarketClient.RedeemCode(code)
		end
		codeBox.Text = ""
	end)
	close.Activated:Connect(self.Hide)
	overlay.Activated:Connect(self.Hide)

	return self
end

return DailyRewardUI
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX34">
				<Properties>
					<string name="Name">LeaderboardUI</string>
					<ProtectedString name="Source"><![CDATA[-- LeaderboardUI (ModuleScript) – StarterPlayer/StarterPlayerScripts/ClientModules/LeaderboardUI
-- Ranglisten: WORLD (Top 50 aller Server) oder SERVER (Spieler auf diesem Server),
-- Zeitraum ALL TIME (Vermögen, PNL, bester Trade) / WEEK / TODAY (PNL, bester Trade).
--
-- Platz (kleinster Fall 976 x 368): Schalter 64 | 10 | Spalten (Titel 30, Liste, "You" 28)

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Screen = require(script.Parent.Screen)
local MarketClient = require(script.Parent.MarketClient)
local CreatorStyle = require(ReplicatedStorage.Shared.CreatorStyle)

local Colors = Screen.Colors
local ROW = 30

local PERIODS = {
	{ Id = "All", Label = "ALL TIME", Boards = { "Wealth", "Pnl", "Best" } },
	{ Id = "Week", Label = "WEEK", Boards = { "WeekPnl", "WeekBest" } },
	{ Id = "Day", Label = "TODAY", Boards = { "DayPnl", "DayBest" } },
}
local TITLES = {
	Wealth = "Net worth",
	Pnl = "PnL (realized)",
	Best = "Best trade",
	WeekPnl = "PnL this week",
	WeekBest = "Best trade this week",
	DayPnl = "PnL today",
	DayBest = "Best trade today",
}

local LeaderboardUI = {}

function LeaderboardUI.new(parent: GuiObject)
	local self = {}
	local scope = "World"
	local period = PERIODS[1]

	-- Schalter oben
	local controls = Screen.New("Frame", {
		Size = UDim2.new(1, 0, 0, 64),
		BackgroundTransparency = 1,
		Parent = parent,
	}, {
		Screen.New("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 10),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	local scopeButtons, periodButtons = {}, {}
	local function styleButtons()
		for id, button in scopeButtons do
			button.BackgroundColor3 = if id == scope then Colors.Border else Colors.PanelLight
		end
		for id, button in periodButtons do
			button.BackgroundColor3 = if id == period.Id then Colors.Border else Colors.PanelLight
		end
	end
	for i, id in { "World", "Server" } do
		local button = Screen.Button({
			Text = string.upper(id),
			TextSize = 22,
			Size = UDim2.new(0, 130, 1, 0),
			LayoutOrder = i,
			Parent = controls,
		})
		button.Activated:Connect(function()
			scope = id
			self.Refresh()
		end)
		scopeButtons[id] = button
	end
	Screen.New("Frame", { Size = UDim2.new(0, 20, 1, 0), BackgroundTransparency = 1, LayoutOrder = 3, Parent = controls })
	for i, def in PERIODS do
		local button = Screen.Button({
			Text = def.Label,
			TextSize = 22,
			Size = UDim2.new(0, 150, 1, 0),
			LayoutOrder = 3 + i,
			Parent = controls,
		})
		button.Activated:Connect(function()
			period = def
			self.Refresh()
		end)
		periodButtons[def.Id] = button
	end

	-- Bis zu 3 Spalten
	local area = Screen.New("Frame", {
		Position = UDim2.fromOffset(0, 74),
		Size = UDim2.new(1, 0, 1, -74),
		BackgroundTransparency = 1,
		Parent = parent,
	})
	local hint = Screen.Label({
		TextColor3 = Colors.Muted,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, 30),
		Position = UDim2.fromOffset(0, 40),
		Visible = false,
		Parent = area,
	})
	local columns = {}
	for i = 1, 3 do
		local column = Screen.New("Frame", {
			BackgroundColor3 = Colors.Panel,
			Parent = area,
		}, {
			Screen.Corner(12),
		})
		local title = Screen.Label({
			Font = Screen.Fonts.Bold,
			TextColor3 = Colors.Muted,
			Position = UDim2.fromOffset(12, 4),
			Size = UDim2.new(1, -24, 0, 30),
			Parent = column,
		})
		local list = Screen.Scroller({
			Position = UDim2.fromOffset(8, 36),
			Size = UDim2.new(1, -16, 1, -36 - 34),
			Parent = column,
		})
		list:FindFirstChildOfClass("UIListLayout").Padding = UDim.new(0, 0)
		local you = Screen.Label({
			Font = Screen.Fonts.Bold,
			TextColor3 = Colors.Accent,
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new(0, 12, 1, -4),
			Size = UDim2.new(1, -24, 0, 28),
			Parent = column,
		})
		columns[i] = { Frame = column, Title = title, List = list, You = you, Rows = {} }
	end

	local function row(column, index: number)
		local entry = column.Rows[index]
		if entry then
			entry.Frame.Visible = true
			return entry
		end
		local frame = Screen.New("Frame", {
			Size = UDim2.new(1, -8, 0, ROW),
			BackgroundTransparency = 1,
			LayoutOrder = index,
			Parent = column.List,
		})
		entry = {
			Frame = frame,
			Name = Screen.Label({ Size = UDim2.new(1, -110, 1, 0), TextSize = 20, Parent = frame }),
			Value = Screen.Label({
				TextSize = 20,
				Font = Screen.Fonts.Bold,
				TextXAlignment = Enum.TextXAlignment.Right,
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.fromScale(1, 0),
				Size = UDim2.new(0, 105, 1, 0),
				Parent = frame,
			}),
		}
		column.Rows[index] = entry
		return entry
	end

	-- Eigene Werte (Client rechnet nur zur Anzeige)
	local function myValue(board: string): number
		local me = MarketClient.Me
		if board == "Wealth" then
			local total = me.Cash or 0
			for coinId, position in me.Positions or {} do
				local coin = MarketClient.Coins[coinId]
				if coin then
					total += MarketClient.PositionValue(coin, position)
				end
			end
			return total
		end
		local stats = me.Stats or {}
		return stats[board] or 0
	end

	function self.Refresh()
		styleButtons()
		local boards = MarketClient.Leaderboard[scope]
		local count = #period.Boards
		hint.Visible = boards == nil
		hint.Text = if scope == "World"
			then "World ranking loads every minute (not available in Studio test mode)."
			else "Loading…"
		for i, column in columns do
			local board = period.Boards[i]
			column.Frame.Visible = board ~= nil and boards ~= nil
			if not board then
				continue
			end
			column.Frame.Size = UDim2.new(1 / count, -8 * (count - 1) / count, 1, 0)
			column.Frame.Position = UDim2.new((i - 1) / count, 8 * (i - 1) / count, 0, 0)
			column.Title.Text = TITLES[board]
			column.You.Text = "You: " .. Format.Cash(myValue(board))
			local list = (boards and boards[board]) or {}
			for index, entry in list do
				local r = row(column, index)
				local tier = MarketClient.CreatorTier(entry.U)
				r.Name.Text = index
					.. ". "
					.. (if MarketClient.IsFriend(entry.U) then "👥 " else "")
					.. CreatorStyle.Name(entry.N, tier, entry.P, entry.G) -- P = VIP, G = Legend
				r.Value.Text = Format.Short(entry.V)
				r.Value.TextColor3 = if entry.V >= 0 then Colors.Green else Colors.Red
				r.Name.TextColor3 = CreatorStyle.Color(tier, entry.P) or (if index <= 3 then Colors.Accent else Colors.Text)
			end
			for index = #list + 1, #column.Rows do
				column.Rows[index].Frame.Visible = false
			end
		end
	end

	return self
end

return LeaderboardUI
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX35">
				<Properties>
					<string name="Name">MarketClient</string>
					<ProtectedString name="Source"><![CDATA[-- MarketClient (ModuleScript) – StarterPlayer/StarterPlayerScripts/ClientModules/MarketClient
-- Empfängt alle Markt-Daten vom Server und hält sie für die Bildschirme bereit.
-- Rechnet nichts Echtes: Werte hier sind nur Anzeige. Trades entscheidet der Server.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Curve = require(ReplicatedStorage.Shared.BondingCurve)

local FEE_TOTAL = Config.Fees.Creator + Config.Fees.Burn
local MAX_TRADES = Config.Market.RecentTrades

local MarketClient = {}

MarketClient.Coins = {} -- [coinId] = Info vom Server (+ Chart, Trades)
MarketClient.Me = { Cash = 0, Positions = {}, Stats = nil }
MarketClient.Leaderboard = { World = nil, Server = nil } -- Ranglisten vom Server
MarketClient.Boosts = {} -- [coinId] = bis (Server-Zeit)
MarketClient.MyKey = tostring(Players.LocalPlayer.UserId) -- vergleichbar mit coin.CreatorId
MarketClient.Creators = {} -- [Spieler-Schlüssel] = Creator-Stufe (1-4), vom Server
MarketClient.Friends = {} -- [Spieler-Schlüssel] = true: Roblox-Freunde (👥)

-- Signale für die Bildschirme
MarketClient.Changed = Instance.new("BindableEvent") -- Markt oder eigene Daten geändert
MarketClient.TradeResult = Instance.new("BindableEvent") -- (ok, message)
MarketClient.News = Instance.new("BindableEvent") -- (news) z. B. Rugpull, großer Gewinn
MarketClient.AdminResult = Instance.new("BindableEvent") -- ({ Ok, Message, Log }) nur für Admins
MarketClient.Purchased = Instance.new("BindableEvent") -- (name, gekauft?) nach einem Robux-Kauf-Fenster

local tradeRequest: RemoteEvent
local remotes: Instance

local function addTrade(coin, trade)
	coin.Trades = coin.Trades or {}
	table.insert(coin.Trades, trade)
	if #coin.Trades > MAX_TRADES then
		table.remove(coin.Trades, 1)
	end
end

-- Neue Chart-Punkte anhängen (T = laufende Nummer, doppelte werden ignoriert)
local function addPoints(coin, points)
	coin.Chart = coin.Chart or {}
	for _, point in points do
		local last = coin.Chart[#coin.Chart]
		if not last or point.T > last.T then
			table.insert(coin.Chart, point)
		end
	end
	while #coin.Chart > Config.Market.ChartPoints do
		table.remove(coin.Chart, 1)
	end
end

local function applyUpdate(update)
	for _, info in update.Coins do
		local coin = MarketClient.Coins[info.Id]
		if not coin then
			coin = { Chart = {}, Trades = {} }
			MarketClient.Coins[info.Id] = coin
		end
		addPoints(coin, info.NewPoints or {})
		for key, value in info do
			if key ~= "NewPoints" then
				coin[key] = value
			end
		end
	end
	for _, id in update.Removed or {} do
		MarketClient.Coins[id] = nil
	end
	for _, trade in update.Trades or {} do
		local coin = MarketClient.Coins[trade.CoinId]
		if coin then
			addTrade(coin, trade)
			-- Pro: Warnung, wenn der Ersteller eines Coins verkauft, den man hält
			local held = MarketClient.Me.Positions ~= nil and MarketClient.Me.Positions[trade.CoinId] ~= nil
			local devSold = trade.Side == "Sell" and trade.TraderId ~= MarketClient.MyKey and MarketClient.IsDevTrade(coin, trade)
			if devSold and held and MarketClient.HasPass("Pro") then
				local text = string.format("⚠ PRO: Dev sold $%s for %d Cash", coin.Ticker, math.floor(trade.Cash or 0))
				MarketClient.TradeResult:Fire(false, text)
			end
		end
	end
	if update.Boosts then
		MarketClient.Boosts = update.Boosts
	end
	for _, news in update.News or {} do
		MarketClient.News:Fire(news)
	end
end

------------------------------------------------------------------------
-- Hilfen für die Bildschirme
------------------------------------------------------------------------

function MarketClient.Trade(coinId: string, side: string, fraction: number)
	tradeRequest:FireServer(coinId, side, fraction)
end

-- Schutz (Phase 5): der Server prüft Level und Besitz
function MarketClient.ClaimDaily()
	local remote = remotes:WaitForChild("ClaimDaily") :: RemoteEvent
	remote:FireServer()
end

-- index: 0 = aus, 1..4 = Config.Protection.StopLossLevels
function MarketClient.SetStopLoss(coinId: string, index: number)
	local remote = remotes:WaitForChild("SetStopLoss") :: RemoteEvent
	remote:FireServer(coinId, index)
end

-- Coin erstellen / boosten (Server prüft Level, Cash, Namen, Filter)
function MarketClient.CreateCoin(name: string, ticker: string, desc: string, icon: string, devIndex: number)
	local remote = remotes:WaitForChild("CreateCoin") :: RemoteEvent
	remote:FireServer(name, ticker, desc, icon, devIndex)
end

function MarketClient.Boost(coinId: string)
	local remote = remotes:WaitForChild("BoostCoin") :: RemoteEvent
	remote:FireServer(coinId)
end

-- Rugpull (Phase 7): ein Klick, Server prüft Lizenz, Level, Alter, Cooldown
function MarketClient.RugPull(coinId: string)
	local remote = remotes:WaitForChild("RugPull") :: RemoteEvent
	remote:FireServer(coinId)
end

function MarketClient.BuyLicense()
	local remote = remotes:WaitForChild("BuyLicense") :: RemoteEvent
	remote:FireServer()
end

-- Restzeit eines Boosts in Sek. (0 = nicht geboostet)
function MarketClient.BoostLeft(coinId: string): number
	local untilTime = MarketClient.Boosts[coinId]
	return if untilTime then math.max(0, untilTime - workspace:GetServerTimeNow()) else 0
end

function MarketClient.SetInsurance(coinId: string, on: boolean)
	local remote = remotes:WaitForChild("SetInsurance") :: RemoteEvent
	remote:FireServer(coinId, on)
end

-- Creator-Programm (der Server prüft alles: Admin, Gold-Stufe, Konto-Alter, Spielzeit, einmal pro Spieler)
function MarketClient.CreatorTier(key: any): number
	return if key ~= nil then MarketClient.Creators[tostring(key)] or 0 else 0
end

function MarketClient.RedeemCode(code: string)
	local remote = remotes:WaitForChild("RedeemCode") :: RemoteEvent
	remote:FireServer(code)
end

function MarketClient.SetCreatorCode(code: string)
	local remote = remotes:WaitForChild("SetCreatorCode") :: RemoteEvent
	remote:FireServer(code)
end

-- action: "grant" / "revoke"
function MarketClient.AdminAction(action: string, name: string, tier: number?, video: string?)
	local remote = remotes:WaitForChild("AdminAction") :: RemoteEvent
	remote:FireServer(action, name, tier, video)
end

-- letzte 10 Admin-Aktionen (nil, wenn kein Admin)
function MarketClient.AdminLog()
	local remote = remotes:WaitForChild("AdminLog") :: RemoteFunction
	local ok, log = pcall(remote.InvokeServer, remote)
	return if ok then log else nil
end

-- Robux (Phase 8). name = Schlüssel aus Config.Shop.Products/Passes
function MarketClient.HasPass(name: string): boolean
	return MarketClient.Me.Passes ~= nil and MarketClient.Me.Passes[name] == true
end

function MarketClient.Buy(name: string)
	local shop = Config.Shop
	local product, pass = shop.Products[name], shop.Passes[name]
	local item = product or pass
	if not item then
		return
	end
	if item.Id == 0 then
		if RunService:IsStudio() then
			-- noch nicht angelegt: Studio-Test (Server prüft, dass es Studio ist)
			local remote = remotes:WaitForChild("ShopTestBuy") :: RemoteEvent
			remote:FireServer(name)
			MarketClient.Purchased:Fire(name, true)
		else
			MarketClient.TradeResult:Fire(false, "Coming soon")
		end
		return
	end
	if product then
		MarketplaceService:PromptProductPurchase(Players.LocalPlayer, item.Id)
	else
		MarketplaceService:PromptGamePassPurchase(Players.LocalPlayer, item.Id)
	end
end

-- Kaufen und danach automatisch weitermachen: wartet (max. 60 Sek.), bis ready() stimmt, dann action()
function MarketClient.BuyThen(name: string, ready: () -> boolean, action: () -> ())
	local done = false
	local connection
	connection = MarketClient.Purchased.Event:Connect(function(boughtName: string, purchased: boolean)
		if boughtName ~= name or done then
			return
		end
		done = true
		connection:Disconnect()
		if not purchased then
			return
		end
		task.spawn(function()
			local started = os.clock()
			while not ready() and os.clock() - started < 60 do
				MarketClient.Changed.Event:Wait()
			end
			if ready() then
				action()
			end
		end)
	end)
	task.delay(300, function() -- Kauf-Fenster nie beantwortet: aufräumen
		if not done then
			done = true
			connection:Disconnect()
		end
	end)
	MarketClient.Buy(name)
end

-- Pro: Top 10 Holder mit Namen { { N, S, D, U } } oder nil
function MarketClient.ProInfo(coinId: string)
	local remote = remotes:WaitForChild("ProInfo") :: RemoteFunction
	local ok, list = pcall(remote.InvokeServer, remote, coinId)
	return if ok then list else nil
end

-- Einstellung speichern: "Tutorial" (erledigt) oder "Mute" (true/false)
function MarketClient.SetFlag(name: string, value: boolean?)
	local remote = remotes:WaitForChild("SetFlag") :: RemoteEvent
	remote:FireServer(name, value)
end

-- Favoriten ⭐
function MarketClient.IsFavorite(coinId: string): boolean
	return table.find(MarketClient.Me.Favorites or {}, coinId) ~= nil
end

function MarketClient.SetFavorite(coinId: string, on: boolean)
	-- sofort anzeigen, der Server bestätigt mit dem nächsten Spieler-Zustand
	local list = table.clone(MarketClient.Me.Favorites or {})
	local index = table.find(list, coinId)
	if on and not index then
		table.insert(list, coinId)
	elseif not on and index then
		table.remove(list, index)
	end
	MarketClient.Me.Favorites = list
	MarketClient.Changed:Fire()
	local remote = remotes:WaitForChild("SetFavorite") :: RemoteEvent
	remote:FireServer(coinId, on)
end

-- Trade-Verlauf (eigene Trades, max. 500) oder nil
function MarketClient.TradeLog()
	local remote = remotes:WaitForChild("TradeLog") :: RemoteFunction
	local ok, list = pcall(remote.InvokeServer, remote)
	return if ok then list else nil
end

-- Roblox-Freund? (key = UserId als Text oder Zahl)
function MarketClient.IsFriend(key: any): boolean
	return key ~= nil and MarketClient.Friends[tostring(key)] == true
end

-- Freundesliste einmal laden (max. 200, Seite für Seite)
local function loadFriends()
	local ok, pages = pcall(Players.GetFriendsAsync, Players, Players.LocalPlayer.UserId)
	if not ok then
		return
	end
	for _ = 1, 10 do
		for _, friend in pages:GetCurrentPage() do
			MarketClient.Friends[tostring(friend.Id)] = true
		end
		if pages.IsFinished then
			break
		end
		if not pcall(pages.AdvanceToNextPageAsync, pages) then
			break
		end
	end
	MarketClient.Changed:Fire()
end

-- Ist dieser Trade ein Verkauf/Kauf des Erstellers?
function MarketClient.IsDevTrade(coin, trade): boolean
	if trade.TraderId then
		return trade.TraderId == coin.CreatorId
	end
	return trade.IsNpc == true and trade.Trader == coin.CreatorName
end

-- Wert einer Position = was man jetzt beim Verkaufen bekäme (nach Gebühr)
function MarketClient.PositionValue(coin, position): number
	return Curve.CashForTokens(Config.Curve, coin.Supply, position.Amount) * (1 - FEE_TOTAL)
end

-- Kursänderung über den ganzen Chart (ca. 5 Min.)
function MarketClient.ChartChange(coin): number
	local first = coin.Chart and coin.Chart[1]
	local base = if first then first.O else (coin.Candle and coin.Candle.O)
	if not base or base <= 0 then
		return 0
	end
	return coin.Price / base - 1
end

function MarketClient.Age(coin): number
	return workspace:GetServerTimeNow() - coin.CreatedAt
end

------------------------------------------------------------------------

function MarketClient.Start()
	remotes = ReplicatedStorage:WaitForChild("Remotes")
	tradeRequest = remotes:WaitForChild("TradeRequest") :: RemoteEvent
	local getSnapshot = remotes:WaitForChild("GetMarketSnapshot") :: RemoteFunction
	local marketUpdate = remotes:WaitForChild("MarketUpdate") :: RemoteEvent
	local playerState = remotes:WaitForChild("PlayerState") :: RemoteEvent
	local tradeResult = remotes:WaitForChild("TradeResult") :: RemoteEvent
	local leaderboard = remotes:WaitForChild("Leaderboard") :: RemoteEvent

	leaderboard.OnClientEvent:Connect(function(data)
		if data.World then
			MarketClient.Leaderboard.World = data.World
		end
		if data.Server then
			MarketClient.Leaderboard.Server = data.Server
		end
		MarketClient.Changed:Fire()
	end)

	marketUpdate.OnClientEvent:Connect(function(update)
		applyUpdate(update)
		MarketClient.Changed:Fire()
	end)
	playerState.OnClientEvent:Connect(function(state)
		MarketClient.Me = state
		MarketClient.Changed:Fire()
	end)
	tradeResult.OnClientEvent:Connect(function(result)
		MarketClient.TradeResult:Fire(result.Ok, result.Message)
	end)
	task.spawn(loadFriends)
	local creators = remotes:WaitForChild("Creators") :: RemoteEvent
	creators.OnClientEvent:Connect(function(tiers)
		MarketClient.Creators = if type(tiers) == "table" then tiers else {}
		MarketClient.Changed:Fire()
	end)
	MarketplaceService.PromptProductPurchaseFinished:Connect(function(userId, productId, purchased)
		if userId ~= Players.LocalPlayer.UserId then
			return
		end
		for name, product in Config.Shop.Products do
			if product.Id == productId then
				MarketClient.Purchased:Fire(name, purchased)
			end
		end
	end)
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if player ~= Players.LocalPlayer then
			return
		end
		for name, pass in Config.Shop.Passes do
			if pass.Id == passId then
				MarketClient.Purchased:Fire(name, purchased)
			end
		end
	end)
	local adminResult = remotes:WaitForChild("AdminResult") :: RemoteEvent
	adminResult.OnClientEvent:Connect(function(result)
		MarketClient.AdminResult:Fire(result)
	end)

	-- Erste Daten holen (mit Wiederholung, falls der Server noch startet)
	task.spawn(function()
		for _ = 1, 5 do
			local ok, snapshot = pcall(getSnapshot.InvokeServer, getSnapshot)
			if ok and snapshot then
				for _, info in snapshot.Coins do
					local coin = MarketClient.Coins[info.Id] or {}
					for key, value in info do
						coin[key] = value
					end
					coin.NewPoints = nil
					MarketClient.Coins[info.Id] = coin
				end
				if snapshot.Me then
					MarketClient.Me = snapshot.Me
				end
				MarketClient.Boosts = snapshot.Boosts or {}
				MarketClient.Changed:Fire()
				return
			end
			task.wait(1)
		end
	end)
end

return MarketClient
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX36">
				<Properties>
					<string name="Name">Portfolio</string>
					<ProtectedString name="Source"><![CDATA[-- Portfolio (ModuleScript) – StarterPlayer/StarterPlayerScripts/ClientModules/Portfolio
-- Zwei Ansichten:
--   POSITIONS: Cash, Wert der Coins, offene Positionen mit Gewinn/Verlust, Level
--   HISTORY:   eigene Trades mit Gewinn/Verlust für TODAY / WEEK / ALL (UTC, wie die Ranglisten)
-- Platz (kleinster Fall 976 x 368): Kopfzeile 72 (Werte + Knöpfe rechts) | 12 | Liste (Rest, mind. 284)

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Format = require(ReplicatedStorage.Shared.Format)
local Screen = require(script.Parent.Screen)
local MarketClient = require(script.Parent.MarketClient)
local Levels = require(ReplicatedStorage.Shared.Levels)

local Colors = Screen.Colors
local ROW_HEIGHT = 88
local LOG_ROW = 44
local HEAD = 72
local PERIODS = { "TODAY", "WEEK", "ALL" }
local SIDE_TEXT = { Buy = "BUY", Sell = "SELL", Rug = "☠ RUG", Dev = "DEV BUY", SL = "STOP-LOSS" }

local Portfolio = {}

-- Tag/Woche wie Ledger.PeriodKeys (UTC, Woche ab Montag)
local function periodKeys(t: number): (number, number)
	local day = math.floor(t / 86400)
	return day, math.floor((day + 3) / 7)
end

-- parent: Seite, onOpenCoin(coinId): Coin-Seite öffnen
function Portfolio.new(parent: GuiObject, onOpenCoin: (string) -> ())
	local self = {}
	local rows = {} -- [coinId] = row
	local mode = "Positions"
	local periodIndex = 1
	local log = nil -- zuletzt geladener Verlauf
	local loading = false

	-- Kopfzeile: Werte links, Knöpfe rechts
	local function statsPanel(rightSpace: number)
		return Screen.New("Frame", {
			Size = UDim2.new(1, -rightSpace, 0, HEAD),
			BackgroundColor3 = Colors.Panel,
			Parent = parent,
		}, {
			Screen.Corner(12),
			Screen.Padding(12),
			Screen.New("UIListLayout", {
				FillDirection = Enum.FillDirection.Horizontal,
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		})
	end
	local function stat(panel, count: number, order: number, title: string)
		local box = Screen.New("Frame", {
			Size = UDim2.fromScale(1 / count, 1),
			BackgroundTransparency = 1,
			LayoutOrder = order,
			Parent = panel,
		})
		local titleLabel = Screen.Label({
			Text = title,
			TextSize = 20,
			TextColor3 = Colors.Muted,
			Size = UDim2.new(1, -8, 0, 22),
			Parent = box,
		})
		local value = Screen.Label({
			Font = Screen.Fonts.Bold,
			TextSize = 24,
			Position = UDim2.fromOffset(0, 22),
			Size = UDim2.new(1, -8, 0, 26),
			Parent = box,
		})
		return value, titleLabel
	end
	local function headButton(text: string, width: number, right: number)
		return Screen.Button({
			Text = text,
			TextSize = 20,
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -right, 0, 0),
			Size = UDim2.fromOffset(width, HEAD),
			Parent = parent,
		})
	end

	------------------------------------------------------------------
	-- POSITIONS
	------------------------------------------------------------------
	local summary = statsPanel(170)
	local cashValue = stat(summary, 5, 1, "Cash")
	local positionsValue = stat(summary, 5, 2, "In coins")
	local totalValue = stat(summary, 5, 3, "Total")
	local pnlValue = stat(summary, 5, 4, "Open P/L")
	local levelValue, levelTitle = stat(summary, 5, 5, "Level")
	local historyButton = headButton("📜 HISTORY", 160, 0)

	local list = Screen.Scroller({
		Position = UDim2.fromOffset(0, HEAD + 12),
		Size = UDim2.new(1, 0, 1, -(HEAD + 12)),
		Parent = parent,
	})
	local emptyLabel = Screen.Label({
		Text = "No positions yet. Buy a coin in PULSE.",
		TextColor3 = Colors.Muted,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(0, 120),
		Size = UDim2.new(1, 0, 0, 30),
		Parent = parent,
	})

	------------------------------------------------------------------
	-- HISTORY
	------------------------------------------------------------------
	local historySummary = statsPanel(260)
	local tradesValue = stat(historySummary, 4, 1, "Trades")
	local realizedValue = stat(historySummary, 4, 2, "Realized P/L")
	local winValue = stat(historySummary, 4, 3, "Win rate")
	local bestValue = stat(historySummary, 4, 4, "Best trade")
	local periodButton = headButton("TODAY", 120, 130)
	local backButton = headButton("◀ BACK", 120, 0)

	local logList = Screen.Scroller({
		Position = UDim2.fromOffset(0, HEAD + 12),
		Size = UDim2.new(1, 0, 1, -(HEAD + 12)),
		Parent = parent,
	})
	local logEmpty = Screen.Label({
		TextColor3 = Colors.Muted,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(0, 120),
		Size = UDim2.new(1, 0, 0, 30),
		Parent = parent,
	})
	local logRows = {}

	local function logRow(index: number)
		local row = logRows[index]
		if row then
			row.Frame.Visible = true
			return row
		end
		local frame = Screen.New("Frame", {
			Size = UDim2.new(1, -10, 0, LOG_ROW),
			BackgroundColor3 = Colors.Panel,
			LayoutOrder = index,
			Parent = logList,
		}, {
			Screen.Corner(8),
		})
		row = {
			Frame = frame,
			Left = Screen.Label({
				TextSize = 20,
				Position = UDim2.fromOffset(12, 0),
				Size = UDim2.new(0.6, -12, 1, 0),
				Parent = frame,
			}),
			Right = Screen.Label({
				Font = Screen.Fonts.Bold,
				TextSize = 20,
				TextXAlignment = Enum.TextXAlignment.Right,
				Position = UDim2.fromScale(0.6, 0),
				Size = UDim2.new(0.4, -12, 1, 0),
				Parent = frame,
			}),
		}
		logRows[index] = row
		return row
	end

	-- Einträge des gewählten Zeitraums, neueste zuerst
	local function entriesInPeriod()
		local result = {}
		if not log then
			return result
		end
		local day, week = periodKeys(workspace:GetServerTimeNow())
		local period = PERIODS[periodIndex]
		for i = #log, 1, -1 do
			local entry = log[i]
			local eDay, eWeek = periodKeys(entry.At or 0)
			if period == "ALL" or (period == "TODAY" and eDay == day) or (period == "WEEK" and eWeek == week) then
				table.insert(result, entry)
			end
		end
		return result
	end

	local function refreshHistory()
		periodButton.Text = PERIODS[periodIndex] .. " ▸"
		local entries = entriesInPeriod()
		local realized, wins, sells, best = 0, 0, 0, nil
		for _, entry in entries do
			if entry.P then
				realized += entry.P
				sells += 1
				if entry.P > 0 then
					wins += 1
				end
				best = if best then math.max(best, entry.P) else entry.P
			end
		end
		tradesValue.Text = tostring(#entries)
		realizedValue.Text = (if realized >= 0 then "+" else "") .. Format.Cash(realized)
		realizedValue.TextColor3 = if realized >= 0 then Colors.Green else Colors.Red
		winValue.Text = if sells > 0 then string.format("%d%%", math.floor(wins / sells * 100 + 0.5)) else "–"
		bestValue.Text = if best then (if best >= 0 then "+" else "") .. Format.Cash(best) else "–"
		bestValue.TextColor3 = if best and best < 0 then Colors.Red else Colors.Green

		logEmpty.Visible = #entries == 0
		logEmpty.Text = if loading and not log then "Loading…" else "No trades in this period."
		local today = periodKeys(workspace:GetServerTimeNow())
		for i, entry in entries do
			local row = logRow(i)
			local at = entry.At or 0
			local when = os.date(if periodKeys(at) == today then "%H:%M" else "%d.%m. %H:%M", at)
			row.Left.Text = string.format(
				"%s  %s %s%s",
				when,
				SIDE_TEXT[entry.S] or tostring(entry.S),
				entry.I or "",
				if entry.T and entry.T ~= "" then " $" .. entry.T else ""
			)
			if entry.P then
				local cost = (entry.M or 0) - entry.P
				local percent = if cost > 0 then entry.P / cost else 0
				row.Right.Text = string.format(
					"%s → %s%s (%s)",
					Format.Cash(entry.M or 0),
					if entry.P >= 0 then "+" else "",
					Format.Cash(entry.P),
					Format.Percent(percent)
				)
				row.Right.TextColor3 = if entry.P >= 0 then Colors.Green else Colors.Red
			else
				row.Right.Text = Format.Cash(entry.M or 0)
				row.Right.TextColor3 = Colors.Muted
			end
		end
		for i = #entries + 1, #logRows do
			logRows[i].Frame.Visible = false
		end
	end

	local function loadLog()
		if loading then
			return
		end
		loading = true
		task.spawn(function()
			local result = MarketClient.TradeLog()
			loading = false
			if result then
				log = result
			end
			if mode == "History" then
				refreshHistory()
			end
		end)
	end

	local function setMode(newMode: string)
		mode = newMode
		local history = mode == "History"
		for _, item in { summary, historyButton, list, emptyLabel } do
			item.Visible = not history
		end
		for _, item in { historySummary, periodButton, backButton, logList, logEmpty } do
			item.Visible = history
		end
		if history then
			loadLog()
		end
		self.Refresh()
	end
	historyButton.Activated:Connect(function()
		setMode("History")
	end)
	backButton.Activated:Connect(function()
		setMode("Positions")
	end)
	periodButton.Activated:Connect(function()
		periodIndex = periodIndex % #PERIODS + 1
		refreshHistory()
	end)
	-- Nach einem eigenen Trade: Verlauf neu laden (Server begrenzt auf 1 Abfrage pro 2 Sek.)
	MarketClient.TradeResult.Event:Connect(function(ok: boolean)
		if ok and mode == "History" then
			task.delay(2, loadLog)
		end
	end)

	------------------------------------------------------------------
	-- Positionen
	------------------------------------------------------------------
	local function getRow(coinId: string)
		local row = rows[coinId]
		if row then
			return row
		end
		local frame = Screen.New("TextButton", {
			Text = "",
			Size = UDim2.new(1, -10, 0, ROW_HEIGHT),
			BackgroundColor3 = Colors.Panel,
			Parent = list,
		}, {
			Screen.Corner(10),
		})
		row = {
			Frame = frame,
			Icon = Screen.Label({
				TextSize = 32,
				TextXAlignment = Enum.TextXAlignment.Center,
				Position = UDim2.fromOffset(10, 0),
				Size = UDim2.fromOffset(44, ROW_HEIGHT),
				Parent = frame,
			}),
			Name = Screen.Label({
				Font = Screen.Fonts.Bold,
				Position = UDim2.fromOffset(64, 14),
				Size = UDim2.new(0.5, -64, 0, 28),
				Parent = frame,
			}),
			Amount = Screen.Label({
				TextSize = 20,
				TextColor3 = Colors.Muted,
				Position = UDim2.fromOffset(64, 46),
				Size = UDim2.new(0.5, -64, 0, 26),
				Parent = frame,
			}),
			Value = Screen.Label({
				Font = Screen.Fonts.Bold,
				TextXAlignment = Enum.TextXAlignment.Right,
				Position = UDim2.new(0.5, 0, 0, 14),
				Size = UDim2.new(0.5, -150, 0, 28),
				Parent = frame,
			}),
			Pnl = Screen.Label({
				TextSize = 20,
				TextXAlignment = Enum.TextXAlignment.Right,
				Position = UDim2.new(0.5, 0, 0, 46),
				Size = UDim2.new(0.5, -150, 0, 26),
				Parent = frame,
			}),
			Sell = Screen.Button({
				Text = "SELL ALL",
				TextSize = 22,
				BackgroundColor3 = Colors.Red,
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -8, 0.5, 0),
				Size = UDim2.fromOffset(124, 72),
				Parent = frame,
			}),
		}
		frame.Activated:Connect(function()
			onOpenCoin(coinId)
		end)
		row.Sell.Activated:Connect(function()
			MarketClient.Trade(coinId, "Sell", 1)
		end)
		rows[coinId] = row
		return row
	end

	local function refreshPositions()
		local me = MarketClient.Me
		local inCoins, totalCost = 0, 0
		local entries = {}
		for coinId, position in me.Positions or {} do
			local coin = MarketClient.Coins[coinId]
			if coin then
				local value = MarketClient.PositionValue(coin, position)
				inCoins += value
				totalCost += position.Cost
				table.insert(entries, { Coin = coin, Position = position, Value = value })
			end
		end
		table.sort(entries, function(a, b)
			return a.Value > b.Value
		end)

		cashValue.Text = Format.Cash(me.Cash)
		positionsValue.Text = Format.Cash(inCoins)
		totalValue.Text = Format.Cash(me.Cash + inCoins)
		local openPnl = inCoins - totalCost
		pnlValue.Text = (if openPnl >= 0 then "+" else "") .. Format.Cash(openPnl)
		pnlValue.TextColor3 = if openPnl >= 0 then Colors.Green else Colors.Red
		emptyLabel.Visible = #entries == 0
		if me.Stats then
			local level, progress, missing = Levels.Progress(me.Stats.Xp)
			levelValue.Text = string.format("Lv %d · %d%%", level, math.floor(progress * 100))
			levelValue.TextColor3 = Colors.Text
			-- kleine Hilfe im Titel: wie viel XP noch fehlt (kurz, passt auch auf das iPad)
			levelTitle.Text = string.format("Next: %d XP", missing)
		end

		local shown = {}
		for index, entry in entries do
			local coin, position = entry.Coin, entry.Position
			local row = getRow(coin.Id)
			shown[coin.Id] = true
			row.Frame.LayoutOrder = index
			row.Icon.Text = coin.Icon
			local crown = if coin.CreatorId == MarketClient.MyKey then "👨‍💻 " else "" -- eigener Coin (👑 = Legend)
			local star = if MarketClient.IsFavorite(coin.Id) then "⭐" else ""
			row.Name.Text = crown
				.. star
				.. "$"
				.. coin.Ticker
				.. (if coin.Rugged then "  RUGGED" elseif coin.Stage == "Dead" then "  DEAD" else "")
			row.Name.TextColor3 = if coin.Rugged or coin.Stage == "Dead" then Colors.Red else Colors.Text
			local marks = ""
			if position.SL then
				marks ..= string.format(" · 🛑-%d%%", math.floor(position.SL * 100 + 0.5))
			end
			if me.Insured and me.Insured[coin.Id] then
				marks ..= " · 🛡"
			end
			if coin.CreatorId == MarketClient.MyKey and me.Stats and me.Stats.FeesEarned > 0 then
				marks ..= " · fees " .. Format.Short(me.Stats.FeesEarned)
			end
			row.Amount.Text = string.format("%s · cost %s%s", Format.Short(position.Amount), Format.Cash(position.Cost), marks)
			local pnl = if position.Cost > 0 then entry.Value / position.Cost - 1 else 0
			row.Value.Text = Format.Cash(entry.Value)
			row.Pnl.Text = Format.Percent(pnl)
			row.Pnl.TextColor3 = if pnl >= 0 then Colors.Green else Colors.Red
		end
		for coinId, row in rows do
			if not shown[coinId] then
				row.Frame:Destroy()
				rows[coinId] = nil
			end
		end
	end

	function self.Refresh()
		if mode == "History" then
			refreshHistory()
		else
			refreshPositions()
		end
	end

	setMode("Positions")
	return self
end

return Portfolio
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX37">
				<Properties>
					<string name="Name">PulseList</string>
					<ProtectedString name="Source"><![CDATA[-- PulseList (ModuleScript) – StarterPlayer/StarterPlayerScripts/ClientModules/PulseList
-- Startseite: oben BOOSTED-Leiste (max. 3) + "CREATE COIN", darunter drei Spalten New · Almost done · Migrated.
-- Breite oben (mind. 976): Titel 150 | 3 Boosts à 170 (+8) | ⭐-Filter 64 | 8 | Knopf 210
-- Pro Coin: Icon, Ticker, Alter, Marktkapital, Holder, Dev-Anteil, Rug-Lizenz-Warnung, Schnellkauf.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Screen = require(script.Parent.Screen)
local MarketClient = require(script.Parent.MarketClient)
local Indicators = require(ReplicatedStorage.Shared.Indicators)
local CreatorStyle = require(ReplicatedStorage.Shared.CreatorStyle)
local TweenService = game:GetService("TweenService")

local HIGHLIGHT = Color3.fromRGB(255, 255, 255)
local GLOW = TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)

-- Highlight-Rahmen pulsiert (Tween läuft nur, solange das Highlight aktiv ist)
local function setGlow(card, on: boolean)
	if on and not card.Glow then
		card.Glow = TweenService:Create(card.Stroke, GLOW, { Transparency = 0.7 })
		card.Glow:Play()
	elseif not on and card.Glow then
		card.Glow:Cancel()
		card.Glow = nil
		card.Stroke.Transparency = 0
	end
end

local Colors = Screen.Colors
local MAX_PER_COLUMN = 20
local CARD_HEIGHT = 96

local COLUMNS = {
	{ Stage = "New", Title = "NEW" },
	{ Stage = "AlmostDone", Title = "ALMOST DONE" },
	{ Stage = "Migrated", Title = "MIGRATED" },
}

local PulseList = {}

local TOP = 64 -- Höhe der BOOSTED-Leiste

-- parent: Seite, onOpenCoin(coinId): Coin-Seite öffnen, onCreate(): Formular "Coin erstellen"
function PulseList.new(parent: GuiObject, onOpenCoin: (string) -> (), onCreate: () -> ())
	local self = { Cards = {}, Columns = {} }

	-- BOOSTED-Leiste
	local top = Screen.New("Frame", {
		Size = UDim2.new(1, 0, 0, TOP),
		BackgroundTransparency = 1,
		Parent = parent,
	})
	Screen.Label({
		Text = "🚀 BOOSTED",
		Font = Screen.Fonts.Bold,
		TextColor3 = Colors.Accent,
		Size = UDim2.new(0, 150, 1, 0),
		Parent = top,
	})
	local boostChips = {}
	for i = 1, Config.Launch.BoostSlots do
		local chip = Screen.Button({
			Text = "",
			TextSize = 20,
			Position = UDim2.fromOffset(150 + (i - 1) * 178, 0),
			Size = UDim2.fromOffset(170, TOP),
			Visible = false,
			Parent = top,
		})
		Screen.New("UIStroke", { Color = Colors.Accent, Thickness = 2, Parent = chip })
		chip.Activated:Connect(function()
			if chip:GetAttribute("CoinId") then
				onOpenCoin(chip:GetAttribute("CoinId"))
			end
		end)
		boostChips[i] = chip
	end
	local noBoost = Screen.Label({
		Text = "No boosted coins right now",
		TextSize = 20,
		TextColor3 = Colors.Muted,
		Position = UDim2.fromOffset(150, 0),
		Size = UDim2.new(1, -150 - 290, 1, 0),
		Parent = top,
	})
	-- ⭐-Filter: nur Favoriten zeigen
	local favoritesOnly = false
	local favButton = Screen.Button({
		Text = "☆",
		TextSize = 30,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -218, 0, 0),
		Size = UDim2.fromOffset(64, TOP),
		Parent = top,
	})
	favButton.Activated:Connect(function()
		favoritesOnly = not favoritesOnly
		self.Refresh()
	end)
	local createButton = Screen.Button({
		Text = "+ CREATE COIN",
		TextSize = 22,
		BackgroundColor3 = Colors.Green,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.fromOffset(210, TOP),
		Parent = top,
	})
	createButton.Activated:Connect(function()
		local myCoin = MarketClient.Me.MyCoin and MarketClient.Coins[MarketClient.Me.MyCoin]
		if myCoin and myCoin.Stage ~= "Dead" then
			onOpenCoin(myCoin.Id) -- eigener Coin aktiv: dorthin
		else
			onCreate()
		end
	end)

	-- Spalten
	local columnsArea = Screen.New("Frame", {
		Position = UDim2.fromOffset(0, TOP + 10),
		Size = UDim2.new(1, 0, 1, -(TOP + 10)),
		BackgroundTransparency = 1,
		Parent = parent,
	}, {
		Screen.New("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 12),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})

	for i, def in COLUMNS do
		local column = Screen.New("Frame", {
			Size = UDim2.new(1 / #COLUMNS, -8, 1, 0),
			BackgroundColor3 = Colors.Panel,
			LayoutOrder = i,
			Parent = columnsArea,
		}, {
			Screen.Corner(12),
		})
		local title = Screen.Label({
			Text = def.Title,
			Font = Screen.Fonts.Bold,
			TextSize = 22,
			TextColor3 = Colors.Muted,
			Position = UDim2.fromOffset(12, 6),
			Size = UDim2.new(1, -24, 0, 30),
			Parent = column,
		})
		local list = Screen.Scroller({
			Position = UDim2.fromOffset(8, 42),
			Size = UDim2.new(1, -16, 1, -50),
			Parent = column,
		})
		self.Columns[def.Stage] = { Title = title, List = list, Name = def.Title }
		self.ColumnsArea = columnsArea -- für das Tutorial (Schritt 1: Coin antippen)
	end

	-- Eine Karte pro Coin, wird wiederverwendet
	local function getCard(coinId: string)
		local card = self.Cards[coinId]
		if card then
			return card
		end
		local frame = Screen.New("TextButton", {
			Text = "",
			AutoButtonColor = true,
			Size = UDim2.new(1, -8, 0, CARD_HEIGHT),
			BackgroundColor3 = Colors.PanelLight,
		}, {
			Screen.Corner(10),
		})
		-- Breite: Text links (78 %), BUY rechts (22 %, auf dem iPad ca. 64). Bei 1000 Design-Pixeln
		-- Bildschirmbreite (iPad) bleiben ca. 166 Pixel für Text = ca. 16 Zeichen pro Zeile.
		card = {
			Frame = frame,
			Stroke = Screen.New("UIStroke", {
				Color = Colors.Red,
				Thickness = 2,
				Enabled = false,
				ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
				Parent = frame,
			}),
			Icon = Screen.Label({
				TextSize = 30,
				TextXAlignment = Enum.TextXAlignment.Center,
				Position = UDim2.fromOffset(8, 8),
				Size = UDim2.fromOffset(36, 36),
				Parent = frame,
			}),
			Top = Screen.Label({
				Font = Screen.Fonts.Bold,
				TextSize = 22,
				Position = UDim2.fromOffset(52, 8),
				Size = UDim2.new(0.78, -60, 0, 26),
				Parent = frame,
			}),
			Middle = Screen.Label({
				TextSize = 20,
				TextColor3 = Colors.Muted,
				Position = UDim2.fromOffset(52, 36),
				Size = UDim2.new(0.78, -60, 0, 24),
				Parent = frame,
			}),
			Bottom = Screen.Label({
				TextSize = 20,
				TextColor3 = Colors.Muted,
				Position = UDim2.fromOffset(52, 62),
				Size = UDim2.new(0.78, -60, 0, 24),
				Parent = frame,
			}),
			Buy = Screen.Button({
				Text = "BUY",
				TextSize = 22,
				BackgroundColor3 = Colors.Green,
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -8, 0.5, 0),
				Size = UDim2.new(0.22, 0, 0, 80),
				Parent = frame,
			}),
		}
		frame.Activated:Connect(function()
			onOpenCoin(coinId)
		end)
		card.Buy.Activated:Connect(function()
			MarketClient.Trade(coinId, "Buy", Config.Trade.QuickBuyFraction)
		end)
		self.Cards[coinId] = card
		return card
	end

	function self.Refresh()
		-- BOOSTED-Leiste (längste Restzeit zuerst)
		local boosted = {}
		for coinId in MarketClient.Boosts do
			local coin = MarketClient.Coins[coinId]
			local left = MarketClient.BoostLeft(coinId)
			if coin and left > 0 then
				table.insert(boosted, { Coin = coin, Left = left })
			end
		end
		table.sort(boosted, function(a, b)
			return a.Left > b.Left
		end)
		for i, chip in boostChips do
			local entry = boosted[i]
			chip.Visible = entry ~= nil
			if entry then
				chip:SetAttribute("CoinId", entry.Coin.Id)
				chip.Text = string.format("%s $%s · %s", entry.Coin.Icon, entry.Coin.Ticker, Format.Duration(entry.Left))
			end
		end
		noBoost.Visible = #boosted == 0

		-- Knopf: gesperrt bis Level 10, mit aktivem eigenem Coin "MY COIN"
		local stats = MarketClient.Me.Stats
		local myCoin = MarketClient.Me.MyCoin and MarketClient.Coins[MarketClient.Me.MyCoin]
		if myCoin and myCoin.Stage ~= "Dead" then
			createButton.Text = "👨‍💻 MY COIN $" .. myCoin.Ticker
		elseif stats and stats.Level < Config.Launch.CreateMinLevel then
			createButton.Text = "+ CREATE · Lv " .. Config.Launch.CreateMinLevel .. " or R$"
		else
			createButton.Text = "+ CREATE COIN"
		end

		-- Coins nach Spalte sortieren
		favButton.Text = if favoritesOnly then "⭐" else "☆"
		favButton.BackgroundColor3 = if favoritesOnly then Colors.Accent else Colors.PanelLight
		local byStage = { New = {}, AlmostDone = {}, Migrated = {} }
		for _, coin in MarketClient.Coins do
			local list = if favoritesOnly and not MarketClient.IsFavorite(coin.Id) then nil else byStage[coin.Stage]
			if list then -- "Dead" erscheint nicht
				table.insert(list, coin)
			end
		end
		table.sort(byStage.New, function(a, b)
			return a.CreatedAt > b.CreatedAt
		end)
		table.sort(byStage.AlmostDone, function(a, b)
			return a.MarketCap > b.MarketCap
		end)
		table.sort(byStage.Migrated, function(a, b)
			return a.MarketCap > b.MarketCap
		end)

		local shown = {}
		for stage, coins in byStage do
			local column = self.Columns[stage]
			column.Title.Text = string.format("%s  (%d)", column.Name, #coins)
			for index = 1, math.min(#coins, MAX_PER_COLUMN) do
				local coin = coins[index]
				local card = getCard(coin.Id)
				shown[coin.Id] = true
				card.Frame.LayoutOrder = index
				card.Frame.Parent = column.List
				card.Icon.Text = coin.Icon
				local highlighted = (coin.Highlight or 0) > workspace:GetServerTimeNow() -- Robux-Highlight (30 Min.)
				card.Top.Text = string.format(
					"%s%s%s$%s · %s",
					if MarketClient.IsFavorite(coin.Id) then "⭐" else "",
					if highlighted then "✨" else "",
					if MarketClient.IsFriend(coin.CreatorId) then "👥" else "", -- Coin eines Roblox-Freunds
					coin.Ticker,
					Format.Duration(MarketClient.Age(coin))
				)
				card.Middle.Text = string.format("MC %s · 👥%d", Format.Short(coin.MarketCap), coin.Holders)
				if coin.Rugged then
					card.Bottom.Text = "RUGGED"
					card.Bottom.TextColor3 = Colors.Red
				else
					-- Dev-Anteil mit derselben Ampel wie auf der Coin-Seite (gelb/rot = Dev hat dazugekauft)
					local rating = Indicators.Rate("Dev", coin.DevShare)
					card.Bottom.Text = string.format("Dev %.0f%%", coin.DevShare * 100)
					card.Bottom.TextColor3 = if rating == "Good" then Colors.Muted
						elseif rating == "Ok" then Colors.Accent
						else Colors.Red
				end
				-- Rahmen: rot = gerugged, leuchtend = Robux-Highlight, lila/gold = Silber-/Gold-Creator
				local creatorColor = CreatorStyle.Color(MarketClient.CreatorTier(coin.CreatorId))
				card.Stroke.Enabled = coin.Rugged == true or highlighted or creatorColor ~= nil
				card.Stroke.Color = if coin.Rugged then Colors.Red
					elseif highlighted then HIGHLIGHT
					else (creatorColor or Colors.Red)
				card.Stroke.Thickness = if highlighted and not coin.Rugged then 3 else 2
				setGlow(card, highlighted and not coin.Rugged)
			end
		end

		-- Karten von Coins, die nicht mehr angezeigt werden, entfernen
		for coinId, card in self.Cards do
			if not shown[coinId] then
				setGlow(card, false)
				card.Frame:Destroy()
				self.Cards[coinId] = nil
			end
		end
	end

	return self
end

return PulseList
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX38">
				<Properties>
					<string name="Name">Screen</string>
					<ProtectedString name="Source"><![CDATA[-- Screen (ModuleScript) – StarterPlayer/StarterPlayerScripts/ClientModules/Screen
-- Basis für ALLE Bildschirme:
--  * dunkler Hintergrund füllt den ganzen Bildschirm (auch hinter Notch/Dynamic Island)
--  * Inhalt liegt nur im sicheren Bereich (keine Notch, Dynamic Island, Kamera-Loch,
--    abgerundete Ecken, Roblox-Leiste oben)
--  * Layout wird für 1000 x 520 gebaut und auf jede Größe skaliert (iPhone bis PC)

local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local SoundFx = require(script.Parent.SoundFx)

local Screen = {}

local currentScale = 1

Screen.Colors = {
	Background = Color3.fromRGB(10, 12, 17),
	Panel = Color3.fromRGB(19, 22, 30),
	PanelLight = Color3.fromRGB(28, 32, 43),
	Border = Color3.fromRGB(40, 45, 58),
	Text = Color3.fromRGB(232, 236, 244),
	Muted = Color3.fromRGB(140, 148, 166),
	Green = Color3.fromRGB(34, 197, 94),
	Red = Color3.fromRGB(239, 68, 68),
	Accent = Color3.fromRGB(250, 204, 21),
}

Screen.Fonts = {
	Regular = Enum.Font.BuilderSans,
	Medium = Enum.Font.BuilderSansMedium,
	Bold = Enum.Font.BuilderSansBold,
}

-- Instanz mit Eigenschaften und Kindern bauen
function Screen.New(className: string, props: { [string]: any }?, children: { Instance }?): any
	local instance = Instance.new(className)
	local target: any = instance
	local parent
	for key, value in props or {} do
		if key == "Parent" then
			parent = value
		else
			target[key] = value
		end
	end
	for _, child in children or {} do
		child.Parent = instance
	end
	instance.Parent = parent
	return instance
end

function Screen.Corner(radius: number?): UICorner
	return Screen.New("UICorner", { CornerRadius = UDim.new(0, radius or 10) })
end

function Screen.Padding(px: number): UIPadding
	return Screen.New("UIPadding", {
		PaddingTop = UDim.new(0, px),
		PaddingBottom = UDim.new(0, px),
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
	})
end

-- Textfeld mit Standardwerten (TextSize in Design-Pixeln, min. 20 für Handy)
function Screen.Label(props: { [string]: any }): TextLabel
	local defaults = {
		BackgroundTransparency = 1,
		Font = Screen.Fonts.Medium,
		TextColor3 = Screen.Colors.Text,
		TextSize = 22,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
	}
	for key, value in props do
		defaults[key] = value
	end
	return Screen.New("TextLabel", defaults)
end

-- Großer Button (Handy: min. 72 Design-Pixel hoch ≈ 44 pt auf dem kleinsten iPhone)
function Screen.Button(props: { [string]: any }): TextButton
	local defaults = {
		AutoButtonColor = true,
		BorderSizePixel = 0,
		Font = Screen.Fonts.Bold,
		TextColor3 = Screen.Colors.Text,
		TextSize = 26,
		BackgroundColor3 = Screen.Colors.PanelLight,
	}
	for key, value in props do
		defaults[key] = value
	end
	local button = Screen.New("TextButton", defaults)
	Screen.Corner(10).Parent = button
	button.Activated:Connect(function()
		SoundFx.Play("Click") -- dezenter Klick (abschaltbar)
	end)
	return button
end

-- Senkrechte Scroll-Liste (Höhe wächst automatisch mit dem Inhalt)
function Screen.Scroller(props: { [string]: any }): ScrollingFrame
	local defaults = {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = Screen.Colors.Border,
	}
	for key, value in props do
		defaults[key] = value
	end
	local scroller = Screen.New("ScrollingFrame", defaults)
	Screen.New("UIListLayout", {
		Padding = UDim.new(0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = scroller,
	})
	return scroller
end

-- Aktueller Skalierungsfaktor (Bildschirm-Pixel pro Design-Pixel)
function Screen.GetScale(): number
	return currentScale
end

-- Roblox-Standard-UI ausblenden, die im Terminal stört
function Screen.Setup()
	for _, coreType in { Enum.CoreGuiType.Backpack, Enum.CoreGuiType.Health, Enum.CoreGuiType.PlayerList, Enum.CoreGuiType.EmotesMenu } do
		pcall(StarterGui.SetCoreGuiEnabled, StarterGui, coreType, false)
	end
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui") :: PlayerGui
	playerGui.ScreenOrientation = Enum.ScreenOrientation.LandscapeSensor
end

-- Erstellt einen Vollbild-Bildschirm. Gibt "root" zurück: dort alles hineinbauen.
-- root ist in Design-Pixeln mind. ca. 1000 x 520 groß (je nach Seitenverhältnis mehr).
function Screen.CreateRoot(name: string): Frame
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local ui = Config.UI

	-- 1) Hintergrund: ganzer Bildschirm, auch hinter Notch und Roblox-Leiste
	Screen.New("ScreenGui", {
		Name = name .. "Background",
		IgnoreGuiInset = true,
		ScreenInsets = Enum.ScreenInsets.None,
		ResetOnSpawn = false,
		DisplayOrder = 0,
		Parent = playerGui,
	}, {
		Screen.New("Frame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Screen.Colors.Background,
			BorderSizePixel = 0,
		}),
	})

	-- 2) Inhalt: nur im sicheren Bereich (Notch, Dynamic Island, Roblox-Leiste frei)
	local gui = Screen.New("ScreenGui", {
		Name = name,
		ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets,
		ClipToDeviceSafeArea = true,
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 1,
		Parent = playerGui,
	})
	local holder = Screen.New("Frame", {
		Name = "SafeArea",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	local root = Screen.New("Frame", {
		Name = "Root",
		BackgroundTransparency = 1,
		Parent = holder,
	})
	local scale = Screen.New("UIScale", { Parent = root })

	-- 3) Skalieren: kleinere Seite bestimmt den Faktor, root füllt den sicheren Bereich genau
	local function update()
		local size = holder.AbsoluteSize
		if size.X <= 0 or size.Y <= 0 then
			return
		end
		local factor = math.min(size.X / ui.DesignWidth, size.Y / ui.DesignHeight)
		factor = math.clamp(factor, ui.MinScale, ui.MaxScale)
		scale.Scale = factor
		currentScale = factor
		root.Size = UDim2.fromOffset(size.X / factor, size.Y / factor)
	end
	holder:GetPropertyChangedSignal("AbsoluteSize"):Connect(update)
	update()

	return root
end

return Screen
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX39">
				<Properties>
					<string name="Name">ShopUI</string>
					<ProtectedString name="Source"><![CDATA[-- ShopUI (ModuleScript) – StarterPlayer/StarterPlayerScripts/ClientModules/ShopUI
-- Shop-Fenster (🛒 oben): alle Robux-Produkte (Gutscheine) und Gamepässe auf einen Blick.
-- Oben rechts zusätzlich der Sound-Schalter (wird gespeichert).
-- Fester Inhalt, keine Zufalls-Käufe. Der Server bucht jeden Kauf genau einmal.
--
-- Platz: Fenster 85 % breit, 484 hoch (passt in die kleinste Höhe von 496), Liste scrollt.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Screen = require(script.Parent.Screen)
local MarketClient = require(script.Parent.MarketClient)

local Colors = Screen.Colors
local SHOP = Config.Shop
local ROW = 80
local ICONS = {
	CreateCoin = "🚀",
	Boost = "📈",
	Highlight = "✨",
	License = "☠",
	Pro = "📊",
	HalfInsurance = "🛡",
	DoubleDaily = "🎁",
	Vip = "⭐",
}

local ShopUI = {}

function ShopUI.new(parent: GuiObject)
	local self = {}

	local overlay = Screen.New("TextButton", {
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Colors.Background,
		BackgroundTransparency = 0.3,
		Visible = false,
		ZIndex = 40,
		Parent = parent,
	})
	local panel = Screen.New("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0.85, 0, 0, 484),
		BackgroundColor3 = Colors.Panel,
		Active = true,
		ZIndex = 41,
		Parent = overlay,
	}, {
		Screen.Corner(14),
		Screen.Padding(16),
	})
	Screen.Label({
		Text = "🛒 SHOP",
		Font = Screen.Fonts.Bold,
		TextSize = 30,
		Size = UDim2.new(1, -360, 0, 36),
		ZIndex = 42,
		Parent = panel,
	})
	Screen.Label({
		Text = "Fixed items · Cash never turns into Robux",
		TextSize = 20,
		TextColor3 = Colors.Muted,
		Position = UDim2.fromOffset(0, 38),
		Size = UDim2.new(1, -360, 0, 24),
		ZIndex = 42,
		Parent = panel,
	})
	local closeButton = Screen.Button({
		Text = "CLOSE",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.fromOffset(160, 72),
		ZIndex = 42,
		Parent = panel,
	})

	local soundButton = Screen.Button({
		TextSize = 22,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -172, 0, 0),
		Size = UDim2.fromOffset(176, 72),
		ZIndex = 42,
		Parent = panel,
	})
	soundButton.Activated:Connect(function()
		local muted = MarketClient.Me.Settings ~= nil and MarketClient.Me.Settings.Mute == true
		MarketClient.SetFlag("Mute", not muted)
	end)

	local list = Screen.Scroller({
		Position = UDim2.fromOffset(0, 84),
		Size = UDim2.new(1, 0, 1, -84),
		ZIndex = 42,
		Parent = panel,
	})

	local rows = {}
	for i, name in SHOP.Order do
		local item = SHOP.Products[name] or SHOP.Passes[name]
		local isPass = SHOP.Passes[name] ~= nil
		local frame = Screen.New("Frame", {
			Size = UDim2.new(1, -10, 0, ROW),
			BackgroundColor3 = Colors.PanelLight,
			LayoutOrder = i,
			ZIndex = 43,
			Parent = list,
		}, {
			Screen.Corner(10),
		})
		Screen.Label({
			Text = ICONS[name] or "•",
			TextSize = 32,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.fromOffset(8, 0),
			Size = UDim2.fromOffset(48, ROW),
			ZIndex = 44,
			Parent = frame,
		})
		local title = Screen.Label({
			Font = Screen.Fonts.Bold,
			Text = item.Title .. (if isPass then "  · pass" else ""),
			Position = UDim2.fromOffset(64, 10),
			Size = UDim2.new(1, -64 - 170, 0, 28),
			ZIndex = 44,
			Parent = frame,
		})
		local info = Screen.Label({
			Text = item.Info,
			TextSize = 20,
			TextColor3 = Colors.Muted,
			Position = UDim2.fromOffset(64, 42),
			Size = UDim2.new(1, -64 - 170, 0, 26),
			ZIndex = 44,
			Parent = frame,
		})
		local buy = Screen.Button({
			Text = "R$ " .. item.Robux,
			BackgroundColor3 = Colors.Green,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -4, 0.5, 0),
			Size = UDim2.fromOffset(156, 72),
			ZIndex = 44,
			Parent = frame,
		})
		buy.Activated:Connect(function()
			if isPass and MarketClient.HasPass(name) then
				return
			end
			MarketClient.Buy(name)
		end)
		rows[name] = { Title = title, Info = info, Buy = buy, IsPass = isPass, Item = item }
	end

	function self.Refresh()
		local me = MarketClient.Me
		local muted = me.Settings ~= nil and me.Settings.Mute == true
		soundButton.Text = if muted then "🔇 SOUND OFF" else "🔊 SOUND ON"
		local vouchers = me.Vouchers or {}
		local have = {
			CreateCoin = vouchers.CT or 0,
			Boost = me.FreeBoosts or 0,
			Highlight = vouchers.HT or 0,
			License = me.RugLicense or 0,
		}
		for name, row in rows do
			if row.IsPass then
				local owns = MarketClient.HasPass(name)
				row.Buy.Text = if owns then "OWNED" else "R$ " .. row.Item.Robux
				row.Buy.BackgroundColor3 = if owns then Colors.Border else Colors.Green
			else
				local count = have[name] or 0
				row.Info.Text = row.Item.Info .. (if count > 0 then string.format(" · you have %d", count) else "")
			end
		end
	end

	function self.Show()
		self.Refresh()
		overlay.Visible = true
	end

	local function hide()
		overlay.Visible = false
	end
	closeButton.Activated:Connect(hide)
	overlay.Activated:Connect(hide)

	return self
end

return ShopUI
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX40">
				<Properties>
					<string name="Name">SoundFx</string>
					<ProtectedString name="Source"><![CDATA[-- SoundFx (ModuleScript) – StarterPlayer/StarterPlayerScripts/ClientModules/SoundFx
-- Wenige, dezente Sounds: Klick, Erfolg, Fehler, Level-Up, Rugpull-Alarm. Nur auf diesem Gerät.
-- Aus/an im Portfolio (wird gespeichert). Fehlt eine Datei, bleibt es einfach still.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local Config = require(ReplicatedStorage.Shared.Config)

local SoundFx = {}
SoundFx.Muted = false

local sounds = {} -- [Name] = Sound

local function get(name: string): Sound?
	local def = Config.Sounds[name]
	if type(def) ~= "table" then
		return nil
	end
	local sound = sounds[name]
	if not sound then
		sound = Instance.new("Sound")
		sound.Name = "MoR_" .. name
		sound.SoundId = def.Id
		sound.PlaybackSpeed = def.Speed or 1
		sound.Volume = Config.Sounds.Volume
		sound.Parent = SoundService
		sounds[name] = sound
	end
	return sound
end

function SoundFx.Play(name: string)
	if SoundFx.Muted then
		return
	end
	local sound = get(name)
	if sound then
		pcall(SoundService.PlayLocalSound, SoundService, sound)
	end
end

return SoundFx
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX41">
				<Properties>
					<string name="Name">TerminalUI</string>
					<ProtectedString name="Source"><![CDATA[-- TerminalUI (ModuleScript) – StarterPlayer/StarterPlayerScripts/ClientModules/TerminalUI
-- Vollbild-Terminal: Kopfleiste (Logo, Tabs, Cash + Level), Seiten (Pulse, Coin, Portfolio, Leaderboard),
-- Ticker unten, Level-Up-Banner, Daily-Reward-Knopf, Shop (🛒, Phase 8).
-- Breite (mind. 976): Logo 180 | 10 | Tabs 3 x 124 + 2 x 10 = 392 | 20 | Shop 64 | 6 | Daily 64 | 10 | Cash/Level 230
-- Admins: statt des Logos "🚀" 56 + ADMIN-Knopf 118 (gleiche Breite 180)
--
-- Höhen (Design-Pixel, mind. 520): 12 Rand | Kopf 72 | 10 | Seite (Rest, mind. 368) | 10 | Ticker 36 | 12 Rand

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Screen = require(script.Parent.Screen)
local MarketClient = require(script.Parent.MarketClient)
local PulseList = require(script.Parent.PulseList)
local CoinPage = require(script.Parent.CoinPage)
local Portfolio = require(script.Parent.Portfolio)
local LeaderboardUI = require(script.Parent.LeaderboardUI)
local DailyRewardUI = require(script.Parent.DailyRewardUI)
local CreateCoinUI = require(script.Parent.CreateCoinUI)
local AdminUI = require(script.Parent.AdminUI)
local ShopUI = require(script.Parent.ShopUI)
local TutorialUI = require(script.Parent.TutorialUI)
local SoundFx = require(script.Parent.SoundFx)
local CreatorStyle = require(ReplicatedStorage.Shared.CreatorStyle)
local Levels = require(ReplicatedStorage.Shared.Levels)

local Colors = Screen.Colors
local HEADER = 72
local TICKER = 36
local GAP = 10

local TerminalUI = {}

function TerminalUI.Start()
	MarketClient.Start()

	local root = Screen.CreateRoot("Terminal")
	Screen.Padding(12).Parent = root

	------------------------------------------------------------------
	-- Kopfleiste
	------------------------------------------------------------------
	local header = Screen.New("Frame", {
		Size = UDim2.new(1, 0, 0, HEADER),
		BackgroundTransparency = 1,
		Parent = root,
	})
	local logo = Screen.Label({
		Text = "🚀 MOON OR RUG",
		Font = Screen.Fonts.Bold,
		TextSize = 24,
		Size = UDim2.new(0, 180, 1, 0),
		Parent = header,
	})
	-- ADMIN-Knopf: nur für Admins sichtbar (Server prüft jede Admin-Anfrage trotzdem)
	local adminButton = Screen.Button({
		Text = "ADMIN",
		TextSize = 22,
		BackgroundColor3 = Colors.Red,
		Position = UDim2.fromOffset(62, 4),
		Size = UDim2.fromOffset(118, 64),
		Visible = false,
		Parent = header,
	})
	local tabBar = Screen.New("Frame", {
		Position = UDim2.fromOffset(190, 0),
		Size = UDim2.new(1, -190 - 240 - 74 - 70, 1, 0),
		BackgroundTransparency = 1,
		Parent = header,
	}, {
		Screen.New("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 10),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	-- Daily-Reward-Knopf (leuchtet, wenn bereit)
	local dailyButton = Screen.Button({
		Text = "🎁",
		TextSize = 32,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -240, 0, 4),
		Size = UDim2.fromOffset(64, 64),
		Parent = header,
	})

	-- Shop-Knopf (Robux-Produkte + Gamepässe)
	local shopButton = Screen.Button({
		Text = "🛒",
		TextSize = 32,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -310, 0, 4),
		Size = UDim2.fromOffset(64, 64),
		Parent = header,
	})

	-- Rechts: Cash, darunter Level + XP-Balken
	local wallet = Screen.New("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.new(0, 230, 1, 0),
		BackgroundTransparency = 1,
		Parent = header,
	})
	-- Profilrahmen um die Wallet-Box: rot = Legend (Level 40), türkis = VIP-Gamepass
	local vipFrame = Screen.New("UIStroke", {
		Color = CreatorStyle.Vip,
		Thickness = 2,
		Enabled = false,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = wallet,
	})
	Screen.Corner(10).Parent = wallet
	local cashLabel = Screen.Label({
		Font = Screen.Fonts.Bold,
		TextSize = 26,
		TextColor3 = Colors.Accent,
		TextXAlignment = Enum.TextXAlignment.Right,
		Size = UDim2.new(1, 0, 0, 36),
		Parent = wallet,
	})
	local levelLabel = Screen.Label({
		TextSize = 20,
		TextColor3 = Colors.Muted,
		TextXAlignment = Enum.TextXAlignment.Right,
		Position = UDim2.fromOffset(0, 36),
		Size = UDim2.new(1, 0, 0, 24),
		Parent = wallet,
	})
	local xpBar = Screen.New("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 62),
		Size = UDim2.new(0, 150, 0, 6),
		BackgroundColor3 = Colors.PanelLight,
		Parent = wallet,
	}, {
		Screen.Corner(3),
	})
	local xpFill = Screen.New("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Colors.Green,
		Parent = xpBar,
	}, {
		Screen.Corner(3),
	})

	------------------------------------------------------------------
	-- Seiten
	------------------------------------------------------------------
	local pageArea = Screen.New("Frame", {
		Position = UDim2.fromOffset(0, HEADER + GAP),
		Size = UDim2.new(1, 0, 1, -(HEADER + GAP + GAP + TICKER)),
		BackgroundTransparency = 1,
		Parent = root,
	})
	local function page(name: string)
		return Screen.New("Frame", {
			Name = name,
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Visible = false,
			Parent = pageArea,
		})
	end

	local pages = {}
	local current = "Pulse"
	local lastTab = "Pulse"
	local tabButtons = {}

	local function show(name: string)
		current = name
		if name ~= "Coin" then
			lastTab = name
		end
		for pageName, entry in pages do
			entry.Frame.Visible = pageName == name
		end
		for tabName, button in tabButtons do
			button.BackgroundColor3 = if tabName == lastTab then Colors.Border else Colors.PanelLight
		end
		pages[name].View.Refresh()
	end

	local function openCoin(coinId: string)
		pages.Coin.View.Show(coinId)
		show("Coin")
	end

	local pulseFrame = page("Pulse")
	local createUI -- Formular "Coin erstellen" (wird unten gebaut, liegt über allem)
	pages.Pulse = {
		Frame = pulseFrame,
		View = PulseList.new(pulseFrame, openCoin, function()
			createUI.Show() -- Level prüft das Fenster/der Server (mit Robux auch ohne Level)
		end),
	}
	local coinFrame = page("Coin")
	pages.Coin = {
		Frame = coinFrame,
		View = CoinPage.new(coinFrame, function()
			show(lastTab)
		end),
	}
	local portfolioFrame = page("Portfolio")
	pages.Portfolio = { Frame = portfolioFrame, View = Portfolio.new(portfolioFrame, openCoin) }
	local leaderboardFrame = page("Leaderboard")
	pages.Leaderboard = { Frame = leaderboardFrame, View = LeaderboardUI.new(leaderboardFrame) }

	local TAB_TEXT = { Pulse = "PULSE", Portfolio = "PORTFOLIO", Leaderboard = "RANKING" }
	for i, tabName in { "Pulse", "Portfolio", "Leaderboard" } do
		local button = Screen.Button({
			Text = TAB_TEXT[tabName],
			TextSize = 20,
			Size = UDim2.new(0, 124, 1, -8),
			LayoutOrder = i,
			Parent = tabBar,
		})
		button.Activated:Connect(function()
			show(tabName)
		end)
		tabButtons[tabName] = button
	end

	------------------------------------------------------------------
	-- Ticker unten (Rugpulls, große Gewinne)
	------------------------------------------------------------------
	local ticker = Screen.New("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, TICKER),
		BackgroundColor3 = Colors.Panel,
		Parent = root,
	}, {
		Screen.Corner(8),
	})
	local tickerLabel = Screen.Label({
		Text = Config.Ticker.IdleText,
		TextSize = 20,
		TextColor3 = Colors.Muted,
		Position = UDim2.fromOffset(12, 0),
		Size = UDim2.new(1, -24, 1, 0),
		Parent = ticker,
	})
	local newsQueue = {}
	MarketClient.News.Event:Connect(function(news)
		if news.Kind == "Rug" then
			SoundFx.Play("Rug")
		end
		table.insert(newsQueue, news)
		while #newsQueue > 10 do
			table.remove(newsQueue, 1)
		end
	end)
	task.spawn(function()
		while true do
			local news = table.remove(newsQueue, 1)
			if news then
				tickerLabel.Text = (if news.Kind == "Rug" then "🚨 " else "💰 ") .. news.Text
				tickerLabel.TextColor3 = if news.Kind == "Rug" then Colors.Red else Colors.Accent
				task.wait(Config.Ticker.ShowSeconds)
			else
				tickerLabel.Text = Config.Ticker.IdleText
				tickerLabel.TextColor3 = Colors.Muted
				task.wait(0.5)
			end
		end
	end)

	------------------------------------------------------------------
	-- Hinweis nach einem Trade (oben in der Mitte, verschwindet wieder)
	------------------------------------------------------------------
	local toast = Screen.Label({
		Font = Screen.Fonts.Bold,
		TextXAlignment = Enum.TextXAlignment.Center,
		BackgroundTransparency = 0,
		BackgroundColor3 = Colors.PanelLight,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, HEADER + GAP + 4),
		Size = UDim2.new(0.6, 0, 0, 44),
		Visible = false,
		ZIndex = 60, -- über allen Fenstern (z. B. Code einlösen)
		Parent = root,
	})
	Screen.Corner(10).Parent = toast
	local toastId = 0
	MarketClient.TradeResult.Event:Connect(function(ok: boolean, message: string)
		SoundFx.Play(if ok then "Success" else "Error")
		toastId += 1
		local myId = toastId
		toast.Text = message
		toast.TextColor3 = if ok then Colors.Green else Colors.Red
		toast.Visible = true
		task.delay(2.5, function()
			if toastId == myId then
				toast.Visible = false
			end
		end)
	end)

	------------------------------------------------------------------
	-- Level-Up-Banner (oben in der Mitte, 4 Sek.)
	------------------------------------------------------------------
	local banner = Screen.Label({
		Font = Screen.Fonts.Bold,
		TextSize = 24, -- längster Text (ca. 55 Zeichen) passt bei 1000 Breite
		TextColor3 = Colors.Background,
		TextXAlignment = Enum.TextXAlignment.Center,
		BackgroundTransparency = 0,
		BackgroundColor3 = Colors.Accent,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, HEADER + GAP + 54),
		Size = UDim2.new(0.8, 0, 0, 56),
		Visible = false,
		ZIndex = 11,
		Parent = root,
	})
	Screen.Corner(12).Parent = banner
	local bannerId = 0
	local function showLevelUp(level: number)
		local rank = Levels.Rank(level)
		local unlock = Levels.UnlockAt(level)
		banner.Text = string.format("LEVEL UP!  Lv %d · %s", level, rank.Rank)
			.. (if unlock then " – " .. unlock.Unlock .. " unlocked" else "")
		banner.Visible = true
		bannerId += 1
		local myId = bannerId
		task.delay(4, function()
			if bannerId == myId then
				banner.Visible = false
			end
		end)
	end

	------------------------------------------------------------------
	-- Aktualisieren
	------------------------------------------------------------------
	local daily = DailyRewardUI.new(root)
	createUI = CreateCoinUI.new(root)
	dailyButton.Activated:Connect(daily.Show)
	local shop = ShopUI.new(root)
	shopButton.Activated:Connect(shop.Show)
	local admin = AdminUI.new(root)
	adminButton.Activated:Connect(admin.Show)

	-- Pflicht-Tutorial für neue Spieler (einmal, sobald die Daten da sind)
	local tutorialStarted = false
	local function checkTutorial()
		local settings = MarketClient.Me.Settings
		if tutorialStarted or not settings or settings.Tutorial then
			return
		end
		tutorialStarted = true
		show("Pulse")
		TutorialUI.Start(root, {
			Pulse = function()
				return pages.Pulse.View.ColumnsArea
			end,
			Buy = function()
				return pages.Coin.View.BuyRow
			end,
			Sell = function()
				return pages.Coin.View.SellRow
			end,
			CoinOpen = function()
				return if current == "Coin" then pages.Coin.View.CoinId else nil
			end,
		})
	end

	local lastLevel = nil
	MarketClient.Changed.Event:Connect(function()
		SoundFx.Muted = MarketClient.Me.Settings ~= nil and MarketClient.Me.Settings.Mute == true
		checkTutorial()
		local dailyState = MarketClient.Me.Daily
		dailyButton.BackgroundColor3 = if dailyState and dailyState.CanClaim then Colors.Accent else Colors.PanelLight
		daily.Refresh()
		createUI.RefreshLicense() -- z. B. Lizenz gekauft
		shop.Refresh()
		local myStats = MarketClient.Me.Stats
		local legend = myStats ~= nil and myStats.Level >= Config.Prestige.LegendLevel
		vipFrame.Enabled = legend or MarketClient.HasPass("Vip")
		vipFrame.Color = if legend then CreatorStyle.Legend else CreatorStyle.Vip
		vipFrame.Thickness = if legend then 3 else 2
		local isAdmin = MarketClient.Me.Extra ~= nil and MarketClient.Me.Extra.IsAdmin == true
		adminButton.Visible = isAdmin
		logo.Text = if isAdmin then "🚀" else "🚀 MOON OR RUG"
		logo.Size = UDim2.new(0, if isAdmin then 56 else 180, 1, 0)
		cashLabel.Text = "💵 " .. Format.Cash(MarketClient.Me.Cash)
		local stats = MarketClient.Me.Stats
		if stats then
			local level, progress = Levels.Progress(stats.Xp)
			levelLabel.Text = string.format("Lv %d · %s", level, Levels.Rank(level).Rank)
			xpFill.Size = UDim2.fromScale(math.clamp(progress, 0, 1), 1)
			if lastLevel and level > lastLevel then
				SoundFx.Play("LevelUp")
				showLevelUp(level)
			end
			lastLevel = level
		end
		pages[current].View.Refresh()
	end)
	levelLabel.Text = ""
	cashLabel.Text = "💵 …"
	show("Pulse")
end

return TerminalUI
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX42">
				<Properties>
					<string name="Name">TutorialUI</string>
					<ProtectedString name="Source"><![CDATA[-- TutorialUI (ModuleScript) – StarterPlayer/StarterPlayerScripts/ClientModules/TutorialUI
-- Pflicht-Tutorial für neue Spieler (nicht überspringbar, kurz):
--   1) Coin antippen   2) BUY tippen   3) SELL ALL tippen   4) fertig
-- Alles außer der aktuellen Aufgabe ist abgedunkelt und gesperrt (4 Blocker-Flächen um ein "Loch").
-- Erledigt wird auf dem Server gespeichert (kommt nie wieder).

local RunService = game:GetService("RunService")

local Screen = require(script.Parent.Screen)
local MarketClient = require(script.Parent.MarketClient)

local Colors = Screen.Colors
local Z = 80 -- über allem (Fenster 30–41, Hinweis 60)

local TutorialUI = {}

-- root: Terminal-Root. targets = { Pulse = () -> GuiObject, Buy = () -> GuiObject, Sell = () -> GuiObject,
--   CoinOpen = () -> string? (geöffneter Coin oder nil) }
function TutorialUI.Start(root: GuiObject, targets)
	local step = 1
	local coinId: string? = nil
	local finished = false

	-- 4 Blocker (oben, unten, links, rechts vom Loch): fangen jedes Tippen ab
	local blockers = {}
	for i = 1, 4 do
		blockers[i] = Screen.New("TextButton", {
			Text = "",
			AutoButtonColor = false,
			BorderSizePixel = 0,
			BackgroundColor3 = Colors.Background,
			BackgroundTransparency = 0.35,
			ZIndex = Z,
			Parent = root,
		})
	end
	-- Rahmen um das Loch
	local ring = Screen.New("Frame", {
		BackgroundTransparency = 1,
		ZIndex = Z + 1,
		Parent = root,
	}, {
		Screen.Corner(12),
		Screen.New("UIStroke", { Color = Colors.Accent, Thickness = 3 }),
	})
	-- Sprechblase oben in der Mitte
	local bubble = Screen.New("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 4),
		Size = UDim2.new(0.7, 0, 0, 72),
		BackgroundColor3 = Colors.Panel,
		ZIndex = Z + 2,
		Parent = root,
	}, {
		Screen.Corner(12),
		Screen.New("UIStroke", { Color = Colors.Accent, Thickness = 2 }),
	})
	local text = Screen.Label({
		Font = Screen.Fonts.Bold,
		TextSize = 24,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(12, 0),
		Size = UDim2.new(1, -24, 1, 0),
		ZIndex = Z + 3,
		Parent = bubble,
	})
	-- Schluss-Knopf (nur bei Schritt 4)
	local doneButton = Screen.Button({
		Text = "LET'S TRADE 🚀",
		BackgroundColor3 = Colors.Green,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(300, 72),
		Visible = false,
		ZIndex = Z + 2,
		Parent = root,
	})

	local TEXTS = {
		"👋 Welcome! Tap any coin to open it.",
		"Tap BUY to buy a little of this coin.",
		"Prices move fast! Tap SELL ALL to take your profit (or loss).",
		"That's it! Buy early, sell high, level up. Watch out for rug pulls! 🚨",
	}

	-- Loch auf ein GuiObject setzen (Design-Pixel relativ zu root), nil = alles abdunkeln
	local function hole(target: GuiObject?)
		local scale = Screen.GetScale()
		local rootPos, rootSize = root.AbsolutePosition, root.AbsoluteSize / scale
		local x0, y0, x1, y1 = 0, 0, 0, 0
		if target and target.Visible then
			local pos = (target.AbsolutePosition - rootPos) / scale - Vector2.new(6, 6)
			local size = target.AbsoluteSize / scale + Vector2.new(12, 12)
			x0, y0 = math.max(0, pos.X), math.max(0, pos.Y)
			x1, y1 = math.min(rootSize.X, pos.X + size.X), math.min(rootSize.Y, pos.Y + size.Y)
		end
		local W, H = rootSize.X, rootSize.Y
		local rects = {
			{ 0, 0, W, y0 }, -- oben
			{ 0, y1, W, H - y1 }, -- unten
			{ 0, y0, x0, y1 - y0 }, -- links
			{ x1, y0, W - x1, y1 - y0 }, -- rechts
		}
		for i, r in rects do
			blockers[i].Position = UDim2.fromOffset(r[1], r[2])
			blockers[i].Size = UDim2.fromOffset(math.max(0, r[3]), math.max(0, r[4]))
		end
		ring.Visible = x1 > x0
		ring.Position = UDim2.fromOffset(x0, y0)
		ring.Size = UDim2.fromOffset(x1 - x0, y1 - y0)
	end

	local connection
	local function finish()
		if finished then
			return
		end
		finished = true
		connection:Disconnect()
		MarketClient.SetFlag("Tutorial")
		for _, blocker in blockers do
			blocker:Destroy()
		end
		ring:Destroy()
		bubble:Destroy()
		doneButton:Destroy()
	end
	doneButton.Activated:Connect(finish)

	-- Jeden Frame: Fortschritt prüfen und Loch nachführen (Fenstergröße/Drehung ändert sich)
	connection = RunService.RenderStepped:Connect(function()
		local positions = MarketClient.Me.Positions or {}
		if step == 1 then
			local open = targets.CoinOpen()
			local coin = open and MarketClient.Coins[open]
			if coin and not coin.Rugged and coin.Stage ~= "Dead" then
				coinId = open
				step = 2
			end
		elseif step == 2 then
			if targets.CoinOpen() ~= coinId then
				step = 1 -- Coin verschwunden: nochmal einen wählen
			elseif positions[coinId] then
				step = 3
			end
		elseif step == 3 then
			if not positions[coinId] then
				step = 4
			end
		end
		text.Text = TEXTS[step]
		doneButton.Visible = step == 4
		if step == 1 then
			hole(targets.Pulse())
		elseif step == 2 then
			hole(targets.Buy())
		elseif step == 3 then
			hole(targets.Sell())
		else
			hole(doneButton)
		end
	end)
end

return TutorialUI
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
	</Item>
</roblox>
